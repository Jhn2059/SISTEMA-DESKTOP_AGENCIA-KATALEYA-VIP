ble=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-5" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-6" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-7" value="«control»&lt;br&gt;&lt;b&gt;ServicioAnulaciones&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-8" value="«control»&lt;br&gt;&lt;b&gt;ServicioParametros&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-9" value="«entity»&lt;br&gt;&lt;b&gt;Pasaje&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-10" value="«control»&lt;br&gt;&lt;b&gt;ServicioCobros&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-11" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioPasajes&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-12" value="«control»&lt;br&gt;&lt;b&gt;ServicioBitacora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1850" y="110" width="160" height="1624" as="geometry"/></mxCell><mxCell id="sec-cdu-04-31" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="844" y="790" width="772" height="198" as="geometry"/></mxCell><mxCell id="sec-cdu-04-32" value="[se cumple el aviso previo, o anula la agencia]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="814" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-04-33" value="[no se cumple el aviso previo]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="894" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-04-34" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="844" y="884" width="772" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-04-52" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="1224" width="1972" height="460" as="geometry"/></mxCell><mxCell id="sec-cdu-04-53" value="[A4: pasó la hora de salida y el pasajero no se presentó]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="1248" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-04-54" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. Faltan menos de tres horas: el sistema lo advierte y el adelanto queda retenido; el Administrador puede devolverlo como excepción, indicando el motivo.&lt;br&gt;A2. Pasaje ya anulado: no se anula de nuevo ni se modifica.&lt;br&gt;A3. Falta el motivo: el sistema no anula.&lt;br&gt;A4. El pasajero no se presentó a la hora indicada: el pasaje pasa a No se presentó, sin devolución (RN-28). Lo marca el Administrador desde el detalle (IU-P05), solo después de la hora de salida, y queda en la bitácora." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1744" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-04-13" value="1: pulsar «Anular»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.053;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.053;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-04-2" target="sec-cdu-04-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-04-14" value="2: RevisarAnulacionAsync(idPasaje)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0751;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0751;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-04-4" target="sec-cdu-04-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-04-15" value="3: GET /pasajes/{id}/revision-de-anulacion" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0973;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0973;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-04-5" target="sec-cdu-04-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-04-16" value="4: RevisarAnulacionAsync(pasaje)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1195;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1195;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-04-6" target="sec-cdu-04-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-04-17" value=