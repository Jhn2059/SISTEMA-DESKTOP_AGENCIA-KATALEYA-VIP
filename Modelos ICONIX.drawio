Size=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="2180" as="geometry"/></mxCell><mxCell id="sec-cdu-16-7" value="«control»&lt;br&gt;&lt;b&gt;ServicioParametros&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="2180" as="geometry"/></mxCell><mxCell id="sec-cdu-16-8" value="«entity»&lt;br&gt;&lt;b&gt;ParametroDelNegocio&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="2180" as="geometry"/></mxCell><mxCell id="sec-cdu-16-9" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioParametros&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="2180" as="geometry"/></mxCell><mxCell id="sec-cdu-16-10" value="«control»&lt;br&gt;&lt;b&gt;ServicioBitacora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="2180" as="geometry"/></mxCell><mxCell id="sec-cdu-16-11" value="«control»&lt;br&gt;&lt;b&gt;ServicioConsultas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="160" height="2180" as="geometry"/></mxCell><mxCell id="sec-cdu-16-12" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioPasajes&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1850" y="110" width="160" height="2180" as="geometry"/></mxCell><mxCell id="sec-cdu-16-52" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="736" width="1972" height="1016" as="geometry"/></mxCell><mxCell id="sec-cdu-16-53" value="[agregar un horario]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="760" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-16-54" value="[quitar un horario]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="984" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-16-55" value="[plazo o aviso previo]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="1532" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-16-56" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="974" width="1972" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-16-57" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="1522" width="1972" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-16-68" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="1772" width="1572" height="468" as="geometry"/></mxCell><mxCell id="sec-cdu-16-69" value="[dato válido]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="1796" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-16-70" value="[hora sin formato, repetida o último horario]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="2056" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-16-71" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="2046" width="1572" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-16-72" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. Agregar un horario: el Administrador escribe la hora en formato de 24 horas y pulsa «Agregar horario»; el sistema lo agrega en orden, para los dos sentidos. Si la hora no tiene ese formato o el horario ya existe, no lo agrega e indica el motivo debajo del campo.&lt;br&gt;A2. Plazo máximo de reserva fuera de 1 a 30 días, o aviso previo fuera de 0 a 24 horas, en números enteros: el sistema no guarda e indica el dato inválido.&lt;br&gt;A3. Quitar un horario: el sistema cuenta los pasajes no anulados de los próximos días en ese horario y pide confirmación con esa cantidad (IU-05). Con «Sí», lo quita: esos pasajes conservan su horario y, si hace falta, se modifican (CDU-03). El último horario no puede quitarse." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2300" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-16-13" value="1: abrir la pestaña «Tarifas y parámetros»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0394;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0394;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-2" target="sec-cdu-16-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-14" value="2: ObtenerParametrosAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.056;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.056;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-4" target="sec-cdu-16-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-15" value="3: GET /parametros" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0725;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0725;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-5" target="sec-cdu-16-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-16" value="4: ListarParametrosAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.089;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.089;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-6" target="sec-cdu-16-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-17" value="5: ListarAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1055;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1055;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-7" target="sec-cdu-16-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-18" value="parámetros" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.122;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.122;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-7" target="sec-cdu-16-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-19" value="JSON: lista de DatosDeParametro" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1385;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1385;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-6" target="sec-cdu-16-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-20" value="parámetros" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.155;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.155;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-5" target="sec-cdu-16-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-21" value="6: ObtenerTiposDeVehiculoAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1716;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1716;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-4" target="sec-cdu-16-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-22" value="7: GET /tipos-de-vehiculo" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1881;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1881;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-5" target="sec-cdu-16-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-23" value="8: ObtenerTiposDeVehiculoAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2046;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2046;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-6" target="sec-cdu-16-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-16-24" value="tipos de vehículo" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2211;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2211;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-16-7" target="sec-cdu-16-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCel