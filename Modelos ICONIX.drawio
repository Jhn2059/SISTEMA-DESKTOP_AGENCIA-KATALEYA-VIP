l=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="621" height="34" as="geometry"/></mxCell><mxCell id="sec-cdu-08-2" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="20" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-3" value="&lt;b&gt;Administrador&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-08-4" value="«boundary»&lt;br&gt;&lt;b&gt;IU-P07 Registro diferido&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-5" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-6" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-7" value="«control»&lt;br&gt;&lt;b&gt;ServicioReservasYVentas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-8" value="«entity»&lt;br&gt;&lt;b&gt;Pasaje&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-9" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioPasajes&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-10" value="«control»&lt;br&gt;&lt;b&gt;ServicioBitacora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-11" value="«control»&lt;br&gt;&lt;b&gt;ServicioTarifas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-12" value="«entity»&lt;br&gt;&lt;b&gt;Pago&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1850" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-08-34" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="628" width="1572" height="432" as="geometry"/></mxCell><mxCell id="sec-cdu-08-35" value="[número nuevo y datos válidos]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="652" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-08-36" value="[número repetido o dato inválido]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="876" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-08-37" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="866" width="1572" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-08-38" value='&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. El número de boleto ya existe: el sistema rechaza el registro e indica que el número ya existe.&lt;br&gt;A2. La fecha y hora de emisión son posteriores al momento del registro: el sistema no guarda.&lt;br&gt;A3. Otro dato inválido: como en CDU-01, A2.&lt;br&gt;A4. &lt;span style="background-color:#FFF2A8;"&gt;El asiento ya está ocupado por otro pasaje de esa salida: el sistema no guarda, muestra el dibujo de la unidad actualizado y pide otro asiento; el número del talonario se conserva (propuesta por validar; SDD, Anexo E.4).&lt;/span&gt;' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-08-13" value="1: escribir el número, la fecha y hora reales, los datos y el asiento" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.086;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.086;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-2" target="sec-cdu-08-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-14" value="2: RegistrarDiferidoAsync(solicitud)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.122;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.122;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-4" target="sec-cdu-08-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-15" value="3: POST /pasajes-diferidos" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.158;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.158;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-5" target="sec-cdu-08-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-16" value="4: RegistrarDiferidoAsync(solicitud)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.194;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.194;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-6" target="sec-cdu-08-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-17" value="5: ExisteNumeroTalonarioAsync(numero)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.23;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.23;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-7" target="sec-cdu-08-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-18" value="resultado" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.266;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.266;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-9" target="sec-cdu-08-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-19" value="6: ObtenerTarifaVigenteAsync(fecha, sentido)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.302;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.302;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-7" target="sec-cdu-08-11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-20" value="tarifa" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.338;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.338;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-11" target="sec-cdu-08-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-21" value="7: «create» Pasaje(solicitud, tarifa, emisor)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.374;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.374;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-7" target="sec-cdu-08-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-22" value="8: «create» Pago(importe, medio, cobrador)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.41;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.41;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-8" target="sec-cdu-08-12"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-23" value="9: Validar()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.446;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.446;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-7" target="sec-cdu-08-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-24" value="errores" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.482;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.482;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-8" target="sec-cdu-08-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-25" value="10: AgregarAsync(pasaje)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.578;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.578;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-7" target="sec-cdu-08-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-26" value="11: RegistrarAsync(registroDiferido)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.614;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.614;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-7" target="sec-cdu-08-10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-27" value="pasaje registrado" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.65;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.65;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-7" target="sec-cdu-08-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-08-28" value="JSON: DatosDePasaje" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.686;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.686;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-08-6" target="sec-cdu-08-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-