=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-4" value="«entity»&lt;br&gt;&lt;b&gt;CorrelativoDeBoletos&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-5" value="«entity»&lt;br&gt;&lt;b&gt;BoletoDeViaje&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-6" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioBoletos&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-7" value="«control»&lt;br&gt;&lt;b&gt;ServicioBitacora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-8" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-9" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-10" value="«boundary»&lt;br&gt;&lt;b&gt;IU-P03 Registro de pasaje&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-11" value="«control»&lt;br&gt;&lt;b&gt;ServicioImpresion&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1850" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-12" value="«entity»&lt;br&gt;&lt;b&gt;RegistroTecnico&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2050" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-13" value="«boundary»&lt;br&gt;&lt;b&gt;AdaptadorImpresora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2250" y="110" width="160" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-14" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="2520" y="110" width="20" height="1000" as="geometry"/></mxCell><mxCell id="sec-cdu-05-15" value="&lt;b&gt;Impresora de etiquetas&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2435" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-05-37" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="244" y="700" width="1972" height="360" as="geometry"/></mxCell><mxCell id="sec-cdu-05-38" value="[impresión correcta]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="290" y="724" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-05-39" value="[sin respuesta o sin papel]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="290" y="804" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-05-40" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="244" y="794" width="1972" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-05-41" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. Reimpresión: desde el detalle (IU-P05), el usuario pulsa «Reimprimir»; el sistema imprime el mismo boleto sin consumir numeración y anota la reimpresión en la bitácora.&lt;br&gt;A2. La impresora no responde o no tiene papel: el pasaje queda registrado, el sistema avisa del fallo (IMP-01, IMP-02), y el boleto se imprime después desde el detalle (IU-P05; IH-04, IH-T04).&lt;br&gt;A3. El pasaje no está pagado: no se imprime.&lt;br&gt;A4. Grupo: se emite un boleto de viaje por integrante, que en lugar del asiento dice «Grupo» y el código del grupo." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-05-16" value="1: EmitirAsync(pasaje)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.086;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.086;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-2" target="sec-cdu-05-3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-17" value="2: EmitirBoleto(pasaje, emisor)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.122;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.122;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-3" target="sec-cdu-05-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-18" value="3: «create» BoletoDeViaje(pasaje, numero, emisor)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.158;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.158;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-4" target="sec-cdu-05-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-19" value="boleto con el número siguiente" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.194;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.194;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-4" target="sec-cdu-05-3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-20" value="4: AgregarAsync(boleto)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.23;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.23;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-3" target="sec-cdu-05-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-21" value="5: RegistrarAsync(emision)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.266;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.266;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-3" target="sec-cdu-05-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-22" value="boleto emitido" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.302;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.302;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-3" target="sec-cdu-05-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-23" value="pasaje Pagado con su boleto" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.338;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.338;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-2" target="sec-cdu-05-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-24" value="JSON: DatosDePasaje con su boleto" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.374;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.374;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-8" target="sec-cdu-05-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-25" value="pasaje con su boleto" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.41;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.41;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-9" target="sec-cdu-05-10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-26" value="6: ImprimirBoletoAsync(pasaje)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.446;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.446;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-10" target="sec-cdu-05-11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-27" value="7: ImprimirAsync(pasaje)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.482;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.482;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-11" target="sec-cdu-05-13"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-28" value="8: comandos ESC/POS" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.518;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.518;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-13" target="sec-cdu-05-14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-29" value="estado de la impresora" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.554;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.554;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-13" target="sec-cdu-05-11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-30" value="Lista" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.65;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.65;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-11" target="sec-cdu-05-10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-31" value="9: RegistrarAsync(error)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.73;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.73;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-11" target="sec-cdu-05-12"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-32" value="10: RegistrarFallaDeImpresionAsync(boleto, estado)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.766;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.766;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-11" target="sec-cdu-05-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-33" value="11: POST /boletos/{serie}-{numero}/fallas" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.802;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.802;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-9" target="sec-cdu-05-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-34" value="12: RegistrarFallaDeImpresionAsync(boleto, estado)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.838;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.838;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-8" target="sec-cdu-05-3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-35" value="13: RegistrarAsync(errorDeImpresion)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.874;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.874;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-3" target="sec-cdu-05-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-05-36" value="SinRespuesta o SinPapel: imprimir después desde el detalle" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.91;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.91;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-05-11" target="sec-cdu-05-10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sec-cdu-13" name="Secuencia CDU-13"><mxGraphModel dx="1690" dy="1362" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1690" pageHeight="1362" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sec-cdu-13-1" value="Secuencia — CDU-13 Consultar pasajes" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="387" height="34" as="geometry"/></mxCell><mxCell id="sec-cdu-13-2" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="20" height="1072" as="geometry"/></mxCell><mxCell id="sec-cdu-13-3" value="&lt;b&gt;Encargado o Administrador&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-13-4" value="«boundary»&lt;br&gt;&lt;b&gt;IU-P04 Lista de pasajes&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1072" as="geometry"/></mxCell><mxCell id="sec-cdu-13-5" value="«entity»&lt;br&gt;&lt;b&gt;CopiaLocal&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1072" as="geometry"/></mxCell><mxCell id="sec-cdu-13-6" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1072" as="geometry"/></mxCell><mxCell id="sec-cdu-13-7" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1072" as="geometry"/></mxCell><mxCell id="sec-cdu-13-8" value="«control»&lt;br&gt;&lt;b&gt;ServicioConsultas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1072" as="geometry"/></mxCell><mxCell id="sec-cdu-13-9" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioPasajes&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1072" as="geometry"/></mxCell><mxCell id="sec-cdu-13-21" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="444" y="268" width="972" height="432" as="geometry"/></mxCell><mxCell id="sec-cdu-13-22" value="[con conexión]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="490" y="292" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-13-23" value="[sin conexión]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="490" y="588" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-13-24" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="444" y="578" width="972" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-13-37" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. Sin resultados: el sistema lo indica con un mensaje.&lt;br&gt;A2. La fecha inicial es posterior a la final: el sistema lo indica.&lt;br&gt;A3. Sin conexión a internet: el sistema muestra los pasajes del día desde la copia local de solo lectura (RNF-16)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1192" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-13-10" value="1: filtrar por fecha, horario, estado, tipo, pasajero o emisor" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0802;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0802;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-13-2" target="sec-cdu-13-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-13-11" value="2: ConsultarPasajesAsync(filtro)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1138;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1138;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-13-4" target="sec-cdu-13-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-13-12" value="3: GET /pasajes con el filtro" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2034;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2034;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-13-6" target="sec-cdu-13-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-13-13" value="4: ConsultarAsync(filtro)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2369;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0