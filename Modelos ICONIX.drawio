="1"><mxGeometry x="40" y="20" width="448" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-12-2" value="IU-P02 Panel principal" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="284.4" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-12-3" value="Avisar que hay un reporte pendiente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-12-4" value="Validar la contraseña del PDF" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-12-5" value="Obtener los pasajes del año antepasado" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-12-6" value="Obtener su historia" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-12-7" value="Generar el PDF" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-12-8" value="Eliminar los pasajes y su historia" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-12-9" value="Registrar en la bitácora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="822" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-12-10" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="586" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-12-11" value="Pago" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="374" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-12-12" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="686" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-12-13" value="Reporte anual" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="486" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-12-14" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="274.4" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-12-35" value="&lt;b&gt;CDU-12 Generar el reporte anual&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RF-32, RF-24, RNF-06 · Pantallas: IU-P02&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. Al empezar el año, el sistema avisa al Administrador que hay un reporte anual pendiente; él lo pide desde el panel principal (IU-P02) y fija una contraseña para el PDF.&lt;br&gt;2. El sistema genera un PDF con los pasajes del año antepasado, sus pagos y su historia en la bitácora, protegido con esa contraseña, y lo guarda en la carpeta de Google Drive del respaldo.&lt;br&gt;3. Con el reporte completo y guardado en Google Drive, el sistema elimina esos pasajes y sus entradas de la bitácora, y registra el reporte y la depuración en la bitácora.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. El reporte no se genera completo o no se puede guardar en Google Drive: el sistema no elimina ningún pasaje e informa el motivo (RES-02).&lt;br&gt;A2. Falta la contraseña del PDF: el sistema no genera el reporte y la pide; no se exige un mínimo de caracteres." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="852" as="geometry"/></mxCell><mxCell id="rob-cdu-12-36" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-12-37" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-12-38" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-20" name="Robustez CDU-20"><mxGraphModel dx="1680" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-20-9" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-20-8" target="rob-cdu-20-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-20-10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-20-2" target="rob-cdu-20-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-20-11" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-20-3" target="rob-cdu-20-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-20-12" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-20-4" target="rob-cdu-20-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-20-13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-20-5" target="rob-cdu-20-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-20-14" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-20-5" target="rob-cdu-20-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-20-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-20-6" target="rob-cdu-20-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-20-1" value="Robustez — CDU-20 Elegir el tema" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="346" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-20-2" value="Barra superior" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="318" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-20-3" value="Bloquear el botón del tema" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-20-4" value="Aplicar el tema" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-20-5" value="Guardar el tema" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-20-6" value="Activar el botón del tema" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-20-7" value="Preferencias" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="374" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-20-8" value="Encargado de ventas o Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="308" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-20-16" value="&lt;b&gt;CDU-20 Elegir el tema&lt;/b&gt;&lt;br&gt;Actor: Encargado de ventas o Administrador&lt;br&gt;Requisitos: IU-10 · Pantallas: Barra superior (IU-P02 a IU-P10)&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. En la barra superior de cualquier pantalla, el usuario pulsa el botón del tema; muestra la luna si el tema es claro y el sol si es oscuro.&lt;br&gt;2. El sistema desactiva el botón y muestra «Cambiando el tema…» con un indicador de espera; mientras tanto, los demás clics en el botón no hacen nada.&lt;br&gt;3. El sistema aplica el otro tema en toda la ventana, lo guarda en la cuenta y vuelve a activar el botón: la próxima vez que esa cuenta inicie sesión, el sistema se muestra con ese tema.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. La cuenta todavía no eligió un tema: el sistema sigue el de Windows, y el botón pasa al otro.&lt;br&gt;A2. Sin conexión con el servidor: el sistema aplica el tema en esta sesión y lo guarda en la cuenta la próxima vez que se cambie." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="690" as="geometry"/></mxCell><mxCell id="rob-cdu-20-17" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-20-18" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-20-19" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-21" name="Robustez CDU-21"><mxGraphModel dx="1680" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-21-12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-10" target="rob-cdu-21-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-2" target="rob-cdu-21-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-4" target="rob-cdu-21-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-2" target="rob-cdu-21-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-5" target="rob-cdu-21-9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-5" target="rob-cdu-21-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-2" target="rob-cdu-21-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-2" target="rob-cdu-21-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-20" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-7" target="rob-cdu-21-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-11" target="rob-cdu-21-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-22" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-7" target="rob-cdu-21-8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-23" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-21-8" target="rob-cdu-21-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-21-1" value="Robustez — CDU-21 Configurar la impresora de etiquetas" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="570" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-21-2" value="IU-P10 Configuración" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="326" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-21-3" value="Interfaz de la impresora (ESC/POS)" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="486" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-21-4" value="Listar las impresoras de Windows" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-21-5" value="Mostrar la última copia" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-21-6" value="Guardar la configuración" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-21-7" value="Imprimir la prueba" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-21-8" value="Mostrar el resultado de la prueba" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-21-9" value="Copia de respaldo" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-21-10" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="316" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-21-11" value="Impresora de etiquetas" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="526" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-21-24" value='&lt;b&gt;CDU-21 Configurar la impresora de etiquetas&lt;/b&gt;&lt;br&gt;Actor: Administrador · Secundario: Impresora de etiquetas&lt;br&gt;Requisitos: IH-06, RF-05, RNF-17 · Pantallas: IU-P10&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El Administrador abre Configuración, en la pestaña «Equipo» (IU-P10); el sistema muestra la impresora elegida, el ancho del papel y las impresoras instaladas en Windows, y, solo para leer, la fecha y el resultado de la última copia semanal de los datos (RNF-17, CDU-22).&lt;br&gt;2. El Administrador elige la impresora y &lt;span style="background-color:#FFF2A8;"&gt;el ancho del papel: 58 mm, el de la impresora elegida (CF-02), o 80 mm si se cambia de impresora (IH-06; propuesta por validar; SDD, Anexo E.6).&lt;/span&gt;&lt;br&gt;3. El sistema guarda la configuración en la laptop.&lt;br&gt;4. El Administrador pulsa «Imprimir prueba»; el sistema imprime una etiqueta de prueba, sin usar la numeración de los boletos, e indica el resultado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. La impresora no responde o no tiene papel: el sistema lo indica (IMP-01 o IMP-02) y conserva la configuración.' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="690" as="geometry"/></mxCell><mxCell id="rob-cdu-21-25" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-21-26" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-21-27" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-22" name="Robustez CDU-22"><mxGraphModel dx="1680" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-22-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-22-12" target="rob-cdu-22-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-22-16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-22-2" target="rob-cdu-22-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-22-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-22-5" target="rob-cdu-22-11"><mxGeometry x="0" relative="1" as="g