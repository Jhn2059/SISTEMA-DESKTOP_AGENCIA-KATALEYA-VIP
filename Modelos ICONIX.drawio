e="rob-cdu-13-7" target="rob-cdu-13-9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-13-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-13-7" target="rob-cdu-13-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-13-22" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-13-10" target="rob-cdu-13-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-13-1" value="Robustez — CDU-13 Consultar pasajes" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="377" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-13-2" value="IU-P04 Lista de pasajes" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="336.667" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-13-3" value="IU-P05 Detalle del pasaje" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="486" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-13-4" value="Buscar con los filtros" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-13-5" value="Buscar en la copia local" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-13-6" value="Mostrar la tabla" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-13-7" value="Abrir el detalle" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-13-8" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="299.333" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-13-9" value="Pago" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="486" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-13-10" value="Encargado de ventas o Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="401.333" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-13-23" value="&lt;b&gt;CDU-13 Consultar pasajes&lt;/b&gt;&lt;br&gt;Actor: Encargado de ventas o Administrador&lt;br&gt;Requisitos: RF-07, RNF-16, RNF-18 · Pantallas: IU-P04, IU-P05&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El usuario abre la lista de pasajes (IU-P04).&lt;br&gt;2. El usuario filtra por fechas de salida —«desde» y «hasta», que al abrir la lista traen el día de hoy—, hora de salida, estado, tipo de pasaje, pasajero o emisor.&lt;br&gt;3. El sistema muestra los pasajes en una tabla, con su asiento y su código de grupo.&lt;br&gt;4. El usuario pulsa una fila y el sistema abre el detalle del pasaje (IU-P05), con todos sus datos y sus pagos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Sin resultados: el sistema lo indica con un mensaje.&lt;br&gt;A2. La fecha inicial es posterior a la final: el sistema lo indica.&lt;br&gt;A3. Sin conexión a internet: el sistema muestra los pasajes del día desde la copia local de solo lectura (RNF-16)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="690" as="geometry"/></mxCell><mxCell id="rob-cdu-13-24" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-13-25" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-13-26" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-07" name="Robustez CDU-07"><mxGraphModel dx="1680" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-07-13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-07-12" target="rob-cdu-07-2"><