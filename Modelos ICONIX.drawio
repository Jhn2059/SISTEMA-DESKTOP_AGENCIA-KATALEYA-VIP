<mxCell id="rob-cdu-15-1" value="Robustez — CDU-15 Iniciar sesión" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="346" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-15-2" value="IU-P01 Inicio de sesión" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="374" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-15-3" value="IU-P02 Panel principal" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="934" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-15-4" value="Avisar que Bloq Mayús está activado" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-15-5" value="Revisar los campos" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-15-6" value="Verificar la cuenta y la contraseña" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-15-7" value="Contar el intento fallido" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-15-8" value="Bloquear la cuenta" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-15-9" value="Mostrar el motivo del rechazo" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-15-10" value="Registrar el acceso" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="822" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-15-11" value="Mostrar el panel según el rol" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="934" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-15-12" value="Usuario" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="486" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-15-13" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="822" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-15-14" value="Rol" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="934" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-15-15" value="Preferencias" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="1034" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-15-16" value="Encargado de ventas o Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="644" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-15-37" value="&lt;b&gt;CDU-15 Iniciar sesión&lt;/b&gt;&lt;br&gt;Actor: Encargado de ventas o Administrador&lt;br&gt;Requisitos: RF-23, RNF-04, RNF-08 · Pantallas: IU-P01, IU-P02&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El usuario abre el sistema y el sistema muestra la pantalla de inicio de sesión (IU-P01).&lt;br&gt;2. El usuario escribe su nombre de usuario y su contraseña y pulsa «Ingresar».&lt;br&gt;3. El sistema verifica que la cuenta exista y no esté bloqueada, que la contraseña coincida y que la cuenta esté activa; pone en cero los intentos fallidos.&lt;br&gt;4. El sistema registra el acceso en la bitácora y muestra el panel principal (IU-P02) con las opciones del rol del usuario, su nombre y su sede, en el tema que eligió la cuenta (CDU-20).&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Usuario o contraseña vacíos: el sistema lo señala debajo del campo, sin consultar el servidor ni contar un intento.&lt;br&gt;A2. Usuario que no existe o contraseña incorrecta: el sistema niega el acceso con un mensaje que no revela cuál de los dos datos falló (SES-01); si la cuenta existe, cuenta el intento fallido.&lt;br&gt;A3. Quinto intento fallido consecutivo: el sistema bloquea la cuenta durante 3 minutos e indica hasta qué hora (SES-02); después la desbloquea solo, y un Administrador puede desbloquearla antes (CDU-18).&lt;br&gt;A4. Cuenta bloqueada: el sistema niega el acceso e indica hasta qué hora (SES-02), sin revisar la contraseña ni contar el intento.&lt;br&gt;A5. Cuenta desactivada: si la contraseña es correcta, el sistema indica que la cuenta está desactivada y que un Administrador puede reactivarla (SES-03, CDU-17); si no, responde como en A2.&lt;br&gt;A6. Sin conexión con el servidor: el sistema indica que no pudo comprobar los datos, distingue la falta de internet (CON-01) del servidor que no responde (CON-02), no cuenta el intento y anota el error en el registro técnico de la laptop.&lt;br&gt;A7. Bloq Mayús activado: mientras el usuario escribe la contraseña, el sistema lo advierte.&lt;br&gt;A8. Cambio de usuario: desde el panel, el usuario cierra su sesión y otro inicia la suya en no más de 15 segundos (RNF-08).&lt;br&gt;A9. La cuenta todavía no eligió un tema: el sistema sigue el tema de Windows, como en el inicio de sesión." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="1064" as="geometry"/></mxCell><mxCell id="rob-cdu-15-38" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-15-39" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-15-40" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-01" name="Robustez CDU-01"><mxGraphModel dx="1680" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-01-16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-01-15" target="rob-cdu-01-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-01-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-01-2" target="rob-cdu-01-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-01-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-01-3" target="rob-cdu-01-9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-01-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-01-2" target="rob-cdu-01-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-01-20" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-01-4" target="rob-cdu-01-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-01-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-01-4" target="rob-cdu-01-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-01-22" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-01-2" ta