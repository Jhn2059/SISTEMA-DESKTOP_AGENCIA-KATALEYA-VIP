idden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-18"><mxGeometry x="0" y="26" width="211" height="104" as="geometry"/></mxCell><mxCell id="datos-20" value="tipo_vehiculo" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="192" height="98" as="geometry"/></mxCell><mxCell id="datos-21" value='PK id: smallint&lt;br&gt;nombre: varchar(30)&lt;br&gt;cantidad_asientos: smallint&lt;br&gt;&lt;span style="background-color:#FFF2A8;"&gt;distribucion: jsonb (PA-73)&lt;/span&gt;' style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-20"><mxGeometry x="0" y="26" width="192" height="72" as="geometry"/></mxCell><mxCell id="datos-22" value="registro_bitacora" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="735" y="748" width="211" height="162" as="geometry"/></mxCell><mxCell id="datos-23" value="PK id: bigint&lt;br&gt;FK usuario_id: integer&lt;br&gt;fecha_hora: timestamptz&lt;br&gt;operacion: varchar(40)&lt;br&gt;FK pasaje_id: bigint&lt;br&gt;valor_anterior: jsonb&lt;br&gt;valor_nuevo: jsonb&lt;br&gt;clave_de_operacion: uuid único" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-22"><mxGeometry x="0" y="26" width="211" height="136" as="geometry"/></mxCell><mxCell id="datos-24" value="tarifa" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1387" y="748" width="170" height="162" as="geometry"/></mxCell><mxCell id="datos-25" value="PK id: integer&lt;br&gt;tipo: varchar(12)&lt;br&gt;nombre: varchar(60)&lt;br&gt;importe: numeric(8,2)&lt;br&gt;desde: date&lt;br&gt;hasta: date&lt;br&gt;FK usuario_id: integer&lt;br&gt;sentido: varchar(12)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-24"><mxGeometry x="0" y="26" width="170" height="136" as="geometry"/></mxCell><mxCell id="datos-26" value="parametro_negocio" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1063.5" y="780" width="170" height="98" as="geometry"/></mxCell><mxCell id="datos-27" value="PK nombre: varchar(40)&lt;br&gt;valor: text&lt;br&gt;FK usuario_id: integer&lt;br&gt;fecha_hora: timestamptz" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-26"><mxGeometry x="0" y="26" width="170" height="72" as="geometry"/></mxCell><mxCell id="datos-28" value="preferencias" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1715.5" y="392" width="179" height="66" as="geometry"/></mxCell><mxCell id="datos-29" value="PK FK usuario_id: integer&lt;br&gt;tema: varchar(6)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-28"><mxGeometry x="0" y="26" width="179" height="40" as="geometry"/></mxCell><mxCell id="datos-30" value="copia_respaldo" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1706" y="116" width="198" height="98" as="geometry"/></mxCell><mxCell id="datos-31" value="PK id: integer&lt;br&gt;fecha_hora: timestamptz&lt;br&gt;correcta: boolean&lt;br&gt;nombre_archivo: varchar(120)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-30"><mxGeometry x="0" y="26" width="198" height="72" as="geometry"/></mxCell><mxCell id="datos-32" value="reporte_anual" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1351" y="108" width="242" height="114" as="geometry"/></mxCell><mxCell id="datos-33" value="PK anio: smallint&lt;br&gt;fecha_hora_generacion: timestamptz&lt;br&gt;FK usuario_id: integer&lt;br&gt;cantidad_pasajes_depurados: integer&lt;br&gt;ruta_pdf: text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-32"><mxGeometry x="0" y="26" width="242" height="88" as="geometry"/></mxCell><mxCell id="datos-56" value="&lt;b&gt;Restricciones&lt;/b&gt;&lt;br&gt;• Un asiento no se repite entre los pasajes no anulados de una unidad: índice único parcial (unidad_salida_id, numero_asiento) WHERE estado &lt;&gt; 'Anulado' (DT-01).&lt;br&gt;• Un pasaje individual tiene unidad y asiento; uno de grupo no tiene ninguno de los dos, porque los integrantes se distribuyen solos en las unidades del grupo (unidad_salida.grupo_id): CHECK ((grupo_id IS NULL AND unidad_salida_id IS NOT NULL AND numero_asiento IS NOT NULL) OR (grupo_id IS NOT NULL AND unidad_salida_id IS NULL AND numero_asiento IS NULL)) (RF-31).&lt;br&gt;• Un pago es de un pasaje o de un grupo, no de ambos: CHECK ((pasaje_id IS NULL) &lt;&gt; (grupo_id IS NULL)) (DT-02).&lt;br&gt;• Importes mayores que cero: CHECK (importe &gt; 0) en pago, tarifa y grupo (precio_acordado).&lt;br&gt;• Cada tarifa regular tiene su sentido, y la vigente de cada sentido es la última que se fijó: CHECK (tipo &lt;&gt; 'Regular' OR sentido IS NOT NULL) (DT-06; 24/10/2026).&lt;br&gt;• Las unidades de una salida regular tienen sentido; las de un grupo, que son solo suyas, pueden no tenerlo: CHECK (grupo_id IS NOT NULL OR sentido IS NOT NULL) (RF-30; 24/10/2026).&lt;br&gt;• Numeración del boleto única por serie: UNIQUE (serie, numero) en boleto_viaje (RE-11).&lt;br&gt;• registro_bitacora solo admite inserciones: el usuario de la aplicación no tiene permisos de UPDATE ni DELETE (RNF-05, IS-BD-06). La única excepción es la depuración anual (RF-32): una función de la base de datos con permiso propio elimina las entradas de los pasajes depurados y deja su registro.&lt;br&gt;• La fecha y hora de las operaciones la pone el servidor: DEFAULT now() (IS-BD-07).&lt;br&gt;• Una operación no se registra dos veces: UNIQUE (clave_de_operacion) en registro_bitacora. La pantalla genera la clave al pulsar el botón y la repite si hay que reintentar (CON-03); viaja a la Web API en la cabecera Idempotency-Key, y la entrada de la bitácora se guarda en la misma transacción que la operación: el reintento de algo ya guardado no inserta nada (IC-05).&lt;br&gt;• Solo la Web API se conecta a la base de datos, con un usuario de permisos mínimos; sus credenciales están en la configuración del servidor, no en la laptop (RNF-20)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1100" height="256" as="geometry"/></mxCell><mxCell id="datos-57" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Cada tabla sale de una entidad (DT-01 a DT-11). PK: clave primaria; FK: clave foránea. La pata de gallo marca el lado «muchos»; el círculo, que la relación es opcional. No hay tabla de asientos: el pasaje individual guarda la unidad y el número de asiento; el de grupo no tiene ninguno. En amarillo, lo que espera el PA-73." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1170" y="1340" width="620" height="140" as="geometry"/></mxCell><mxCell id="datos-34" value="" style="html=1;rounded=0;strokeColor=#333333;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;endSize=10;startSize=10;" edge="1" parent="1" sou