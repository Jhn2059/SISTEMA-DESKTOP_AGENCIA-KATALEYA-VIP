 x="0" y="26" width="229" height="88" as="geometry"/></mxCell><mxCell id="clases-guardados-26" value="TarifaGuardada" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1223" y="542" width="170" height="130" as="geometry"/></mxCell><mxCell id="clases-guardados-27" value="+ Id: int&lt;br&gt;+ Nombre: string?&lt;br&gt;+ Importe: decimal&lt;br&gt;+ Vigencia: Periodo?&lt;br&gt;+ IdUsuario: int&lt;br&gt;+ Sentido: string?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-guardados-26"><mxGeometry x="0" y="26" width="170" height="104" as="geometry"/></mxCell><mxCell id="clases-guardados-28" value="ParametroDelNegocioGuardado" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1433" y="542" width="192" height="98" as="geometry"/></mxCell><mxCell id="clases-guardados-29" value="+ Nombre: string&lt;br&gt;+ Valor: string&lt;br&gt;+ IdUsuario: int&lt;br&gt;+ FechaHora: DateTime" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-guardados-28"><mxGeometry x="0" y="26" width="192" height="72" as="geometry"/></mxCell><mxCell id="clases-guardados-30" value="PreferenciasGuardadas" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1665" y="542" width="170" height="66" as="geometry"/></mxCell><mxCell id="clases-guardados-31" value="+ IdUsuario: int&lt;br&gt;+ Tema: Tema" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-guardados-30"><mxGeometry x="0" y="26" width="170" height="40" as="geometry"/></mxCell><mxCell id="clases-guardados-32" value="CopiaDeRespaldoGuardada" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="173" height="98" as="geometry"/></mxCell><mxCell id="clases-guardados-33" value="+ Id: int&lt;br&gt;+ FechaHora: DateTime&lt;br&gt;+ Correcta: bool&lt;br&gt;+ NombreArchivo: string?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-guardados-32"><mxGeometry x="0" y="26" width="173" height="72" as="geometry"/></mxCell><mxCell id="clases-guardados-34" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Con Npgsql directo (D7, 21/10/2026), cada repositorio lee las columnas en un objeto «…Guardado» y rehace la entidad con su método estático Reconstruir, sin aplicar las reglas de creación del constructor: un pasaje pagado se lee tal como está, no vuelve a nacer Reservado ni toma la tarifa de hoy. Son records de C# y van en el dominio porque los recibe la entidad. Las asociaciones con otra raíz van por su id (IdEmisor, IdSede…); las partes de la misma raíz, dentro: los pagos y el boleto del pasaje; las unidades, los integrantes y los pagos del grupo. En amarillo, lo que espera el PA-73." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1100" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="clases-contratos" name="Clases: contratos de la Web API"><mxGraphModel dx="1943" dy="1352" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1943" pageHeight="1352" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="clases-contratos-1" value="Modelo de clases (fase 3): contratos de la Web API (Kataleya.Contratos)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="744" height="34" as="geometry"/></mxCell><mxCell id="clases-contratos-2" value="&lt;b&gt;Cuerpos de los pedidos (las solicitudes que reciben las entidades están en el dominio)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="900" height="24" as="geometry"/></mxCell><mxCell id="clases-contratos-3" value="SolicitudDeInicioDeSesion" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="179" height="66" as="geometry"/></mxCell><mxCel