ve="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-11-28" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-11-5" target="rob-cdu-11-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-11-29" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-11-6" target="rob-cdu-11-14"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-11-30" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-11-6" target="rob-cdu-11-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-11-31" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-11-7" target="rob-cdu-11-15"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-11-32" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rob-cdu-11-4" target="rob-cdu-11-8"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="290"/><mxPoint x="520" y="738"/></Array></mxGeometry></mxCell><mxCell id="rob-cdu-11-33" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-11-8" target="rob-cdu-11-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-11-1" value="Robustez — CDU-11 Registrar un grupo" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="387" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-11-2" value="IU-P03 Registro de pasaje (grupo)" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="318" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-11-3" value="Mostrar la capacidad de las unidades" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-11-4" value="Validar el grupo y la capacidad" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-11-5" value="Guardar el grupo, sus unidades, sus pasajes y el pago" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-11-6" value="Registrar en la bitácora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-11-7" value="Emitir los boletos (CDU-05)" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-11-8" value="Mostrar los errores" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-11-9" value="Tipo de vehículo" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-11-10" value="Grupo" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="318" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-11-11" value="Unidad de salida" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="418" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-11-12" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="518" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-11-13" value="Pago" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="618" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-11-14" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="718" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-11-15" value="Boleto de viaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="818" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-11-16" value="Encargado de ventas o Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="308" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-11-34" value="&lt;b&gt;CDU-11 Registrar un grupo&lt;/b&gt;&lt;br&gt;Actor: Encargado de ventas o Administrador&lt;br&gt;Requisitos: RF-31, RF-25, RF-05 · Pantallas: IU-P03&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El usuario abre el registro de pasaje (IU-P03) y elige el tipo de pasaje Grupo.&lt;br&gt;2. El usuario escribe el viaje que decide el grupo —origen, destino, lugar de recojo, fecha y hora acordada— y el precio acordado del grupo.&lt;br&gt;3. El usuario elige el tipo de vehículo de la unidad del grupo y agrega otra unidad si hace falta, según lo acordado; el sistema muestra la capacidad de asientos de cada unidad y la total. No se asignan asientos: los integrantes se distribuyen solos.&lt;br&gt;4. Por cada integrante, el usuario escribe su nombre y su documento; marca al responsable y escribe su teléfono.&lt;br&gt;5. Si el grupo paga, el usuario registra el pago por el monto total del grupo.&lt;br&gt;6. El usuario pulsa «Guardar». El sistema valida y registra en una sola operación las unidades del grupo y un pasaje por integrante, unidos por un código de grupo, con el estado que corresponde a los pagos, y en la misma transacción anota el registro en la bitácora.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Dato inválido de un integrante: el sistema no guarda ningún pasaje del grupo y señala el dato de cada integrante.&lt;br&gt;A2. Menos de dos integrantes, precio acordado que no es mayor que cero o fecha fuera de los siete días: el sistema no guarda e indica el motivo.&lt;br&gt;A3. Hay más integrantes que la capacidad total de las unidades: el sistema no guarda y pide agregar otra unidad o elegir un vehículo más grande.&lt;br&gt;A4. Los pagos cubren el precio acordado: los pasajes quedan Pagados y se emite un boleto de viaje por integrante (CDU-05), que en lugar del asiento dice «Grupo» y el código del grupo.&lt;br&gt;A5. El grupo quiere viajar en un horario regular: se registran pasajes individuales (CDU-01 o CDU-02)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="848" as="geometry"/></mxCell><mxCell id="rob-cdu-11-35" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-11-36" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-11-37" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-03" name="Robustez CDU-03"><mxGraphModel dx="1680" dy="1058" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1058" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-03-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-03-18" target="rob-cdu-03-2"><mxGeometry 