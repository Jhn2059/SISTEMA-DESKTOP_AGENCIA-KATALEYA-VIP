t;&lt;br&gt;EstadoImpresora' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="826" width="170" height="96" as="geometry"/></mxCell><mxCell id="clases-objetos-43" value="Lista&lt;br&gt;SinPapel&lt;br&gt;SinRespuesta" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-objetos-42"><mxGeometry x="0" y="40" width="170" height="56" as="geometry"/></mxCell><mxCell id="clases-objetos-44" value="&lt;b&gt;En la laptop&lt;/b&gt; (Kataleya.Cliente): lo que ClienteApi devuelve a los modelos de vista" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="974" width="900" height="24" as="geometry"/></mxCell><mxCell id="clases-objetos-45" value="ResultadoDeLaApi" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1008" width="204" height="130" as="geometry"/></mxCell><mxCell id="clases-objetos-46" value="+ Errores: List&amp;lt;ErrorDeCampo&amp;gt;&lt;br&gt;+ CodigoDeError: string?&lt;br&gt;+ SolicitudExitosa: bool&lt;br&gt;+ SesionExpirada: bool&lt;br&gt;+ SinPermiso: bool&lt;br&gt;+ /Exito: bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-objetos-45"><mxGeometry x="0" y="26" width="204" height="104" as="geometry"/></mxCell><mxCell id="clases-objetos-47" value="ResultadoDeLaApi&amp;lt;T&amp;gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="364" y="1008" width="179" height="50" as="geometry"/></mxCell><mxCell id="clases-objetos-48" value="+ Datos: T?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-objetos-47"><mxGeometry x="0" y="26" width="179" height="24" as="geometry"/></mxCell><mxCell id="clases-objetos-50" value="&lt;b&gt;En la laptop&lt;/b&gt; (Kataleya.Escritorio): lo que la aplicación de escritorio guarda en la laptop" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1188" width="900" height="24" as="geometry"/></mxCell><mxCell id="clases-objetos-51" value="ConfiguracionDeImpresora" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1222" width="198" height="66" as="geometry"/></mxCell><mxCell id="clases-objetos-52" value="+ NombreImpresora: string&lt;br&gt;+ AnchoDePapel: AnchoDePapel" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-objetos-51"><mxGeometry x="0" y="26" width="198" height="40" as="geometry"/></mxCell><mxCell id="clases-objetos-53" value='&lt;span style="font-weight:normal;"&gt;«enumeration»&lt;/span&gt;&lt;br&gt;AnchoDePapel' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="278" y="1222" width="170" height="80" as="geometry"/></mxCell><mxCell id="clases-objetos-54" value="Mm58&lt;br&gt;Mm80" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-objetos-53"><mxGeometry x="0" y="40" width="170" height="40" as="geometry"/></mxCell><mxCell id="clases-objetos-55" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Agrupan los parámetros de las operaciones, para que ninguna tenga más de dos (Clean Code). Las respuestas de la Web API están en la página «Clases: contratos de la Web API». Las solicitudes, los cambios del pasaje, los filtros y el periodo van en el dominio porque los usan las entidades y las interfaces de los repositorios; desde el 21/10/2026, las solicitudes las reciben los constructores de las entidades. DatosDelViaje y NumeroDeBoleto son objetos de valor (21/10/2026); SolicitudDeTarifa es una tarifa programada, y Salida, la fecha y hora de una salida con su sentido (24/10/2026); MovimientoDeBitacora es lo que se anota en la bitácora. Los objetos de datos son records de C#: su constructor recibe sus propiedades y no se dibuja. ContextoDeOperacion guarda la clave de operación y el usuario que la Web API toma de cada pedido, para que los servicios no reciban un parámetro más (IC-05). ErrorTecnico es lo que se anota en el registro técnico, sin datos personales ni contraseñas. ErrorDeCampo dice a qué campo corresponde cada error, para mostrarlo debajo de él (19/10/2026). ResultadoDeLaApi es lo que ClienteApi devuelve a los modelos de vista: los errores de los campos y el código del mensaje (3.9.6), también CON-01 o CON-02 sin conexión; ResultadoDeLaApi&amp;lt;T&amp;gt; hereda de él y agrega los datos de la respuesta. «+» es público y «?» marca un dato opcional." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1342" width="1200" height="130" as="geometry"/></mxCell><mxCell id="clases-objetos-49" value="" style="endArrow=block;endFill=0;endSize=14;html=1;rounded=0;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.378788;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="clases-objetos-47" target="clases-objetos-45"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="clases-guardados" name="Clases: objetos guardados"><mxGraphModel dx="1895" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1895" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="clases-guardados-1" value="Modelo de clases (fase 3): objetos guardados (Kataleya.Dominio)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="662" height="34" as="geometry"/></mxCell><mxCell id="clases-guardados-2" value="PasajeGuardado" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html