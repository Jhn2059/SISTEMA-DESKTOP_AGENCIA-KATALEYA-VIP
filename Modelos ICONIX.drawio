ue="Reservado con adelanto" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="320" width="190" height="50" as="geometry"/></mxCell><mxCell id="estados-7" value="Pagado" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="860" y="320" width="150" height="50" as="geometry"/></mxCell><mxCell id="estados-8" value="Anulado" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="590" width="170" height="50" as="geometry"/></mxCell><mxCell id="estados-9" value="No se presentó" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="590" width="170" height="50" as="geometry"/></mxCell><mxCell id="estados-10" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="372" y="730" width="26" height="26" as="geometry"/></mxCell><mxCell id="estados-11" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="832" y="730" width="26" height="26" as="geometry"/></mxCell><mxCell id="estados-22" value="Modificar la fecha, el horario, el asiento, el lugar de embarque o el titular no cambia el estado (RF-03). El boleto de viaje solo se imprime en estado Pagado (RF-05)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1100" y="320" width="320" height="90" as="geometry"/></mxCell><mxCell id="estados-23" value="&lt;b&gt;Cuenta de usuario&lt;/b&gt; (RF-23, RF-28)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="400" height="24" as="geometry"/></mxCell><mxCell id="estados-24" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="912" width="26" height="26" as="geometry"/></mxCell><mxCell id="estados-25" value="Activa" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="900" width="150" height="50" as="geometry"/></mxCell><mxCell id="estados-26" value="Bloqueada" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="780" y="900" width="150" height="50" as="geometry"/></mxCell><mxCell id="estados-27" value="Desactivada" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="1060" width="150" height="50" as="geometry"/></mxCell><mxCell id="estados-33" value="Cada cambio es una operación de Usuario: Bloquear al quinto intento fallido seguido (CDU-15); Desbloquear, Desactivar y Reactivar, por el Administrador (CDU-18 y CDU-17). Pasados 3 minutos, el bloqueo termina solo. Desactivar solo si PuedeDesactivarse(): la cuenta de la administradora no puede desactivarse. Una cuenta desactivada no se borra, para conservar la autoría de lo que emitió (RF-28)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="1020" width="480" height="110" as="geometry"/></mxCell><mxCell id="estados-12" value="reserva sin pago (RF-01)" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="estados-4" target="estados-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="estados-13" value="reserva con adelanto (RF-01, RF-25)" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estados-4" target="estados-6"><mxGeometry x="0.3" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/><Array as="points"><mxPoint x="73" y="190"/><mxPoint x="615" y="190"/></Array></mxGeometry></mxCell><mxCell id="estados-14" value="venta presencial o registro diferido (RF-02, RF-27)" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estados-4" target="estados-7"><mxGeometry x="0.3" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/><Array as="points"><mxPoint x="73" y="130"/><mxPoint x="935" y="130"/></Array></mxGeometry></mxCell><mxCell id="estados-15" value="registrar un adelanto (RF-25)" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="estados-5" target="estados-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="estados-16" value="cobrar el saldo (RF-25)" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="estados-6" target="estados-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="estados-17" value="cobrar el total (RF-25)" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estados-5" target="estados-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/><Array as="points"><mxPoint x="305" y="420"/><mxPoint x="935" y="420"/></Array></mxGeometry></mxCell><mxCell id="estados-18" value="anular, con motivo: solo el Administrador; libera el asiento (RF-04)" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.249;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estados-3" target="estados-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-10" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="estados-19" value="no se presenta a la hora indicada (RN-28)" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.71;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estados-3" target="estados-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="10" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="estados-20" value="" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="estados-8" target="estados-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-21" value="" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="estados-9" target="estados-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-28" value="crear la cuenta" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edg