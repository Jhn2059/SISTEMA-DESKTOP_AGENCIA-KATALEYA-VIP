span&gt;&lt;br&gt;Rutas: Reservas, ventas, grupos y pasajes diferidos' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="475" height="112" as="geometry"/></mxCell><mxCell id="web-api-11" value="POST /reservas → ServicioReservasYVentas.RegistrarReservaAsync&lt;br&gt;POST /ventas → ServicioReservasYVentas.RegistrarVentaAsync&lt;br&gt;POST /grupos → ServicioReservasYVentas.RegistrarGrupoAsync&lt;br&gt;POST /pasajes-diferidos → ServicioReservasYVentas.RegistrarDiferidoAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-10"><mxGeometry x="0" y="40" width="475" height="72" as="geometry"/></mxCell><mxCell id="web-api-12" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Boletos de viaje' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="448" width="576" height="80" as="geometry"/></mxCell><mxCell id="web-api-13" value="POST /boletos/{serie}-{numero}/reimpresiones → ServicioBoletos.RegistrarReimpresionAsync&lt;br&gt;POST /boletos/{serie}-{numero}/fallas → ServicioBoletos.RegistrarFallaDeImpresionAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-12"><mxGeometry x="0" y="40" width="576" height="40" as="geometry"/></mxCell><mxCell id="web-api-14" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Cuadre de ventas' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="280" height="64" as="geometry"/></mxCell><mxCell id="web-api-15" value="GET /cuadre → ServicioCuadre.GenerarAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-14"><mxGeometry x="0" y="40" width="280" height="24" as="geometry"/></mxCell><mxCell id="web-api-16" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Cuentas de usuario, roles y sedes' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="558" width="481" height="192" as="geometry"/></mxCell><mxCell id="web-api-17" value="GET /cuentas → ServicioCuentas.ListarAsync&lt;br&gt;POST /cuentas → ServicioCuentas.CrearCuentaAsync&lt;br&gt;PUT /cuentas/{id}/tema → ServicioCuentas.ElegirTemaAsync&lt;br&gt;POST /cuentas/{id}/desactivacion → ServicioCuentas.DesactivarAsync&lt;br&gt;POST /cuentas/{id}/reactivacion → ServicioCuentas.ReactivarAsync&lt;br&gt;POST /cuentas/{id}/desbloqueo → ServicioCuentas.DesbloquearAsync&lt;br&gt;PUT /cuentas/{id}/contrasena → ServicioCuentas.RestablecerContrasenaAsync&lt;br&gt;GET /roles → ServicioCatalogos.ListarRolesAsync&lt;br&gt;GET /sedes → ServicioCatalogos.ListarSedesAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-16"><mxGeometry x="0" y="40" width="481" height="152" as="geometry"/></mxCell><mxCell id="web-api-18" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Bitácora' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="652" width="318" height="64" as="geometry"/></mxCell><mxCell id="web-api-19" value="GET /bitacora → ServicioBitacora.ConsultarAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-18"><mxGeometry x="0" y="40" width="318" height="24" as="geometry"/></mxCell><mxCell id="web-api-20" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Reporte anual' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="746" width="519" height="96" as="geometry"/></mxCell><mxCell id="web-api-21" value="GET /reportes-anuales/pendiente → ServicioReporteAnual.HayReportePendienteAsync&lt;br&gt;POST /reportes-anuales/{anio} → ServicioReporteAnual.GenerarAsync&lt;br&gt;POST /reportes-anuales/{anio}/depuracion → ServicioReporteAnual.DepurarAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-20"><mxGeometry x="0" y="40" width="519" height="56" as="geometry"/></mxCell><mxCell id="web-api-22" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Copia de datos' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="780" width="526" height="80" as="geometry"/></mxCell><mxCell id="web-api-23" value="POST /copia-de-datos/semanal → ServicioCopiaDeDatos.HacerCopiaSiCorrespondeAsync&lt;br&gt;GET /copia-de-datos/estado → ServicioCopiaDeDatos.ObtenerEstadoAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-22"><mxGeometry x="0" y="40" width="526" height="40" as="geometry"/></mxCell><mxCell id="web-api-24" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Cada caja agrupa las rutas de un recurso; cada ruta llama a una operación de un servicio de aplicación. Todas van por HTTPS con JSON; menos POST /sesiones, todas piden la llave de la sesión, y la API revisa en cada pedido que la cuenta siga activa y que su rol pueda usar la ruta (RF-23). Las rutas que registran algo reciben la cabecera Idempotency-Key con la clave de operación (IC-05). Lo que recibe y devuelve cada ruta, y qué rol la usa, está en la tabla de la Web API del SDD (3.8). Las listas de IU-P10, en sus pestañas (cuentas, tarifas y parámetros), se leen con rutas GET de los mismos recursos. Si rechaza un pedido, la API responde con ProblemDetails (RFC 9457): el código del mensaje y los errores por campo. En la laptop, ClienteApi tiene una operación por ruta (19/10/2026)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1660" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="datos" name="Modelo de datos"><mxGraphModel dx="1964" dy="1646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1964" pageHeight="1646" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="datos-1" value="Modelo de datos — tablas de PostgreSQL (vista de información)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="642" height="34" as="geometry"/></mxCell><mxCell id="datos-2" value="rol" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1059" y="132" width="179" height="66" as="geometry"/></mxCell><mxCell id="datos-3" value="PK id: smallint&lt;br&gt;nombre: varchar(30) único" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-2"><mxGeometry x="0" y="26" width="179" height="40" as="geometry"/></mxCell><mxCell id="datos-4" value="sede" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1059" y="392" width="179" height="66" as="geometry"/></mxCell><mxCell id="datos-5" value="PK id: smallint&lt;br&gt;nombre: varchar(30) único" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-4"><mxGeometry x="0" y="26" width="179" height="40" as="geometry"/></mxCell><mxCell id="datos-6" value="usuario" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1348" y="320" width="248" height="210" as="geometry"/></mxCell><mxCell id="datos-7" value="PK id: integer&lt;br&gt;nombre_persona: varchar(100)&lt;br&gt;nombre_usuario: varchar(30) único&lt;br&gt;resumen_contrasena: text&lt;br&gt;sal: text&lt;br&gt;es_cuenta_principal: boolean&lt;br&gt;FK rol_id: smallint&lt;br&gt;FK sede_id: smallint&lt;br&gt;estado: varchar(12)&lt;br&gt;cantidad_intentos_fallidos: smallint&lt;br&gt;fin_bloqueo: timestamptz" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="datos-6"><mxGeometry x="0" y="26" width="248" height="184" as="geometry"/></mxCell><mxCell id="datos-8" value="pasaje" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=