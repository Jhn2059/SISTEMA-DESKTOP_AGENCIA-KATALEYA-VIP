ontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-18-6" value="Usuario" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="206" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-18-7" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="374" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-18-8" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="214.667" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-18-17" value="&lt;b&gt;CDU-18 Desbloquear una cuenta&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RF-28, RF-23, RF-24 · Pantallas: IU-P10&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El Administrador abre Configuración, en la pestaña «Cuentas de usuario» (IU-P10); la cuenta bloqueada se ve en ámbar, con la hora en que termina el bloqueo.&lt;br&gt;2. El Administrador elige la cuenta y pulsa «Desbloquear».&lt;br&gt;3. El sistema marca la cuenta como activa, pone en cero sus intentos fallidos y anota el cambio en la bitácora; la persona ya puede iniciar sesión.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. El bloqueo terminó mientras tanto: el resultado es el mismo, la cuenta queda activa.&lt;br&gt;A2. La cuenta está desactivada: el sistema no la desbloquea e indica que primero hay que reactivarla (VAL-05, CDU-17)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="690" as="geometry"/></mxCell><mxCell id="rob-cdu-18-18" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-18-19" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-18-20" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-19" name="Robustez CDU-19"><mxGraphModel dx="1680" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-19-9" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-19-8" target="rob-cdu-19-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-19-10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-19-2" target="rob-cdu-19-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-19-11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-19-3" target="rob-cdu-19-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-19-12" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-19-3" target="rob-cdu-19-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-19-13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-19-4" target="rob-cdu-19-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-19-14" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-19-4" target="rob-cdu-19-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-19-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-19-5" target="rob-cdu-19-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-19-1" value="Robustez — CDU-19 Restablecer la contraseña de una cuenta" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="601" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-19-2" value="IU-P10 Configuración" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-19-3" value="Validar la contraseña" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-19-4" value="Guardar la contraseña" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-19-5" value="Registrar en la bitácora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-19-6" value="Usuario" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-19-7" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="374" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-19-8" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-19-16" value="&lt;b&gt;CDU-19 Restablecer la contraseña de una cuenta&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RF-28, RF-24, RNF-04 · Pantallas: IU-P10&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El Administrador abre Configuración, en la pestaña «Cuentas de usuario» (IU-P10), elige una cuenta y pulsa «Restablecer contraseña».&lt;br&gt;2. El sistema abre un diálogo con el campo de la contraseña nueva.&lt;br&gt;3. El Administrador escribe una contraseña de al menos 8 caracteres y confirma; el sistema la guarda como resumen con sal, anota el cambio en la bitácora sin la contraseña y le recuerda que debe entregarla al usuario.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Contraseña de menos de 8 caracteres: el sistema no la guarda y muestra el error debajo del campo.&lt;br&gt;A2. El Administrador cierra el diálogo sin confirmar: no cambia nada." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="690" as="geometry"/></mxCell><mxCell id="rob-cdu-19-17" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-19-18" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-19-19" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-06" name="Robustez CDU-06"><mxGraphModel dx="1680" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-06-13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-12" target="rob-cdu-06-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-2" target="rob-cdu-06-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-3" target="rob-cdu-06-9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-3" target="rob-cdu-06-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-2" target="rob-cdu-06-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-4" target="rob-cdu-06-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-19" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-4" target="rob-cdu-06-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-20" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-5" target="rob-cdu-06-9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-5" target="rob-cdu-06-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-22" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rob-cdu-06-5" target="rob-cdu-06-8"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="402"/><mxPoint x="520" y="738"/></Array></mxGeometry></mxCell><mxCell id="rob-cdu-06-23" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-8" target="rob-cdu-06-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-24" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-4" target="rob-cdu-06-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-25" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-2" target="rob-cdu-06-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-26" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-6" target="rob-cdu-06-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-27" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-2" target="rob-cdu-06-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-28" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-7" target="rob-cdu-06-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-29" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-06-7" target="rob-cdu-06-8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-06-1" value="Robustez — CDU-06 Fijar la tarifa vigente" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="438" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-06-2" value="IU-P10 Configuración" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="374" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-06-3" value="Mostrar las tarifas" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-06-4" value="Validar la tarifa" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-06-5" value="Guardar la tarifa" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-06-6" value="Pedir confirmación" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-06-7" value="Quitar la tarifa programada" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-06-8" value="Registrar en la bitácora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-06-9" value="Tarifa regular" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-06-10" value="Tarifa programada" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="362" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-06-11" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="710" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-06-12" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="364" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-06-30" value='&lt;b&gt;CDU-06 Fijar la tarifa vigente&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RF-29, RF-24 · Pantallas: IU-P10&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El Administrador abre Configuración, en la pestaña «Tarifas y parámetros» (IU-P10); el sistema muestra las dos tarifas regulares, una por sentido —Huancayo → Ica e Ica → Huancayo—, y las programadas.&lt;br&gt;2. El Administrador escribe el importe de la tarifa regular de un sentido y pulsa «Guardar», o agrega una tarifa programada con nombre, importe, vigencia de un día o de un rango de fechas y sentido: uno de los dos o ambos.&lt;br&gt;3. El sistema valida los datos, guarda la tarifa, anota el cambio en la bitácora y avisa que se aplica a los pasajes nuevos; los pasajes ya registrados no cambian.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Editar o quitar una tarifa programada; antes de quitarla, el sistema pide confirmación (IU-05).&lt;br&gt;A2. Importe que no es mayor que cero, o fecha final anterior a la inicial: el sistema no guarda e indica el dato inválido.&lt;br&gt;A3. &lt;span style="background-color:#FFF2A8;"&gt;Las fechas se cruzan con las de otra tarifa programada del mismo sentido: el sistema no la guarda e indica con cuál se cruza (propuesta por validar, PA-73; SDD, Anexo E.3).&lt;/span&gt;' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="740" as="geometry"/></mxCell><mxCell id="rob-cdu-06-31" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-06-32" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-06-33" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-16" name="Robustez CDU-16"><mxGraphModel dx="1680" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-16-14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-13" target="rob-cdu-16-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-2" target="rob-cdu-16-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-3" target="rob-cdu-16-9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-3" target="rob-cdu-16-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-2" target="rob-cdu-16-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-4" target="rob-cdu-16-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-20" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-4" target="rob-cdu-16-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-5" target="rob-cdu-16-9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-22" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-2" target="rob-cdu-16-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-23" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-6" target="rob-cdu-16-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-24" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-6" target="rob-cdu-16-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-25" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-7" target="rob-cdu-16-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-26" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rob-cdu-16-5" target="rob-cdu-16-8"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="402"/><mxPoint x="520" y="738"/></Array></mxGeometry></mxCell><mxCell id="rob-cdu-16-27" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-16-8" target="rob-cdu-16-12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-16-1" value="Robustez — CDU-16 Mantener los parámetros del negocio" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="560" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-16-2" value="IU-P10 Configuración" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="351.6" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-16-3" value="Mostrar los parámetros" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-16-4" value="Validar el valor" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-16-5" value="Guardar el parámetro" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-16-6" value="Contar los pasajes del horario" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-16-7" value="Pedir confirmación" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-16-8" value="Registrar en la bitácora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-16-9" value="Parámetro del negocio" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-16-10" value="Tipo de vehículo" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-16-11" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="486" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-16-12" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="710" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-16-13" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="341.6" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-16-28" value="&lt;b&gt;CDU-16 Mantener los parámetros del negocio&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RNF-21, RF-24, RF-30 · Pantallas: IU-P10&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El Administrador abre Configuración, en la pestaña «Tarifas y parámetros» (IU-P10); el sistema muestra los parámetros del negocio y, solo para consultar, los tipos de vehículo, que son fijos: se cargan al instalar el sistema (24/10/2026).&lt;br&gt;2. El Administrador agrega o quita un horario de salida, o cambia el plazo máximo de reserva o el aviso previo para anular o cambiar un pasaje.&lt;br&gt;3. El sistema guarda el cambio, sin modificar el programa, y lo anota en la bitácora.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Agregar un horario: el Administrador escribe la hora en formato de 24 horas y pulsa «Agregar horario»; el sistema lo agrega en orden, para los dos sentidos. Si la hora no tiene ese formato o el horario ya existe, no lo agrega e indica el motivo debajo del campo.&lt;br&gt;A2. Plazo máximo de reserva fuera de 1 a 30 días, o aviso previo fuera de 0 a 24 horas, en números enteros: el sistema no guarda e indica el dato inválido.&lt;br&gt;A3. Quitar un horario: el sistema cuenta los pasajes no anulados de los próximos días en ese horario y pide confirmación con esa cantidad (IU-05). Con «Sí», lo quita: esos pasajes conservan su horario y, si hace falta, se modifican (CDU-03). El último horario no puede quitarse." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="740" as="geometry"/></mxCell><mxCell id="rob-cdu-16-29" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-16-30" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-16-31" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-08" name="Robustez CDU-08"><mxGraphModel dx="1680" dy="982" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="982" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-08-16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-15" target="rob-cdu-08-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-2" target="rob-cdu-08-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-3" target="rob-cdu-08-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-2" target="rob-cdu-08-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-20" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-4" target="rob-cdu-08-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-2" target="rob-cdu-08-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-22" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-6" target="rob-cdu-08-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-23" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-5" target="rob-cdu-08-12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-24" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-6" target="rob-cdu-08-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-25" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-6" target="rob-cdu-08-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-26" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-7" target="rob-cdu-08-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-27" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-7" target="rob-cdu-08-13"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-28" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-7" target="rob-cdu-08-8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-29" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-8" target="rob-cdu-08-14"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-30" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rob-cdu-08-6" target="rob-cdu-08-9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="514"/><mxPoint x="520" y="850"/></Array></mxGeometry></mxCell><mxCell id="rob-cdu-08-31" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rob-cdu-08-3" target="rob-cdu-08-9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="506" y="178"/><mxPoint x="506" y="850"/></Array></mxGeometry></mxCell><mxCell id="rob-cdu-08-32" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-08-9" target="rob-cdu-08-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-08-1" value="Robustez — CDU-08 Registrar pasajes emitidos con talonario" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="611" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-08-2" value="IU-P07 Registro diferido" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="430" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-08-3" value="Verificar el número del talonario" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-08-4" value="Asignar el asiento (CDU-10)" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-08-5" value="Obtener la tarifa vigente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-08-6" value="Validar los datos" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-08-7" value="Guardar como registro diferido" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-08-8" value="Registrar en la bitácora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-08-9" value="Mostrar los errores" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="822" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-08-10" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="474" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-08-11" value="Asiento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-08-12" value="Tarifa" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="374" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-08-13" value="Pago" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="598" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-08-14" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="710" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-08-15" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-08-33" value='&lt;b&gt;CDU-08 Registrar pasajes emitidos con talonario&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RF-27, RF-06, RF-24, RF-30 · Pantallas: IU-P07&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. Cuando el sistema vuelve a estar disponible, el Administrador abre el registro diferido (IU-P07).&lt;br&gt;2. Por cada boleto del talonario, el Administrador escribe su número, la fecha y hora reales de emisión y los datos del pasajero y del viaje, y asigna el asiento (CDU-10).&lt;br&gt;3. El sistema valida los datos y registra el pasaje como Pagado y marcado como registro diferido, con la hora real de emisión y la de registro, y lo anota en la bitácora. No se imprime boleto: el pasajero ya tiene el del talonario.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. El número de boleto ya existe: el sistema rechaza el registro e indica que el número ya existe.&lt;br&gt;A2. La fecha y hora de emisión son posteriores al momento del registro: el sistema no guarda.&lt;br&gt;A3. Otro dato inválido: como en CDU-01, A2.&lt;br&gt;A4. &lt;span style="background-color:#FFF2A8;"&gt;El asiento ya está ocupado por otro pasaje de esa salida: el sistema no guarda, muestra el dibujo de la unidad actualizado y pide otro asiento; el número del talonario se conserva (propuesta por validar; SDD, Anexo E.4).&lt;/span&gt;' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="852" as="geometry"/></mxCell><mxCell id="rob-cdu-08-34" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-08-35" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-08-36" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-14" name="Robustez CDU-14"><mxGraphModel dx="1680" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-14-9" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-14-8" target="rob-cdu-14-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-14-10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-14-2" target="rob-cdu-14-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-14-11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-14-3" target="rob-cdu-14-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-14-12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-14-3" target="rob-cdu-14-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-14-13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-14-3" target="rob-cdu-14-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-14-14" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-14-3" target="rob-cdu-14-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-14-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-14-4" target="rob-cdu-14-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-14-1" value="Robustez — CDU-14 Consultar la bitácora" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="417" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-14-2" value="IU-P09 Bitácora" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="206" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-14-3" value="Buscar con los filtros" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-14-4" value="Mostrar los registros" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-14-5" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-14-6" value="Usuario" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="250" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-14-7" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="350" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-14-8" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="196" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-14-16" value="&lt;b&gt;CDU-14 Consultar la bitácora&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RF-24, RNF-05 · Pantallas: IU-P09&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El Administrador abre la bitácora (IU-P09).&lt;br&gt;2. El Administrador filtra por usuario, fecha o pasaje.&lt;br&gt;3. El sistema muestra cada registro con el usuario, la fecha y hora, la operación, el pasaje afectado y los valores anterior y nuevo. Nadie puede editarlos ni borrarlos (RNF-05).&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Sin resultados: el sistema lo indica con un mensaje.&lt;br&gt;A2. La fecha inicial es posterior a la final: el sistema lo indica." s