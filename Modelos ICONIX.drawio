;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5201;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5201;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-21-4" target="sec-cdu-21-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-21-31" value="11: elegir la impresora y el ancho del papel" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5469;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5469;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-21-2" target="sec-cdu-21-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-21-32" value="12: GuardarConfiguracionAsync(configuracion)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5738;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5738;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-21-4" target="sec-cdu-21-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-21-33" value="la guarda en la laptop" style="html=1;align=left;spacingLeft=4;endArrow=block;endSize=8;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.6006;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.62;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-21-5" target="sec-cdu-21-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="48" y="0" as="offset"/><Array as="points"><mxPoint x="570" y="916"/><mxPoint x="570" y="942"/></Array></mxGeometry></mxCell><mxCell id="sec-cdu-21-34" value="13: pulsar «Imprimir prueba»" style="html=1;verticalAlign=bottom;endArrow