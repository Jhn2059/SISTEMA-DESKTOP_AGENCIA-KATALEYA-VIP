capas, Web API y frontera-control-entidad" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="621" height="34" as="geometry"/></mxCell><mxCell id="patrones-2" value="«capa» &lt;b&gt;Presentación&lt;/b&gt; (laptop)&lt;br&gt;Pantallas IU-P01 a IU-P10 en XAML con sus modelos de vista (patrón MVVM), en .NET MAUI" style="shape=folder;fontStyle=0;spacingTop=20;tabWidth=90;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="780" height="96" as="geometry"/></mxCell><mxCell id="patrones-3" value="«capa» &lt;b&gt;Cliente&lt;/b&gt; (laptop)&lt;br&gt;ClienteApi (patrón Proxy: representa en la laptop a la Web API), ServicioImpresion, AdaptadorImpresora (Adaptador), ServicioRespaldo, CopiaLocal y RegistroTecnico" style="shape=folder;fontStyle=0;spacingTop=20;tabWidth=90;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="216" width="780" height="96" as="geometry"/></mxCell><mxCell id="patrones-4" value="«capa» &lt;b&gt;Web API&lt;/b&gt; (servidor)&lt;br&gt;Kataleya.Api: fachada remota con rutas HTTPS que responde con objetos de transferencia de datos (Kataleya.Contratos)" style="shape=folder;fontStyle=0;spacingTop=20;tabWidth=90;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="342" width="780" height="96" as="geometry"/></mxCell><mxCell id="patrones-5" value="«capa» &lt;b&gt;Aplicación&lt;/b&gt; (servidor)&lt;br&gt;Servicios de aplicación: ServicioReservasYVentas, ServicioModificaciones, ServicioBoletos y los demás; ContextoDeOperacion" style="shape=folder;fontStyle=0;spacingTop=20;tabWidth=90;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="468" width="780" height="96" as="geometry"/></mxCell><mxCell id="patrones-6" value="«capa» &lt;b&gt;Dominio&lt;/b&gt;&lt;br&gt;Entidades (Pasaje, Grupo, Pago, BoletoDeViaje…), enumeraciones e interfaces (IRepositorioPasajes y los demás, ICopiaDeLaBase, IImpresora, IRespaldo, ICopiaLocal, IRegistroTecnico)" style="shape=folder;fontStyle=0;spacingTop=20;tabWidth=90;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="594" width="780" height="96" as="geometry"/></mxCell><mxCell id="patrones-7" value="«capa» &lt;b&gt;Datos&lt;/b&gt; (servidor)&lt;br&gt;Repositorios de PostgreSQL (patrón Repositorio), CopiaDeLaBase y AlmacenEnGoogleDrive" style="shape=folder;fontStyle=0;spacingTop=20;tabWidth=90;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="720" width="780" height="96" as="geometry"/></mxCell><mxCell id="patrones-14" value="Frontera" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="165" y="112" width="70" height="52" as="geometry"/></mxCell><mxCell id="patrones-15" value="Frontera" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="165" y="364" width="70" height="52" as="geometry"/></mxCell><mxCell id="patrones-16" value="Control" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="175" y="490" width="50" height="52" as="geometry"/></mxCell><mxCell id="patrones-17" value="Entidad" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="175" y="616" width="50" height="52" as="geometry"/></mxCell><mxCell id="patrones-18" value="Robustez de ICONIX" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="64" width="160" height="20" as="geometry"/></mxCell><mxCell id="patrones-19" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Cada capa usa la de abajo; datos y el cliente de la laptop implementan las interfaces que define el dominio (inversión de dependencias). Las pantallas son las fronteras de la robustez con el usuario, y la Web API, la frontera del servidor con sus clientes; los servicios son los controles y las entidades del dominio, las entidades. La Web API es una fachada remota: cada ruta atiende una operación completa y responde con un objeto de transferencia, nunca con una entidad (Fowler, 2002). ClienteApi es un proxy de la Web API (Gamma et al., 1994). AdaptadorImpresora es la frontera con la impresora. Cada pantalla es una página XAML enlazada a su modelo de vista (MVVM, 19/10/2026)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="330" height="360" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="despliegue" name="Despliegue"><mxGraphModel dx="1900" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="despliegue-1" value="Despliegue — parte física de la vista de composición" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="550" height="34" as="geometry"/></mxCell><mxCell id="despliegue-2" value="«dispositivo» &lt;b&gt;Laptop de la agencia&lt;/b&gt;&lt;br&gt;Windows 10 versión 1809 o superior, 64 bits; fija en la agencia" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="560" height="640" as="geometry"/></mxCell><mxCell id="despliegue-3" value="«ejecutable»&lt;br&gt;&lt;b&gt;Aplicación de escritorio&lt;/b&gt;&lt;br&gt;.NET MAUI 10 para Windows (WinUI 3)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="300" height="90" as="geometry"/></mxCell><mxCell id="despliegue-4" value="«archivo»&lt;br&gt;&lt;b&gt;Copia local de solo lectura&lt;/b&gt;&lt;br&gt;Pasajes del día (RNF-16)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="300" height="80" as="geometry"/></mxCell><mxCell id="despliegue-5" value="«archivo»&lt;br&gt;&lt;b&gt;Configuración&lt;/b&gt;&lt;br&gt;Dirección de la Web API; sin credenciales de la base de datos (RNF-20)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="410" width="300" height="90" as="geometry"/></mxCell><mxCell id="despliegue-6" value="«aplicación»&lt;br&gt;&lt;b&gt;Google Drive para escritorio&lt;/b&gt;&lt;br&gt;Sube el reporte anual" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="300" height="90" as="geometry"/></mxCell><mxCell id="despliegue-7" value="«archivo»&lt;br&gt;&lt;b&gt;Registro técnico&lt;/b&gt;&lt;br&gt;Errores técnicos, sin datos personales (IC-02)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="630" width="300" height="80" as="geometry"/></mxCell><mxCell id="despliegue-8" value="«nube» &lt;b&gt;Render&lt;/b&gt;&lt;br&gt;Servidor de la Web API, en un contenedor" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="420" height="290" as="geometry"/></mxCell><mxCell id="despliegue-9" value="«contenedor Docker»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;&lt;br&gt;Web API en ASP.NET Core, .NET 10" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1030" y="160" width="360" height="90" as="geometry"/></mxCell><mxCell id="despliegue-10" value="«configuración»&lt;br&gt;&lt;b&gt;Variables de entorno&lt;/b&gt;&lt;br&gt;Credenciales de la base de datos, clave de las copias y permiso de Google Drive (RNF-20)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1030" y="270" width="360" height="90" as="geometry"/></mxCell><mxCell id="despliegue-11" value="«nube» &lt;b&gt;Supabase&lt;/b&gt;&lt;br&gt;PostgreSQL en la versión que asigna Supabase; región São Paulo (sa-east-1). Supabase Cron: el pedido del domingo" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1520" y="120" width="320" height="125" as="geometry"/></mxCell><mxCell id="despliegue-12" value="«dispositivo» &lt;b&gt;Celular Android&lt;/b&gt;&lt;br&gt;Más adelante: aplicación móvil aparte, en .NET MAUI, con la misma Web API" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="1520" y="300" width="320" height="100" as="geometry"/></mxCell><mxCell id="despliegue-13" value="«dispositivo» &lt;b&gt;Impresora de etiquetas&lt;/b&gt;&lt;br&gt;GOOJPRT JP-58B, térmica, de 58 mm" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1000" y="450" width="320" height="100" as="geometry"/></mxCell><mxCell id="despliegue-14" value="«nube» &lt;b&gt;Google Drive de la empresa&lt;/b&gt;&lt;br&gt;Copia semanal cifrada (8 copias) y reporte anual en PDF con contraseña" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1000" y="600" width="320" height="100" as="geometry"/></mxCell><mxCell id="despliegue-15" value="Encargado de ventas" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="170" width="36" height="70" as="geometry"/></mxCell><mxCell id="despliegue-16" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="360" width="36" height="70" as="geometry"/></mxCell><mxCell id="despliegue-27" value="Sin internet, o si la Web API no responde, el sistema no registra: se emite con talonario y se registra después (RNF-16, RF-27). La fecha y hora las da el servidor de base de datos (IS-BD-07). Render y su costo se consultan a la clienta. La copia semanal la hace la Web API (CDU-22); el instalador es de Inno Setup, por usuario y sin permisos de administrador (27/10/2026)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="790" width="560" height="80" as="geometry"/></mxCell><mxCell id="despliegue-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="despliegue-15" target="despliegue-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="despliegue-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="despliegue-16" target="despliegue-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="despliegue-19" value="internet por wifi; HTTPS con TLS 1.2 o superior" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="despliegue-3" target="despliegue-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="despliegue-20" value="Npgsql con TLS" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="despliegue-9" target="despliegue-11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="despliegue-21" value="HTTPS: el domingo&lt;br&gt;a las 3:00" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.12;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="despliegue-11" target="despliegue-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="despliegue-22" value="sube la copia semanal (API de Google Drive)" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="despliegue-9" target="despliegue-14"><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint x="84" y="0" as="offset"/><Array as="points"><mxPoint x="1460" y="205"/><mxPoint x="1460" y="650"/></Array></mxGeometry></mxCell><mxCell id="despliegue-23" value="HTTPS (más adelante)" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="despliegue-12" target="despliegue-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="despliegue-24" value="USB o Bluetooth; ESC/POS" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="despliegue-3" target="despliegue-13"><mxGeometry x="0.6" relative="1" as="geometry"><mxPoint x="100" y="0" as="offset"/><Array as="points"><mxPoint x="940" y="225"/><mxPoint x="940" y="500"/></Array></mxGeometry></mxCell><mxCell id="despliegue-25" value="sincroniza la carpeta" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="despliegue-6" target="despliegue-14"><mxGeometry x="0.1" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="despliegue-26" value="deja los archivos" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="despliegue-3" target="despliegue-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="66" y="0" as="offset"/><Array as="points"><mxPoint x="680" y="257"/><mxPoint x="680" y="538"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="estructura" name="Estructura de la aplicación"><mxGraphModel dx="1860" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="estructura-1" value="Estructura de la aplicación de escritorio (Kataleya.Escritorio) — vista de estructura" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="886" height="34" as="geometry"/></mxCell><mxCell id="estructura-2" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1180" height="830" as="geometry"/></mxCell><mxCell id="estructura-3" value="&lt;b&gt;Kataleya.Escritorio: aplicación .NET MAUI para Windows&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="54" y="98" width="1152" height="22" as="geometry"/></mxCell><mxCell id="estructura-4" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1270" y="240" width="550" height="420" as="geometry"/></mxCell><mxCell id="estructura-5" value="&lt;b&gt;Kataleya.Cliente: lo que necesita todo cliente de la Web API&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1284" y="248" width="522" height="22" as="geometry"/></mxCell><mxCell id="estructura-6" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="360" height="362" as="geometry"/></mxCell><mxCell id="estructura-7" value="&lt;b&gt;Features/&amp;lt;área&amp;gt;/&amp;lt;pantalla&amp;gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="69" y="133" width="332" height="22" as="geometry"/></mxCell><mxCell id="estructura-8" value="&lt;b&gt;Vistas (…Page)&lt;/b&gt;&lt;br&gt;Página XAML de cada pantalla, IU-P01 a IU-P10, y de cada diálogo: confirmación, error y los que tienen campos. Solo muestran los datos y se enlazan a su modelo de vista." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="330" height="110" as="geometry"/></mxCell><mxCell id="estructura-9" value="&lt;b&gt;Resources/&lt;/b&gt;&lt;br&gt;En Styles/, los colores de los temas claro y oscuro (un diccionario por tema, con los mismos nombres) y los estilos de los componentes; además, fuente Inter, íconos, logo, foto de fondo y textos de los mensajes con su código (3.9.6)." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="330" height="140" as="geometry"/></mxCell><mxCell id="estructura-10" value="&lt;b&gt;AppShell&lt;/b&gt;&lt;br&gt;Navegación: una ruta por pantalla, según el mapa de navegación; muestra solo las del rol de la cuenta (RF-23)." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="330" height="110" as="geometry"/></mxCell><mxCell id="estructura-11" value="&lt;b&gt;Modelos de vista (…ViewModel)&lt;/b&gt;&lt;br&gt;Uno por pantalla y por diálogo, junto a su página (CommunityToolkit.Mvvm): estado de la pantalla, comandos asíncronos con indicador de espera (IU-07), validación de la forma de los campos y mensaje según el ResultadoDeLaApi." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="330" height="140" as="geometry"/></mxCell><mxCell id="estructura-12" value="«interfaz»&lt;br&gt;&lt;b&gt;IDialogos&lt;/b&gt; (Servicios/)&lt;br&gt;Abre un diálogo y devuelve lo que eligió el usuario: ConfirmarAsync, MostrarMensajeAsync y una operación por diálogo con campos (por ejemplo, PedirDatosDeCuentaAsync o PedirContrasenaAsync). La implementa DialogosDeMaui." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="330" height="150" as="geometry"/></mxCell><mxCell id="estructura-13" value="«interfaz»&lt;br&gt;&lt;b&gt;INavegacion&lt;/b&gt; (Servicios/)&lt;br&gt;Cambia de pantalla sin que el modelo de vista conozca las páginas: una operación por pantalla (por ejemplo, IrAlPanelAsync o IrAlInicioDeSesionAsync), VolverAsync y CerrarModalAsync. La implementa Navegacion, con el Shell." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="870" y="330" width="330" height="150" as="geometry"/></mxCell><mxCell id="estructura-14" value="&lt;b&gt;ServicioImpresion&lt;/b&gt;&lt;br&gt;Imprime el boleto que devuelve la Web API e informa el estado de la impresora." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="620" width="330" height="100" as="geometry"/></mxCell><mxCell id="estructura-15" value="&lt;b&gt;AdaptadorImpresora&lt;/b&gt;&lt;br&gt;Implementa IImpresora: traduce el boleto a comandos ESC/POS para la GOOJPRT JP-58B." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="620" width="330" height="100" as="geometry"/></mxCell><mxCell id="estructura-16" value="&lt;b&gt;ServicioRespaldo&lt;/b&gt;&lt;br&gt;Implementa IRespaldo: deja el reporte anual en la carpeta de Google Drive. La copia semanal la hace la Web API (27/10/2026)." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="870" y="620" width="330" height="120" as="geometry"/></mxCell><mxCell id="estructura-17" value="&lt;b&gt;MauiProgram&lt;/b&gt;&lt;br&gt;Arma el programa: conecta cada interfaz con su implementación (inyección de dependencias de MAUI) y registra la fuente Inter." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="780" width="255" height="120" as="geometry"/></mxCell><mxCell id="estructura-18" value="&lt;b&gt;Components/&lt;/b&gt;&lt;br&gt;Controles propios que usan varias pantallas; por ejemplo, el aviso de Bloq Mayús." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="355" y="780" width="255" height="120" as="geometry"/></mxCell><mxCell id="estructura-19" value="&lt;b&gt;UIHelpers/&lt;/b&gt;&lt;br&gt;Convertidores, comportamientos y extensiones que usan las páginas XAML." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="780" width="255" height="120" as="geometry"/></mxCell><mxCell id="estructura-20" value="&lt;b&gt;Platforms/Windows&lt;/b&gt;&lt;br&gt;Lo propio de Windows: barra de título integrada en la barra superior; Esc, Enter y flechas del mapa de asientos." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="925" y="780" width="255" height="120" as="geometry"/></mxCell><mxCell id="estructura-21" value="«proxy»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;&lt;br&gt;Una operación por ruta de la Web API. Guarda la llave y la cuenta de la sesión, genera la clave de operación (la repite al reintentar) y devuelve un ResultadoDeLaApi." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1300" y="280" width="490" height="140" as="geometry"/></mxCell><mxCell id="estructura-22" value="&lt;b&gt;CopiaLocal&lt;/b&gt;&lt;br&gt;Implementa ICopiaLocal: pasajes del día, solo lectura (RNF-16)." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1300" y="500" width="235" height="120" as="geometry"/></mxCell><mxCell id="estructura-23" value="&lt;b&gt;RegistroTecnico&lt;/b&gt;&lt;br&gt;Implementa IRegistroTecnico: errores en un archivo, sin datos personales (IC-02)." style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1555" y="500" width="235" height="120" as="geometry"/></mxCell><mxCell id="estructura-24" value="«externo»&lt;br&gt;&lt;b&gt;Web API (Kataleya.Api)&lt;/b&gt;&lt;br&gt;En Render" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1400" y="90" width="290" height="80" as="geometry"/></mxCell><mxCell id="estructura-25" value="&lt;b&gt;Kataleya.Dominio y Kataleya.Contratos&lt;/b&gt;&lt;br&gt;Interfaces IImpresora, IRespaldo, ICopiaLocal e IRegistroTecnico; contratos, filtros, enumeraciones y ErrorDeCampo. Los usan Kataleya.Escritorio y Kataleya.Cliente." style="shape=folder;fontStyle=0;spacingTop=20;tabWidth=90;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1270" y="700" width="550" height="100" as="geometry"/></mxCell><mxCell id="estructura-37" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Patrón MVVM: cada pantalla es una vista, una página XAML, enlazada a su modelo de vista; las vistas dependen de los modelos de vista y nunca al revés. El modelo de vista llama a ClienteApi y recibe los contratos de la Web API dentro de un ResultadoDeLaApi: muestra los errores de los campos debajo de cada campo y el código, en el diálogo de error (3.9.6). Abre los diálogos y cambia de pantalla con IDialogos e INavegacion, sin conocer las páginas. La forma de los datos se revisa en la pantalla; las reglas del negocio, en la Web API. Mientras una operación está en curso, el botón se desactiva y se ve el indicador de espera; la clave de operación evita registrar dos veces al reintentar (IC-05). Sin conexión, la barra ámbar y la lista de pasajes de la copia local (RNF-16). En los diagramas de robustez y de secuencia, la pantalla IU-P0n es la página con su modelo de vista. Las carpetas son las del código (21/10/2026): Features/ guarda juntas la página y su modelo de vista de cada pantalla o diálogo. El tema es de cada cuenta: se elige en Configuración (CDU-20) y se aplica al entrar; el inicio de sesión, y la cuenta que todavía no eligió uno, siguen el de Windows. La aplicación móvil, si se hace, sería otro proyecto que usaría Kataleya.Cliente." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1180" height="150" as="geometry"/></mxCell><mxCell id="estructura-26" value="enlace de datos y comandos" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estructura-8" target="estructura-11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-96" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="estructura-27" value="estilos y textos" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estructura-8" target="estructura-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell><mxCell id="estructura-28" value="abre diálogos" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estructura-11" target="estructura-12"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell><mxCell id="estructura-29" value="cambia de pantalla" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.95;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estructura-11" target="estructura-13"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/><Array as="points"><mxPoint x="383" y="510"/><mxPoint x="835" y="510"/><mxPoint x="835" y="450"/></Array></mxGeometry></mxCell><mxCell id="estructura-30" value="imprime el boleto" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estructura-11" target="estructura-14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-70" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="estructura-31" value="IImpresora" style="en