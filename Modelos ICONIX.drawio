t;br&gt;+ TotalEfectivo: decimal&lt;br&gt;+ TotalYape: decimal&lt;br&gt;+ AdelantosConSaldoPendiente: decimal&lt;br&gt;+ CantidadDeAnulados: int&lt;br&gt;+ ImporteAnulados: decimal&lt;br&gt;+ TotalNeto: decimal" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-contratos-38"><mxGeometry x="0" y="26" width="255" height="136" as="geometry"/></mxCell><mxCell id="clases-contratos-40" value="DatosDeBitacora" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1231" y="1000" width="173" height="130" as="geometry"/></mxCell><mxCell id="clases-contratos-41" value="+ FechaHora: DateTime&lt;br&gt;+ NombreUsuario: string&lt;br&gt;+ Operacion: string&lt;br&gt;+ IdPasaje: long?&lt;br&gt;+ ValorAnterior: string?&lt;br&gt;+ ValorNuevo: string?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-contratos-40"><mxGeometry x="0" y="26" width="173" height="104" as="geometry"/></mxCell><mxCell id="clases-contratos-42" value="DatosDelReporteAnual" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1444" y="1000" width="229" height="98" as="geometry"/></mxCell><mxCell id="clases-contratos-43" value="+ Anio: int&lt;br&gt;+ FechaHoraGeneracion: DateTime&lt;br&gt;+ CantidadDePasajesDepurados: int&lt;br&gt;+ RutaPdf: string" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-contratos-42"><mxGeometry x="0" y="26" width="229" height="72" as="geometry"/></mxCell><mxCell id="clases-contratos-44" value="ArchivoProtegido" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1713" y="1000" width="170" height="66" as="geometry"/></mxCell><mxCell id="clases-contratos-45" value="+ Nombre: string&lt;br&gt;+ Contenido: byte[]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-contratos-44"><mxGeometry x="0" y="26" width="170" height="40" as="geometry"/></mxCell><mxCell id="clases-contratos-46" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Lo que viaja en JSON entre la Web API y sus clientes: hoy la aplicación de escritorio y, más adelante, la aplicación móvil. La API nunca devuelve entidades del dominio: arma estos objetos con lo que muestra cada pantalla, y nunca envía el resumen de la contraseña, la sal ni los intentos fallidos (RNF-04). El tipo de cada propiedad dice qué objeto lleva dentro a otro; por ejemplo, DatosDePasaje lleva sus pagos y su boleto. Los filtros, el periodo, los cambios del pasaje y las enumeraciones son los del dominio. ArchivoProtegido lleva el PDF del reporte anual y la copia cifrada de la base de datos. En amarillo, lo que espera el PA-73." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1202" width="1100" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="web-api" name="Web API: rutas"><mxGraphModel dx="1760" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="web-api-1" value="Web API (Kataleya.Api): rutas y operación que atiende cada una" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="652" height="34" as="geometry"/></mxCell><mxCell id="web-api-2" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Sesiones' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="337" height="64" as="geometry"/></mxCell><mxCell id="web-api-3" value="POST /sesiones → ServicioSesion.IniciarSesionAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-2"><mxGeometry x="0" y="40" width="337" height="24" as="geometry"/></mxCell><mxCell id="web-api-4" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Tarifas, tipos de vehículo y parámetros' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="488" height="208" as="geometry"/></mxCell><mxCell id="web-api-5" value="GET /tarifas/vigente → ServicioTarifas.ObtenerTarifaVigenteAsync&lt;br&gt;GET /tipos-de-vehiculo → ServicioParametros.ObtenerTiposDeVehiculoAsync&lt;br&gt;GET /tarifas → ServicioTarifas.ListarTarifasAsync&lt;br&gt;PUT /tarifas/regular/{sentido} → ServicioTarifas.FijarTarifaRegularAsync&lt;br&gt;POST /tarifas → ServicioTarifas.GuardarTarifaAsync&lt;br&gt;DELETE /tarifas/{id} → ServicioTarifas.QuitarTarifaAsync&lt;br&gt;GET /parametros → ServicioParametros.ListarParametrosAsync&lt;br&gt;PUT /parametros/{nombre} → ServicioParametros.GuardarParametroAsync&lt;br&gt;POST /parametros/horarios → ServicioParametros.AgregarHorarioAsync&lt;br&gt;DELETE /parametros/horarios/{hora} → ServicioParametros.QuitarHorarioAsync" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="web-api-4"><mxGeometry x="0" y="40" width="488" height="168" as="geometry"/></mxCell><mxCell id="web-api-6" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;Rutas: Pasajes' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="194" width="576" height="192" as="geometry"/></mxCell><mxCell id="web-api-7" value="GET /pasajes/cantidad → ServicioConsultas.ContarPasajesDelHorarioAsync&lt;br&gt;POST /pasajes/{id}/revision-de-cambios → ServicioM