;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-03-6" value="Verificar el aviso de tres horas" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-03-7" value="Pedir confirmación" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-03-8" value="Aplicar y guardar los cambios" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-03-9" value="Registrar el valor anterior y el nuevo" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-03-10" value="Avisar la reimpresión" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="822" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-03-11" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="362" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-03-12" value="Usuario" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-03-13" value="Parámetro del negocio" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="462" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-03-14" value="Asiento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="598" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-03-15" value="Pago" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="698" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-03-16" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="798" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-03-17" value="Boleto de viaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="898" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-03-18" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="336" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-03-39" value="&lt;b&gt;CDU-03 Modificar un pasaje&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RF-03, RF-24, RF-25, RF-30 · Pantallas: IU-P04, IU-P05&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El Administrador busca el pasaje en la lista (IU-P04) y abre su detalle (IU-P05).&lt;br&gt;2. El Administrador pulsa «Modificar» y cambia la fecha, el horario, el asiento (CDU-10), el lugar de embarque o el titular.&lt;br&gt;3. El sistema pide confirmación y el Administrador confirma.&lt;br&gt;4. El sistema valida los valores nuevos, guarda el cambio y anota en la bitácora el valor anterior y el nuevo.&lt;br&gt;5. Si el boleto de viaje ya se imprimió, el sistema avisa que debe reimprimirse (CDU-05).&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Faltan menos de tres horas para la salida y cambia la fecha o el horario: el sistema lo advierte, solo permite una salida con asiento libre y el Administrador puede registrar un cobro adicional, que se suma al importe y se cobra en el acto.&lt;br&gt;A2. Usuario con rol Encargado de ventas: no modifica pasajes, pagados ni reservados; la opción no aparece (PA-74).&lt;br&gt;A3. Pasaje anulado: no se modifica.&lt;br&gt;A4. Valor inválido: el sistema rechaza el cambio e informa el motivo." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="928" as="geometry"/></mxCell><mxCell id="rob-cdu-03-40" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-03-41" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-03-42" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-04" name="Robustez CDU-04"><mxGraphModel dx="1680" dy="982" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="982" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-04-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-04-16" target="rob-cdu-04-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-04-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-04-2" target="rob-cdu-04-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-04-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-04-4" target="rob-cdu-04-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-04-20" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-04-16" target="rob-cdu-04-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-04-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-04-3" target="rob-cdu-04-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-04-22" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-04-5" target="rob-cdu-04-11"><mxGeometry x="0" relative="1" as="geometry"