x="40" y="20" width="581" height="34" as="geometry"/></mxCell><mxCell id="sec-cdu-21-2" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="20" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-3" value="&lt;b&gt;Administrador&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-21-4" value="«boundary»&lt;br&gt;&lt;b&gt;IU-P10 Configuración&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-5" value="«control»&lt;br&gt;&lt;b&gt;ServicioImpresion&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-6" value="«boundary»&lt;br&gt;&lt;b&gt;AdaptadorImpresora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-7" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="20" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-8" value="&lt;b&gt;Impresora de etiquetas&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="835" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-21-9" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-10" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-11" value="«control»&lt;br&gt;&lt;b&gt;ServicioCopiaDeDatos&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-12" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioCopias&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="160" height="1342" as="geometry"/></mxCell><mxCell id="sec-cdu-21-43" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="1150" width="572" height="252" as="geometry"/></mxCell><mxCell id="sec-cdu-21-44" value="[impresión correcta]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="1174" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-21-45" value="[sin respuesta o sin papel]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="1290" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-21-46" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="1280" width="572" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-21-47" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. La impresora no responde o no tiene papel: el sistema lo indica (IMP-01 o IMP-02) y conserva la configuración." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1462" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-21-13" value="1: abrir la pestaña «Equipo»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0641;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0641;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-21-2" target="sec-cdu-21-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-21-14" value="2: ObtenerConfiguracionAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0909;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0909;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-21-4" target="sec-cdu-21-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-21-15" value="impresora y ancho del papel" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1177;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1177;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-21-5" target="sec-cdu-21-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-21-16" value="3: ListarImpresorasAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1446;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1446;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-21-4" target="sec-cdu-21-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-21-17" value="4: ListarImpresorasAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1714;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1714;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" p