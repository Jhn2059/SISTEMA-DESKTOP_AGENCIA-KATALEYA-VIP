eometry x="250" y="458" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-04-4" value="Buscar el pasaje" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-04-5" value="Verificar el aviso de tres horas" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-04-6" value="Pedir confirmación" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-04-7" value="Anular y liberar el asiento" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-04-8" value="Registrar la devolución" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-04-9" value="Marcar No se presentó" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-04-10" value="Registrar en la bitácora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="822" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-04-11" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="402" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-04-12" value="Parámetro del negocio" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-04-13" value="Asiento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="502" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-04-14" value="Pago" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="602" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-04-15" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="822" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-04-16" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="294" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-04-36" value="&lt;b&gt;CDU-04 Anular un pasaje&lt;/b&gt;&lt;br&gt;Actor: Administrador&lt;br&gt;Requisitos: RF-04, RF-24, RF-25, RF-30 · Pantallas: IU-P04, IU-P05&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. El Administrador busca el pasaje en la lista (IU-P04) y abre su detalle (IU-P05).&lt;br&gt;2. El Administrador pulsa «Anular».&lt;br&gt;3. El sistema pide confirmación con el campo del motivo; el Administrador escribe el motivo y confirma.&lt;br&gt;4. El sistema marca el pasaje como Anulado, libera su asiento, lo deja fuera de los totales del cuadre y anota la anulación en la bitácora.&lt;br&gt;5. Si faltan tres horas o más para la salida, o si anula la agencia, el sistema registra la devolución del adelanto.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Faltan menos de tres horas: el sistema lo advierte y el adelanto queda retenido; el Administrador puede devolverlo como excepción, indicando el motivo.&lt;br&gt;A2. Pasaje ya anulado: no se anula de nuevo ni se modifica.&lt;br&gt;A3. Falta el motivo: el sistema no anula.&lt;br&gt;A4. El pasajero no se presentó a la hora indicada: el pasaje pasa a No se presentó, sin devolución (RN-28). Lo marca el Administrador desde el detalle (IU-P05), solo después de la hora de salida, y queda en la bitácora." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="852" as="geometry"/></mxCell><mxCell id="rob-cdu-04-37" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-04-38" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-04-39" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-05" name="Robustez CDU-05"><mxGraphModel dx="1680" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-05-16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-05-5" target="rob-cdu-05-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-05-17" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-05-5" target="rob-cdu-05-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-05-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-05-4" target="rob-cdu-05-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-05-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-05-5" target="rob-cdu-05-12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-05-20" value="" style="endArrow=open;endSize=9;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-05-5" target="rob-cdu-05-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-05-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-05-6" target="rob-cdu-05-3"><mxGeometry x="0" relative="1" as=