ngRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-interfaces-232"><mxGeometry x="0" y="58" width="198" height="24" as="geometry"/></mxCell><mxCell id="clases-interfaces-237" value="&lt;b&gt;Acceso a datos con Npgsql&lt;/b&gt; (Kataleya.Datos)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1133" y="3316" width="500" height="22" as="geometry"/></mxCell><mxCell id="clases-interfaces-238" value="ContextoDeBaseDeDatos" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1133" y="3350" width="368" height="114" as="geometry"/></mxCell><mxCell id="clases-interfaces-239" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-interfaces-238"><mxGeometry x="0" y="26" width="368" height="24" as="geometry"/></mxCell><mxCell id="clases-interfaces-240" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="clases-interfaces-238"><mxGeometry x="0" y="50" width="368" height="8" as="geometry"/></mxCell><mxCell id="clases-interfaces-241" value="+ «create» ContextoDeBaseDeDatos(fuente: FuenteDeDatos)&lt;br&gt;+ ObtenerConexionAsync(): Task&amp;lt;NpgsqlConnection&amp;gt;&lt;br&gt;+ EjecutarEnTransaccionAsync(trabajo: Func&amp;lt;Task&amp;gt;): Task" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-interfaces-238"><mxGeometry x="0" y="58" width="368" height="56" as="geometry"/></mxCell><mxCell id="clases-interfaces-242" value="FuenteDeDatos" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1621" y="3350" width="337" height="98" as="geometry"/></mxCell><mxCell id="clases-interfaces-243" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-interfaces-242"><mxGeometry x="0" y="26" width="337" height="24" as="geometry"/></mxCell><mxCell id="clases-interfaces-244" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="clases-interfaces-242"><mxGeometry x="0" y="50" width="337" height="8" as="geometry"/></mxCell><mxCell id="clases-interfaces-245" value="+ «create» FuenteDeDatos(cadenaDeConexion: string)&lt;br&gt;+ AbrirConexionAsync(): Task&amp;lt;NpgsqlConnection&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-interfaces-242"><mxGeometry x="0" y="58" width="337" height="40" as="geometry"/></mxCell><mxCell id="clases-interfaces-247" value="&lt;b&gt;Clases que las usan&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="96" width="420" height="24" as="geometry"/></mxCell><mxCell id="clases-interfaces-248" value="&lt;b&gt;Interfaces (Kataleya.Dominio)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="96" width="420" height="24" as="geometry"/></mxCell><mxCell id="clases-interfaces-249" value="&lt;b&gt;Implementaciones (Datos, Cliente y Escritorio)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1133" y="96" width="420" height="24" as="geometry"/></mxCell><mxCell id="clases-interfaces-250" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Inversión de dependencias: los servicios usan las interfaces que define el dominio (flecha punteada, «usa»), y las clases de Kataleya.Datos, Kataleya.Cliente y Kataleya.Escritorio las implementan (flecha punteada con triángulo). En el servidor, Kataleya.Api conecta cada interfaz con su implementación; en la laptop, Kataleya.Escritorio. IImpresora, IRespaldo, ICopiaLocal e IRegistroTecnico se implementan en la laptop: CopiaLocal y RegistroTecnico en Kataleya.Cliente, que podría usar también una aplicación móvil, y AdaptadorImpresora y ServicioRespaldo en Kataleya.Escritorio, porque solo existen en Windows; las demás, en el servidor. En las secuencias aparece la clase que implementa la interfaz. Desde el 27/10/2026 la copia semanal la hace la Web API (CDU-22): CopiaDeLaBase la exporta y la cifra, AlmacenEnGoogleDrive la sube a la carpeta de la empresa y RepositorioCopias anota cada intento; IRespaldo solo guarda el reporte anual. Todas las operaciones son asíncronas (terminan en «Async» y devuelven Task o Task&amp;lt;T&amp;gt;): hacen entrada o salida. Desde el 21/10/2026, como en el código: IRepositorioCatalogos (roles y sedes), IUnidadDeTrabajo (la transacción del pedido), IReloj (la hora del servidor) e IRepositorioReportesAnuales. Cada implementación muestra su constructor: los repositorios reciben ContextoDeBaseDeDatos, que abre la conexión del pedido con FuenteDeDatos (NpgsqlDataSource) y lleva la transacción." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="3520" width="1605" height="110" as="geometry"/></mxCell><mxCell id="clases-interfaces-104" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.333;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="clases-interfaces-88" target="clases-interfaces-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="clases-interfaces-105" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.667;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="clases-interfaces-98" target="clases-interfaces-3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="clases-interfaces-106" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.333;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="clases-interfaces-97" target="clases-interfaces-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="clases-interfaces-107" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;e