ntryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rob-cdu-05-6" target="rob-cdu-05-9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="506" y="402"/><mxPoint x="506" y="738"/></Array></mxGeometry></mxCell><mxCell id="rob-cdu-05-30" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-05-9" target="rob-cdu-05-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-05-1" value="Robustez — CDU-05 Emitir el boleto de viaje" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="458" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-05-2" value="IU-P05 Detalle del pasaje" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="654" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-05-3" value="Interfaz de la impresora (ESC/POS)" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="374" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-05-4" value="Obtener el número correlativo" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-05-5" value="Generar el boleto" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-05-6" value="Enviar a la impresora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-05-7" value="Registrar la emisión" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-05-8" value="Reimprimir el boleto" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-05-9" value="Avisar el fallo de la impresora" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-05-10" value="Pasaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-05-11" value="Correlativo de boletos" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-05-12" value="Boleto de viaje" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-05-13" value="Registro de bitácora" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="530" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-05-14" value="Encargado de ventas o Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="644" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-05-15" value="Impresora de etiquetas" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="414" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-05-31" value="&lt;b&gt;CDU-05 Emitir el boleto de viaje&lt;/b&gt;&lt;br&gt;Actor: Encargado de ventas o Administrador · Secundario: Impresora de etiquetas&lt;br&gt;Requisitos: RF-05, RF-06, RF-24, RI-01 · Pantallas: IU-P03, IU-P05&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. Cuando un pasaje queda Pagado, el sistema genera su boleto de viaje con los datos de la empresa, el número correlativo siguiente, los datos del viaje y el asiento.&lt;br&gt;2. El sistema envía el boleto a la impresora de etiquetas.&lt;br&gt;3. El sistema registra la emisión, con su emisor, en la bitácora.&lt;br&gt;4. El usuario entrega el boleto al pasajero.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. Reimpresión: desde el detalle (IU-P05), el usuario pulsa «Reimprimir»; el sistema imprime el mismo boleto sin consumir numeración y anota la reimpresión en la bitácora.&lt;br&gt;A2. La impresora no responde o no tiene papel: el pasaje queda registrado, el sistema avisa del fallo (IMP-01, IMP-02), y el boleto se imprime después desde el detalle (IU-P05; IH-04, IH-T04).&lt;br&gt;A3. El pasaje no está pagado: no se imprime.&lt;br&gt;A4. Grupo: se emite un boleto de viaje por integrante, que en lugar del asiento dice «Grupo» y el código del grupo." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="740" as="geometry"/></mxCell><mxCell id="rob-cdu-05-32" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-05-33" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-05-34" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rob-cdu-13" name="Robustez CDU-13"><mxGraphModel dx="1680" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rob-cdu-13-11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-13-10" target="rob-cdu-13-2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-13-12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-13-2" target=