ze=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-6" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-7" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-8" value="«control»&lt;br&gt;&lt;b&gt;ServicioTarifas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-9" value="«control»&lt;br&gt;&lt;b&gt;ServicioReservasYVentas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-10" value="«entity»&lt;br&gt;&lt;b&gt;Pasaje&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-11" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioPasajes&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-12" value="«control»&lt;br&gt;&lt;b&gt;ServicioBitacora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1850" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-13" value="«control»&lt;br&gt;&lt;b&gt;ServicioBoletos&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2050" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-14" value="«entity»&lt;br&gt;&lt;b&gt;Pago&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2250" y="110" width="160" height="1396" as="geometry"/></mxCell><mxCell id="sec-cdu-02-47" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="844" width="2172" height="612" as="geometry"/></mxCell><mxCell id="sec-cdu-02-48" value="[datos válidos y pago completo]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="868" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-02-49" value="[datos inválidos o pago incompleto]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="1272" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-02-50" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="1262" width="2172" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-02-51" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. Cobro del saldo de una reserva: el usuario busca el pasaje en la lista (IU-P04), abre su detalle (IU-P05) y registra el pago del saldo; cuando el saldo llega a cero, el pasaje pasa a Pagado y se emite el boleto (CDU-05).&lt;br&gt;A2. El pago no cubre el importe: el sistema no guarda e indica el saldo pendiente.&lt;br&gt;A3. Dato inválido o asiento ocupado: como en CDU-01, A2.&lt;br&gt;A4. Falla la grabación: no queda el cobro sin el pasaje ni el pasaje sin el cobro, y el boleto no se envía a la impresora (RNF-19)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1516" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-02-15" value="1: escribir los datos y elegir el asiento (CDU-10)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0616;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0616;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-02-2" target="sec-cdu-02-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-02-16" value="2: ObtenerTarifaVigenteAsync(fecha, sentido)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0874;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0874;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-02-4" target="sec-cdu-02-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-02-17" value="3: GET /tarifas/vigente" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1132;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1132;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-02-6" target="sec-cdu-02-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-02-18" value="4: ObtenerTarifaVigenteAsync(fecha, sentido)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.139;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.139;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-02-7" target="sec-cdu-02-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-02-19" value="tarifa" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1648;exitDx=0;exitD