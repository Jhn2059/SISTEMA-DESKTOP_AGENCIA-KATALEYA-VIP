or=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estructura-21" target="estructura-23"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="64" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="estructura-36" value="HTTPS con JSON; ProblemDetails si rechaza" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="estructura-21" target="estructura-24"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-150" y="0" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="navegacion" name="Navegación"><mxGraphModel dx="1360" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="navegacion-1" value="Mapa de navegación entre pantallas (vista de interfaz de usuario)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="683" height="34" as="geometry"/></mxCell><mxCell id="navegacion-2" value="&lt;b&gt;IU-P01&lt;/b&gt;&lt;br&gt;Inicio de sesión" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-3" value="&lt;b&gt;IU-P02&lt;/b&gt;&lt;br&gt;Panel principal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-4" value="&lt;b&gt;IU-P03&lt;/b&gt;&lt;br&gt;Registro de pasaje" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-5" value="&lt;b&gt;IU-P04&lt;/b&gt;&lt;br&gt;Lista de pasajes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-6" value="&lt;b&gt;IU-P05&lt;/b&gt;&lt;br&gt;Detalle del pasaje" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="200" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-7" value="&lt;b&gt;IU-P06&lt;/b&gt;&lt;br&gt;Cuadre de ventas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-8" value="&lt;b&gt;IU-P07&lt;/b&gt;&lt;br&gt;Registro diferido" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-9" value="&lt;b&gt;IU-P09&lt;/b&gt;&lt;br&gt;Bitácora" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="500" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-10" value="&lt;b&gt;IU-P10&lt;/b&gt;&lt;br&gt;Configuración" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="600" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-11" value="&lt;b&gt;Diálogo&lt;/b&gt;&lt;br&gt;Acerca del sistema (menú de la cuenta)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-12" value="&lt;b&gt;Diálogo&lt;/b&gt;&lt;br&gt;Reporte anual: aviso y contraseña del PDF" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="560" width="210" height="60" as="geometry"/></mxCell><mxCell id="navegacion-24" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Línea punteada: pantalla solo del rol Administrador (RF-23); el panel muestra solo las opciones del rol. Desde cualquier pantalla se vuelve al panel principal (IU-C06). En IU-P05 se cobra el saldo y se emite o reimprime el boleto de viaje; solo el Administrador modifica, anula y marca «No se presentó». Configuración, solo del Administrador, tiene pestañas: Tarifas y parámetros, Cuentas de usuario y Equipo. Desde el 27/10/2026 el tema se cambia con un botón de la barra superior, y «Acerca del sistema» se abre desde el menú de la cuenta, junto a «Cerrar sesión», en cualquier pantalla." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1220" height="70" as="geometry"/></mxCell><mxCell id="navegacion-13" value="Ingresar" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-2" target="navegacion-3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-14" value="Cerrar sesión" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="14" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-15" value="Registrar pasaje" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-4"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-16" value="Lista de pasajes" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-5"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-17" value="Cuadre de ventas" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-7"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-18" value="Registro diferido" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-8"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-19" value="Bitácora" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-9"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-20" value="Configuración" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-10"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-21" value="Pulsar una fila" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="navegacion-5" target="navegacion-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-22" value="Reporte anual" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-12"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="50" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="navegacion-23" value="Acerca del sistema" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegacion-3" target="navegacion-11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-60" y="0" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="trazabilidad-rf" name="Trazabilidad RF"><mxGraphModel dx="1470" dy="1971" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="1971" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="trazabilidad-rf-1" value="Trazabilidad de los requisitos funcionales (ERS, 3.7 y Anexo F)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="662" height="34" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-2" value="&lt;b&gt;RF-01 Registrar una reserva&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 43-44, 576-584; E2 l. 90-95, 367-372; E3 l. 293-350" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="380" height="65" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-3" value="&lt;b&gt;RF-02 Registrar una venta presencial&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 571, 578, 591-596; E2 l. 646-660" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="191" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-4" value="&lt;b&gt;RF-03 Modificar un pasaje&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 611-612, 1246-1247; E2 l. 21-23, 59-63; E3 l. 210-212, 516-536" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="267" width="380" height="65" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-5" value="&lt;b&gt;RF-04 Anular un pasaje&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 615-616; E2 l. 19-20, 52-58; E3 l. 183-212, 485-515, 859-860; talonario" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="358" width="380" height="65" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-6" value="&lt;b&gt;RF-05 Emitir el boleto de viaje&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 53-54, 425-455; E2 l. 197-245; R. S. 156-2003/SUNAT" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="449" width="380" height="65" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-7" value="&lt;b&gt;RF-06 Identificar al emisor&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 392-393, 417" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="540" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-8" value="&lt;b&gt;RF-07 Consultar pasajes&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 502-509" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="616" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-9" value="&lt;b&gt;RF-23 Controlar el acceso por rol&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 514-515, 704-706; E3 l. 531-536, 888-889" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="692" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-10" value="&lt;b&gt;RF-24 Registrar la bitácora&lt;/b&gt;&lt;br&gt;Fuente: Decisión del equipo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="768" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-11" value="&lt;b&gt;RF-25 Registrar el cobro o adelanto&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 284-288, 406-414; E2 l. 339-342; E3 l. 223-234" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="844" width="380" height="65" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-12" value="&lt;b&gt;RF-26 Generar el cuadre por emisor&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 392-417; E3 l. 251-280; decisión del equipo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="935" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-13" value="&lt;b&gt;RF-27 Registrar pasajes en contingencia&lt;/b&gt;&lt;br&gt;Fuente: E1 l. 752-762; E3 l. 895" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1011" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-14" value="&lt;b&gt;RF-28 Gestionar cuentas de usuario&lt;/b&gt;&lt;br&gt;Fuente: Decisión del equipo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1087" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-15" value="&lt;b&gt;RF-29 Fijar la tarifa vigente&lt;/b&gt;&lt;br&gt;Fuente: E2 l. 179-186; E3 l. 560-587" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1163" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-16" value="&lt;b&gt;RF-30 Asignar el asiento&lt;/b&gt;&lt;br&gt;Fuente: E3 l. 57-99, 450-455, 859-860" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1239" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-17" value="&lt;b&gt;RF-31 Registrar un grupo&lt;/b&gt;&lt;br&gt;Fuente: E3 l. 118-123, 896" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1315" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-18" value="&lt;b&gt;RF-32 Generar el reporte anual&lt;/b&gt;&lt;br&gt;Fuente: E3 l. 367-387" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFFFFF;strokeColor=#1F3A68;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1391" width="380" height="50" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-19" value="&lt;b&gt;FN-01&lt;/b&gt;&lt;br&gt;Registrar una reserva." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="108.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-20" value="&lt;b&gt;NU-10&lt;/b&gt;&lt;br&gt;Cambiar la fecha, el horario, el lugar de recojo o el titular de una reserva." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#DAE8FC;strokeColor=#3465A4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="184.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-21" value="&lt;b&gt;NU-08&lt;/b&gt;&lt;br&gt;Emitir rápido el pasaje de quien está en la agencia, para no hacerlo esperar." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#DAE8FC;strokeColor=#3465A4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="257.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-22" value="&lt;b&gt;FN-02&lt;/b&gt;&lt;br&gt;Registrar una venta presencial." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="330.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-23" value="&lt;b&gt;FN-03&lt;/b&gt;&lt;br&gt;Modificar." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="388.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-24" value="&lt;b&gt;FN-04&lt;/b&gt;&lt;br&gt;Anular." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="446.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-25" value="&lt;b&gt;FN-05&lt;/b&gt;&lt;br&gt;Emitir el boleto de viaje." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="504.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-26" value="&lt;b&gt;NU-04&lt;/b&gt;&lt;br&gt;Saber quién registró cada pasaje y cada cobro, para cuadrar la caja sin descuadres." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#DAE8FC;strokeColor=#3465A4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="562.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-27" value="&lt;b&gt;FN-06&lt;/b&gt;&lt;br&gt;Registrar el emisor." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="635.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-28" value="&lt;b&gt;NU-19&lt;/b&gt;&lt;br&gt;Consultar las reservas y ventas registradas, sin depender de la agenda de papel." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#DAE8FC;strokeColor=#3465A4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="693.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-29" value="&lt;b&gt;FN-07&lt;/b&gt;&lt;br&gt;Consultar el detalle de un pasaje." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="766.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-30" value="&lt;b&gt;ON-03&lt;/b&gt;&lt;br&gt;Que cada boleto y cada cobro queden atribuidos a quien los registró, para eliminar los descuadres." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#D5E8D4;strokeColor=#5A8F3C;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="824.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-31" value="&lt;b&gt;AC-04&lt;/b&gt;&lt;br&gt;Seguridad de acceso: roles diferenciados; solo la propietaria fija precios." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#E1D5E7;strokeColor=#7B4F9E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="897.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-32" value="&lt;b&gt;AC-05&lt;/b&gt;&lt;br&gt;Trazabilidad: saber quién registró cada operación." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#E1D5E7;strokeColor=#7B4F9E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="970.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-33" value="&lt;b&gt;FN-23&lt;/b&gt;&lt;br&gt;Autenticación con roles y permisos." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1028.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-34" value="&lt;b&gt;ON-04&lt;/b&gt;&lt;br&gt;Reducir el tiempo dedicado a controlar el dinero." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#D5E8D4;strokeColor=#5A8F3C;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1086.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-35" value="&lt;b&gt;Glosario «Contingencia»&lt;/b&gt;&lt;br&gt;Término «Contingencia» del glosario (1.3.2)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1144.5" width="350" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-36" value="&lt;b&gt;NU-13&lt;/b&gt;&lt;br&gt;Fijar el precio del pasaje según la temporada, para que quien venda cobre el precio vigente sin poder cambiarlo." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#DAE8FC;strokeColor=#3465A4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1202.5" width="350" height="78" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-37" value="&lt;b&gt;FN-25&lt;/b&gt;&lt;br&gt;Fijar la tarifa vigente: una regular y tarifas programadas." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1290.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-38" value="&lt;b&gt;FN-32&lt;/b&gt;&lt;br&gt;Asignar el asiento de cada pasaje individual en el dibujo de la unidad." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1363.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-39" value="&lt;b&gt;NU-20&lt;/b&gt;&lt;br&gt;Elegir el asiento de cada pasajero en el dibujo de la unidad, «igual como los cines»." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#DAE8FC;strokeColor=#3465A4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1436.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-40" value="&lt;b&gt;FN-33&lt;/b&gt;&lt;br&gt;Registrar un grupo: un pasaje por integrante, en unidades propias, sin asientos asignados." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1509.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-41" value="&lt;b&gt;NU-21&lt;/b&gt;&lt;br&gt;Registrar un grupo con un pasaje por persona y su documento, el precio acordado y sus unidades." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#DAE8FC;strokeColor=#3465A4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1582.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-42" value="&lt;b&gt;FN-34&lt;/b&gt;&lt;br&gt;Generar el reporte anual de los pasajes del año antepasado y depurarlos." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1655.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-43" value="&lt;b&gt;NU-22&lt;/b&gt;&lt;br&gt;Un reporte anual de los pasajes, para dejar de guardar talonarios y conservar los incidentes." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#DAE8FC;strokeColor=#3465A4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="1728.5" width="350" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-44" value="&lt;b&gt;RN-30&lt;/b&gt; (Hecho)&lt;br&gt;Las salidas regulares son a las 6:00, 10:00, 13:00, 15:00 y 20:00 h, en ambos sentidos de la ruta." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="101" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-45" value="&lt;b&gt;RN-33&lt;/b&gt; (Restricción)&lt;br&gt;Una reserva se puede hacer con un máximo de siete días de anticipación." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="174" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-46" value="&lt;b&gt;RN-23&lt;/b&gt; (Hecho)&lt;br&gt;Todo pasajero tiene una hora de partida asignada desde el momento de la venta." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="247" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-47" value="&lt;b&gt;RN-24&lt;/b&gt; (Habilitador de acción)&lt;br&gt;La empresa puede adelantar un horario consultando antes a los pasajeros afectados." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="320" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-48" value="&lt;b&gt;RN-35&lt;/b&gt; (Restricción)&lt;br&gt;El cambio de fecha de un pasaje se debe avisar con al menos tres horas de anticipación a la salida." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="393" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-49" value="&lt;b&gt;RN-34&lt;/b&gt; (Restricción)&lt;br&gt;La anulación de una reserva se debe avisar con al menos tres horas de anticipación a la salida." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="466" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-50" value="&lt;b&gt;RN-28&lt;/b&gt; (Restricción)&lt;br&gt;Todo pasajero que no se presente a la hora indicada pierde su pasaje." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="539" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-51" value="&lt;b&gt;RN-29&lt;/b&gt; (Hecho)&lt;br&gt;Todo pasajero tiene derecho a 12 kg de equipaje." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="612" width="380" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-52" value="&lt;b&gt;RN-03&lt;/b&gt; (Habilitador de acción)&lt;br&gt;Un grupo —familiar o no— viaja en una o más unidades propias, sin pasajeros individuales ni asientos asignados, y sale de inmediato o a la hora que acuerda con la agencia." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="670" width="380" height="78" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-53" value="&lt;b&gt;RN-13&lt;/b&gt; (Restricción)&lt;br&gt;Todo cobro por Yape ingresa a la cuenta de la propietaria, sin importar quién lo registró." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="886.75" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-54" value="&lt;b&gt;RN-50&lt;/b&gt; (Restricción)&lt;br&gt;Solo la propietaria fija o modifica el precio del pasaje." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="1164" width="380" height="48" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-55" value="&lt;b&gt;RN-31&lt;/b&gt; (Hecho)&lt;br&gt;En un mismo horario pueden salir varias unidades, según la demanda." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1050" y="1232.5" width="380" height="63" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-105" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Al centro, cada requisito funcional con su fuente (Tabla 73). A la izquierda, su origen en el análisis de negocio: objetivo de negocio (ON, verde), necesidad de usuario (NU, azul), funcionalidad (FN, amarillo), atributo de calidad (AC, morado) o término del glosario (gris); los códigos se explican en el Anexo C.1. A la derecha, las reglas de negocio de 2.4.1 (Tabla 11). Todas las flechas son relaciones «trace» del requisito hacia su origen o su regla. El origen de RF-30, RF-31 y RF-32 está en el análisis de negocio 0105 (FN-32 a FN-34 y NU-20 a NU-22)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1831.5" width="1390" height="100" as="geometry"/></mxCell><mxCell id="trazabilidad-rf-56" value="" style="endArrow=open;endSize=9;dashed=1;html=1;rounded=0;strokeColor=#B8860B;exitX=0;exitY=0.333;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="trazabilidad-rf-2" target="trazabilidad-rf-19"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trazabilidad-rf-57" value="" style="endArrow=open;endSize=9;dashed=1;html=1;rounded=0;strokeColor=#3465A4;exitX=0;exitY=0.667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.333;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="trazabilidad-rf-2" target="trazabilidad-rf-20"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trazabilidad-rf-58" value="" style="endArrow=open;endSize=9;dashed=1;html=1;rounded=0;strokeColor=#3465A4;exitX=0;exitY=0.333;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.667;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="trazabilidad-rf-4" target="trazabilidad-rf-20"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trazabilidad-rf-59" value="" style="endArrow=open;endSize=9;dashed=1;html=1;rounded=0;strokeColor=#3465A4;exitX=0;exitY=0.333;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="trazabilidad-rf-3" target="trazabilidad-rf-21"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trazabilidad-rf-60" value="" style="endArrow=open;endSize=9;dashed=1;html=1;rounded=0;strokeColor=#B8860B;exitX=0;exitY=0.667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="trazabilidad-rf-3" target="trazabilidad-rf-22"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="traza