-4" target="sec-cdu-21-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sec-cdu-22" name="Secuencia CDU-22"><mxGraphModel dx="2290" dy="1536" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2290" pageHeight="1536" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sec-cdu-22-1" value="Secuencia — CDU-22 Hacer la copia semanal de los datos" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="570" height="34" as="geometry"/></mxCell><mxCell id="sec-cdu-22-2" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="20" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-3" value="&lt;b&gt;Administrador&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-22-4" value="«boundary»&lt;br&gt;&lt;b&gt;IU-P02 Panel principal&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-5" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-6" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="20" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-7" value="&lt;b&gt;Programador de tareas de Supabase&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="635" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-22-8" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-9" value="«control»&lt;br&gt;&lt;b&gt;ServicioCopiaDeDatos&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-10" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioCopias&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-11" value="«entity»&lt;br&gt;&lt;b&gt;CopiaDeLaBase&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-12" value="«boundary»&lt;br&gt;&lt;b&gt;AlmacenEnGoogleDrive&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="160" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-13" value="«entity»&lt;br&gt;&lt;b&gt;CopiaDeRespaldo&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1850" y="110" width="160" height="1246" as="geometry"/></mxCell><mxCell id="sec-cdu-22-25" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1044" y="340" width="972" height="378" as="geometry"/></mxCell><mxCell id="sec-cdu-22-26" value="[pasaron 7 días o más]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1090" y="364" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-22-27" value="[faltan días]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1090" y="624" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-22-28" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1044" y="614" width="972" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-22-43" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="810" width="1372" height="496" as="geometry"/></mxCell><mxCell id="sec-cdu-22-44" value="[A2: el Administrador abre el panel principal]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="834" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-22-45" value="&lt;b&gt;Web API.&lt;/b&gt; El programador de tareas de Supabase (Supabase Cron, con pg_net) envía el pedido con su propia clave, sin sesión; si Render tenía la Web API apagada, la despierta. Al iniciar, la Web API también revisa si toca la copia, por si el pedido del domingo no llegó (A1). CopiaDeLaBase lee todas las tablas en una sola transacción y cifra la copia con la clave que está en la configuración de Render; AlmacenEnGoogleDrive la sube con el permiso de Google Drive de la empresa.&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. El pedido del domingo no llegó o la copia no terminó: la Web API la hace la próxima vez que se despierta, cuando alguien abre el sistema.&lt;br&gt;A2. La copia falla: se anota el fallo y se vuelve a intentar en el próximo despertar. Si falla dos veces seguidas, el panel principal del Administrador muestra un aviso informativo, sin botones, hasta que una copia se guarde bien (RES-01).&lt;br&gt;A3. Hay que restaurar una copia: lo hace el equipo de soporte, fuera de la aplicación, en no más de dos días (RNF-17)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-22-14" value="1: POST /copia-de-datos/semanal, el domingo a las 3:00" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.069;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.069;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-22-6" target="sec-cdu-22-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-22-15" value="2: HacerCopiaSiCorrespondeAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0979;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0979;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-22-8" target="sec-cdu-22-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-22-16" value="3: BuscarUltimaAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1268;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1268;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-22-9" target="sec-cdu-22-10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-22-17" value="última copia correcta, o ninguna" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1557;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1557;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-22-10" target="sec-cdu-22-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-22-18" value="4: ExportarAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2327;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2327;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-22-9" target="sec-cdu-22-11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-