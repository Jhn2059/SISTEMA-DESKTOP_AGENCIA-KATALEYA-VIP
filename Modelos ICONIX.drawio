du-22-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-22-26" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-22-14" target="rob-cdu-22-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-22-27" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-22-4" target="rob-cdu-22-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-22-28" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-22-10" target="rob-cdu-22-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-22-29" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="rob-cdu-22-10" target="rob-cdu-22-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rob-cdu-22-1" value="Robustez — CDU-22 Hacer la copia semanal de los datos" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="560" height="34" as="geometry"/></mxCell><mxCell id="rob-cdu-22-2" value="Interfaz del programador de tareas" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-22-3" value="Interfaz de Google Drive" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="430" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-22-4" value="IU-P02 Panel principal" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="710" width="70" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-22-5" value="Revisar si toca la copia" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-22-6" value="Exportar y cifrar los datos" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-22-7" value="Subir la copia" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-22-8" value="Borrar las copias viejas" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="486" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-22-9" value="Anotar el resultado" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="598" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-22-10" value="Avisar que la copia falló" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=170;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="50" height="56" as="geometry"/></mxCell><mxCell id="rob-cdu-22-11" value="Copia de respaldo" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=150;labelBackgroundColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="486" width="50" height="50" as="geometry"/></mxCell><mxCell id="rob-cdu-22-12" value="Programador de tareas de Supabase" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-22-13" value="Google Drive de la empresa" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-22-14" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="700" width="36" height="70" as="geometry"/></mxCell><mxCell id="rob-cdu-22-30" value="&lt;b&gt;CDU-22 Hacer la copia semanal de los datos&lt;/b&gt;&lt;br&gt;Actor: Programador de tareas de Supabase · Secundarios: Google Drive de la empresa; Administrador, que recibe el aviso de A2&lt;br&gt;Requisitos: RNF-17 · Pantallas: IU-P02 (aviso de A2)&lt;br&gt;&lt;br&gt;&lt;b&gt;Curso básico&lt;/b&gt;&lt;br&gt;1. Cada domingo a las 3:00, el programador de tareas de Supabase envía un pedido a la Web API; si estaba apagada, Render la despierta.&lt;br&gt;2. La Web API revisa la fecha de la última copia correcta; si pasaron 7 días o más, hace la copia por detrás: lee todas las tablas en una sola transacción y cifra la copia.&lt;br&gt;3. La Web API sube la copia a la carpeta de Google Drive de la empresa, borra las que pasen de 8 y anota la fecha y el resultado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt;&lt;br&gt;A1. El pedido del domingo no llegó o la copia no terminó: la Web API la hace la próxima vez que se despierta, cuando alguien abre el sistema.&lt;br&gt;A2. La copia falla: se anota el fallo y se vuelve a intentar en el próximo despertar. Si falla dos veces seguidas, el panel principal del Administrador muestra un aviso informativo, sin botones, hasta que una copia se guarde bien (RES-01).&lt;br&gt;A3. Hay que restaurar una copia: lo hace el equipo de soporte, fuera de la aplicación, en no más de dos días (RNF-17)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="740" as="geometry"/></mxCell><mxCell id="rob-cdu-22-31" value="Fronteras" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-22-32" value="Controles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="548" y="84" width="120" height="20" as="geometry"/></mxCell><mxCell id="rob-cdu-22-33" value="Entidades" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="868" y="84" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sec-cdu-15" name="Secuencia CDU-15"><mxGraphModel dx="2290" dy="2162" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2290" pageHeight="2162" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sec-cdu-15-1" value="Secuencia — CDU-15 Iniciar sesión" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="356" height="34" as="geometry"/></mxCell><mxCell id="sec-cdu-15-2" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="20" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-3" value="&lt;b&gt;Encargado o Administrador&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-15-4" value="«boundary»&lt;br&gt;&lt;b&gt;IU-P01 Inicio de sesión&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-5" value="«entity»&lt;br&gt;&lt;b&gt;RegistroTecnico&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-6" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-7" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-8" value="«control»&lt;br&gt;&lt;b&gt;ServicioSesion&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-9" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioUsuarios&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-10" value="«entity»&lt;br&gt;&lt;b&gt;Usuario&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-11" value="«control»&lt;br&gt;&lt;b&gt;ServicioBitacora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-12" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioPreferencias&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1850" y="110" width="160" height="1872" as="geometry"/></mxCell><mxCell id="sec-cdu-15-45" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="844" y="678" width="1172" height="1068" as="geometry"/></mxCell><mxCell id="sec-cdu-15-46" value="[la cuenta no existe]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="702" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-15-47" value="[cuenta bloqueada]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="782" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-15-48" value="[sin bloqueo y contraseña incorrecta]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="934" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-15-49" value="[contraseña correcta y cuenta desactivada]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="1212" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-15-50" value="[contraseña correcta y cuenta activa]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="1364" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-15-51" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="844" y="772" width="1172" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-15-52" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="844" y="924" width="1172" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-15-53" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="844" y="1202" width="1172" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-15-54" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="844" y="1354" width="1172" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-15-59" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="322" width="1972" height="1610" as="geometry"/></mxCell><mxCell id="sec-cdu-15-60" value="[sin internet, o el servidor no responde en 10 segundos]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="346" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-15-61" value="[el servidor responde]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="498" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-15-62" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="488" width="1972" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-15-63" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. Usuario o contraseña vacíos: el sistema lo señala debajo del campo, sin consultar el servidor ni contar un intento.&lt;br&gt;A2. Usuario que no existe o contraseña incorrecta: el sistema niega el acceso con un mensaje que no revela cuál de los dos datos falló (SES-01); si la cuenta existe, cuenta el intento fallido.&lt;br&gt;A3. Quinto intento fallido consecutivo: el sistema bloquea la cuenta durante 3 minutos e indica hasta qué hora (SES-02); después la desbloquea solo, y un Administrador puede desbloquearla antes (CDU-18).&lt;br&gt;A4. Cuenta bloqueada: el sistema niega el acceso e indica hasta qué hora (SES-02), sin revisar la contraseña ni contar el intento.&lt;br&gt;A5. Cuenta desactivada: si la contraseña es correcta, el sistema indica que la cuenta está desactivada y que un Administrador puede reactivarla (SES-03, CDU-17); si no, responde como en A2.&lt;br&gt;A6. Sin conexión con el servidor: el sistema indica que no pudo comprobar los datos, distingue la falta de internet (CON-01) del servidor que no responde (CON-02), no cuenta el intento y anota el error en el registro técnico de la laptop.&lt;br&gt;A7. Bloq Mayús activado: mientras el usuario escribe la contraseña, el sistema lo advierte.&lt;br&gt;A8. Cambio de usuario: desde el panel, el usuario cierra su sesión y otro inicia la suya en no más de 15 segundos (RNF-08).&lt;br&gt;A9. La cuenta todavía no eligió un tema: el sistema sigue el tema de Windows, como en el inicio de sesión." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1992" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-15-13" value="1: escribir el usuario y la contraseña; pulsar «Ingresar»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0459;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0459;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-2" target="sec-cdu-15-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-14" value="revisar que no haya campos vacíos" style="html=1;align=left;spacingLeft=4;endArrow=block;endSize=8;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0652;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0791;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-4" target="sec-cdu-15-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="48" y="0" as="offset"/><Array as="points"><mxPoint x="370" y="232"/><mxPoint x="370" y="258"/></Array></mxGeometry></mxCell><mxCell id="sec-cdu-15-15" value="2: IniciarSesionAsync(nombreUsuario, contrasena)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.094;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.094;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-4" target="sec-cdu-15-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-16" value="3: RegistrarAsync(error)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1453;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1453;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-6" target="sec-cdu-15-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-17" value="rechazo: SinInternet o ServidorNoResponde" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1645;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1645;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-6" target="sec-cdu-15-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-18" value="4: mostrar CON-01 o CON-02" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1838;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1838;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-4" target="sec-cdu-15-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-19" value="5: POST /sesiones" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2265;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2265;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-6" target="sec-cdu-15-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-20" value="6: IniciarSesionAsync(nombreUsuario, contrasena)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2457;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2457;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-7" target="sec-cdu-15-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-21" value="7: BuscarPorNombreUsuarioAsync(nombreUsuario)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.265;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.265;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-8" target="sec-cdu-15-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-22" value="cuenta, o ninguna" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2842;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2842;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-9" target="sec-cdu-15-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-23" value="rechazo: DatosIncorrectos" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.3355;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.3355;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-8" target="sec-cdu-15-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-24" value="8: EstaBloqueada(ahora)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.3782;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.3782;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-8" target="sec-cdu-15-10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-15-25" value="sí" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.3974;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.3974;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-15-10" target="sec-cdu-15-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="