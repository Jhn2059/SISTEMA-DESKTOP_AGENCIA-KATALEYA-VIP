&gt;&lt;br&gt;.NET MAUI para Windows: navegación, IDialogos e impresión del boleto (ServicioImpresion)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="300" height="96" as="geometry"/></mxCell><mxCell id="componentes-8" value="«componente»&lt;br&gt;&lt;b&gt;Cliente de la Web API&lt;/b&gt;&lt;br&gt;ClienteApi (Kataleya.Cliente): una operación por ruta, llave de la sesión, clave de operación y errores de conexión" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="490" y="390" width="300" height="110" as="geometry"/></mxCell><mxCell id="componentes-9" value="«componente»&lt;br&gt;&lt;b&gt;Copia local&lt;/b&gt;&lt;br&gt;Pasajes del día, solo lectura (RNF-16)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="910" y="390" width="300" height="80" as="geometry"/></mxCell><mxCell id="componentes-10" value="«componente»&lt;br&gt;&lt;b&gt;Impresión&lt;/b&gt;&lt;br&gt;AdaptadorImpresora (ESC/POS)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="550" width="300" height="80" as="geometry"/></mxCell><mxCell id="componentes-11" value="«componente»&lt;br&gt;&lt;b&gt;Respaldo&lt;/b&gt;&lt;br&gt;ServicioRespaldo: deja el reporte anual en la carpeta de Google Drive" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="490" y="550" width="300" height="86" as="geometry"/></mxCell><mxCell id="componentes-12" value="«componente»&lt;br&gt;&lt;b&gt;Registro técnico&lt;/b&gt;&lt;br&gt;Errores en un archivo de la laptop, sin datos personales (IC-02)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="910" y="550" width="300" height="86" as="geometry"/></mxCell><mxCell id="componentes-13" value="«componente»&lt;br&gt;&lt;b&gt;Web API&lt;/b&gt;&lt;br&gt;Kataleya.Api: rutas HTTPS con JSON; comprueba la llave y la clave de operación y responde con Kataleya.Contratos" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="240" width="380" height="96" as="geometry"/></mxCell><mxCell id="componentes-14" value="«componente»&lt;br&gt;&lt;b&gt;Servicios de aplicación&lt;/b&gt;&lt;br&gt;Un control por grupo de casos de uso: ServicioReservasYVentas, ServicioBoletos…" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="390" width="380" height="96" as="geometry"/></mxCell><mxCell id="componentes-15" value="«componente»&lt;br&gt;&lt;b&gt;Dominio&lt;/b&gt;&lt;br&gt;Entidades, objetos de valor, solicitudes, filtros, enumeraciones e interfaces" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="550" width="380" height="96" as="geometry"/></mxCell><mxCell id="componentes-16" value="«componente»&lt;br&gt;&lt;b&gt;Acceso a datos&lt;/b&gt;&lt;br&gt;Repositorios de PostgreSQL con Npgsql, UnidadDeTrabajo, CopiaDeLaBase y AlmacenEnGoogleDrive (copia semanal)" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="680" width="380" height="96" as="geometry"/></mxCell><mxCell id="componentes-17" value="«dispositivo»&lt;br&gt;&lt;b&gt;Impresora de etiquetas&lt;/b&gt;&lt;br&gt;GOOJPRT JP-58B, 58 mm; USB o Bluetooth" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="840" width="300" height="86" as="geometry"/></mxCell><mxCell id="componentes-18" value="«externo»&lt;br&gt;&lt;b&gt;Google Drive de la empresa&lt;/b&gt;&lt;br&gt;Copia semanal (8 copias) y reporte anual" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="490" y="840" width="300" height="86" as="geometry"/></mxCell><mxCell id="componentes-19" value="«externo»&lt;br&gt;&lt;b&gt;Base de datos PostgreSQL&lt;/b&gt;&lt;br&gt;Supabase, región São Paulo; su programador de tareas despierta la Web API el domingo" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="840" width="380" height="96" as="geometry"/></mxCell><mxCell id="componentes-20" value="«dispositivo»&lt;br&gt;&lt;b&gt;Aplicación móvil Android&lt;/b&gt;&lt;br&gt;Más adelante, aparte: .NET MAUI con la misma Web API" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="1320" y="70" width="380" height="86" as="geometry"/></mxCell><mxCell id="componentes-39" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Desde el 18/10/2026 el sistema tiene dos partes: la aplicación de escritorio, en la laptop, y la Web API, en un servidor de Render. Solo la Web API se conecta a la base de datos, y sus credenciales no están en la laptop (RNF-20). La laptop conserva lo que es suyo: la impresora, la copia local, el registro técnico y la carpeta de Google Drive del reporte anual. Desde el 27/10/2026 la copia semanal la hace la Web API, despertada por el programador de tareas de Supabase, y la sube al Google Drive de la empresa (CDU-22). Respeta RE-06: C# sobre .NET 10, interfaz en XAML con .NET MAUI (19/10/2026) y PostgreSQL. Kataleya.Contratos, la biblioteca con las respuestas de la API, está en el diagrama de paquetes. Impresora de etiquetas: GOOJPRT JP-58B, de 58 mm (CF-02, 20/10/2026). Pendiente: el costo del servidor, que se consulta a la clienta." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1800" height="80" as="geometry"/></mxCell><mxCell id="componentes-21" value="aloja" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="componentes-7" target="componentes-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-30" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="componentes-22" value="abre diálogos e imprime" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="componentes-6" target="componentes-7"><mxGeometry x="0" rela