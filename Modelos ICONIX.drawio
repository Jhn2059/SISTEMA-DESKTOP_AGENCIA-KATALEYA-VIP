;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="611" height="34" as="geometry"/></mxCell><mxCell id="sec-cdu-19-2" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="20" height="766" as="geometry"/></mxCell><mxCell id="sec-cdu-19-3" value="&lt;b&gt;Administrador&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-19-4" value="«boundary»&lt;br&gt;&lt;b&gt;IU-P10 Configuración&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="766" as="geometry"/></mxCell><mxCell id="sec-cdu-19-5" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="766" as="geometry"/></mxCell><mxCell id="sec-cdu-19-6" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="766" as="geometry"/></mxCell><mxCell id="sec-cdu-19-7" value="«control»&lt;br&gt;&lt;b&gt;ServicioCuentas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="766" as="geometry"/></mxCell><mxCell id="sec-cdu-19-8" value="«entity»&lt;br&gt;&lt;b&gt;Usuario&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="766" as="geometry"/></mxCell><mxCell id="sec-cdu-19-9" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioUsuarios&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="766" as="geometry"/></mxCell><mxCell id="sec-cdu-19-10" value="«control»&lt;br&gt;&lt;b&gt;ServicioBitacora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="766" as="geometry"/></mxCell><mxCell id="sec-cdu-19-25" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="322" width="1572" height="504" as="geometry"/></mxCell><mxCell id="sec-cdu-19-26" value="[8 o más caracteres]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="346" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-19-27" value="[menos de 8 caracteres]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="750" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-19-28" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="740" width="1572" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-19-29" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. Contraseña de menos de 8 caracteres: el sistema no la guarda y muestra el error debajo del campo.&lt;br&gt;A2. El Administrador cierra el diálogo sin confirmar: no cambia nada." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-19-11" value="1: elegir una cuenta y pulsar «Restablecer contraseña»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1123;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1123;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-2" target="sec-cdu-19-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-12" value="abrir el diálogo con el campo de la contraseña nueva" style="html=1;align=left;spacingLeft=4;endArrow=block;endSize=8;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1593;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1932;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-4" target="sec-cdu-19-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="48" y="0" as="offset"/><Array as="points"><mxPoint x="370" y="232"/><mxPoint x="370" y="258"/></Array></mxGeometry></mxCell><mxCell id="sec-cdu-19-13" value="2: escribir la contraseña nueva y confirmar" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2298;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2298;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-2" target="sec-cdu-19-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-14" value="3: RestablecerContrasenaAsync(idCuenta, contrasenaNueva)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.3551;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.3551;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-4" target="sec-cdu-19-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-15" value="4: PUT /cuentas/{id}/contrasena" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.4021;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.4021;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-5" target="sec-cdu-19-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-16" value="5: RestablecerContrasenaAsync(usuario, contrasenaNueva)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.4491;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.4491;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-6" target="sec-cdu-19-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-17" value="6: FijarContrasena(contrasenaNueva)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.4961;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.4961;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-7" target="sec-cdu-19-8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-18" value="7: ActualizarAsync(usuario)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5431;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5431;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-7" target="sec-cdu-19-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-19" value="8: RegistrarAsync(restablecimientoDeContrasena)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5901;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5901;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-7" target="sec-cdu-19-10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-20" value="contraseña restablecida" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.6371;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.6371;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-7" target="sec-cdu-19-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-21" value="sin contenido" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.6841;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.6841;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-6" target="sec-cdu-19-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-22" value="contraseña restablecida" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.7311;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.7311;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-5" target="sec-cdu-19-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-23" value="9: recordar que debe entregarla al usuario" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.7781;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.7781;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-4" target="sec-cdu-19-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-19-24" value="10: mostrar el error debajo del campo" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.8825;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.8825;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-19-4" target="sec-cdu-19-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sec-cdu-06" name="Secuencia CDU-06"><mxGraphModel dx="1890" dy="1778" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1890" pageHeight="1778" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sec-cdu-06-1" value="Secuencia — CDU-06 Fijar la tarifa vigente" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="448" height="34" as="geometry"/></mxCell><mxCell id="sec-cdu-06-2" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="20" height="1488" as="geometry"/></mxCell><mxCell id="sec-cdu-06-3" value="&lt;b&gt;Administrador&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-06-4" value="«boundary»&lt;br&gt;&lt;b&gt;IU-P10 Configuración&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1488" as="geometry"/></mxCell><mxCell id="sec-cdu-06-5" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1488" as="geometry"/></mxCell><mxCell id="sec-cdu-06-6" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1488" as="geometry"/></mxCell><mxCell id="sec-cdu-06-7" value="«control»&lt;br&gt;&lt;b&gt;ServicioTarifas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1488" as="geometry"/></mxCell><mxCell id="sec-cdu-06-8" value="«entity»&lt;br&gt;&lt;b&gt;Tarifa&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1488" as="geometry"/></mxCell><mxCell id="sec-cdu-06-9" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioTarifas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1488" as="geometry"/></mxCell><mxCell id="sec-cdu-06-10" value="«control»&lt;br&gt;&lt;b&gt;ServicioBitacora&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="160" height="1488" as="geometry"/></mxCell><mxCell id="sec-cdu-06-30" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="520" width="1172" height="468" as="geometry"/></mxCell><mxCell id="sec-cdu-06-31" value="[tarifa regular]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="544" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-06-32" value="[tarifa programada]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="768" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-06-33" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="758" width="1172" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-06-46" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="1080" width="1572" height="468" as="geometry"/></mxCell><mxCell id="sec-cdu-06-47" value="[tarifa válida]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="1104" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-06-48" value="[dato inválido]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="1364" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-06-49" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="1354" width="1572" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-06-50" value='&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. Editar o quitar una tarifa programada; antes de quitarla, el sistema pide confirmación (IU-05).&lt;br&gt;A2. Importe que no es mayor que cero, o fecha final anterior a la inicial: el sistema no guarda e indica el dato inválido.&lt;br&gt;A3. &lt;span style="background-color:#FFF2A8;"&gt;Las fechas se cruzan con las de otra tarifa programada del mismo sentido: el sistema no la guarda e indica con cuál se cruza (propuesta por validar, PA-73; SDD, Anexo E.3).&lt;/span&gt;' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1608" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-06-11" value="1: abrir la pestaña «Tarifas y parámetros»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0578;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0578;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-06-2" target="sec-cdu-06-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-06-12" value="2: ObtenerTarifasAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.082;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.082;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-06-4" target="sec-cdu-06-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-06-13" value="3: GET /tarifas" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1062;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1062;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-06-5" target="sec-cdu-06-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-06-14" value="4: ListarTarifasAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1304;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1304;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-06-6" target="sec-cdu-06-7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-06-15" value="5: ListarAsync()" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1546;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1546;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-06-7" target="sec-cdu-06-9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-06-16" value="tarifas" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1788;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1788;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-06-7" target="sec-cdu-06-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-06