/span&gt;&lt;br&gt;ServicioCopiaDeDatos' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2154" y="1052" width="803" height="128" as="geometry"/></mxCell><mxCell id="clases-servicios-55" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-54"><mxGeometry x="0" y="40" width="803" height="24" as="geometry"/></mxCell><mxCell id="clases-servicios-56" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="clases-servicios-54"><mxGeometry x="0" y="64" width="803" height="8" as="geometry"/></mxCell><mxCell id="clases-servicios-57" value="+ «create» ServicioCopiaDeDatos(copia: ICopiaDeLaBase, almacen: IAlmacenDeCopias, copias: IRepositorioCopias, reloj: IReloj)&lt;br&gt;+ HacerCopiaSiCorrespondeAsync(): Task&lt;br&gt;+ ObtenerEstadoAsync(): Task&amp;lt;EstadoDelRespaldo&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-54"><mxGeometry x="0" y="72" width="803" height="56" as="geometry"/></mxCell><mxCell id="clases-servicios-58" value='&lt;span style="font-weight:normal;"&gt;«control»&lt;/span&gt;&lt;br&gt;ServicioCatalogos' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3764" y="1052" width="412" height="128" as="geometry"/></mxCell><mxCell id="clases-servicios-59" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-58"><mxGeometry x="0" y="40" width="412" height="24" as="geometry"/></mxCell><mxCell id="clases-servicios-60" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="clases-servicios-58"><mxGeometry x="0" y="64" width="412" height="8" as="geometry"/></mxCell><mxCell id="clases-servicios-61" value="+ «create» ServicioCatalogos(catalogos: IRepositorioCatalogos)&lt;br&gt;+ ListarRolesAsync(): Task&amp;lt;List&amp;lt;Rol&amp;gt;&amp;gt;&lt;br&gt;+ ListarSedesAsync(): Task&amp;lt;List&amp;lt;Sede&amp;gt;&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-58"><mxGeometry x="0" y="72" width="412" height="56" as="geometry"/></mxCell><mxCell id="clases-servicios-62" value='&lt;span style="font-weight:normal;"&gt;«control»&lt;/span&gt;&lt;br&gt;ServicioConsultas' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="698.5" y="1248" width="406" height="144" as="geometry"/></mxCell><mxCell id="clases-servicios-63" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-62"><mxGeometry x="0" y="40" width="406" height="24" as="geometry"/></mxCell><mxCell id="clases-servicios-64" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="clases-servicios-62"><mxGeometry x="0" y="64" width="406" height="8" as="geometry"/></mxCell><mxCell id="clases-servicios-65" value="+ «create» ServicioConsultas(pasajes: IRepositorioPasajes)&lt;br&gt;+ ConsultarAsync(filtro: FiltroDePasajes): Task&amp;lt;List&amp;lt;Pasaje&amp;gt;&amp;gt;&lt;br&gt;+ ObtenerDetalleAsync(idPasaje: long): Task&amp;lt;Pasaje&amp;gt;&lt;br&gt;+ ContarPasajesDelHorarioAsync(hora: TimeOnly): Task&amp;lt;int&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-62"><mxGeometry x="0" y="72" width="406" height="72" as="geometry"/></mxCell><mxCell id="clases-servicios-72" value="&lt;b&gt;En la laptop&lt;/b&gt; (Kataleya.Escritorio y Kataleya.Cliente): los servicios de arriba corren en el servidor, detrás de la Web API" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1462" width="1100" height="24" as="geometry"/></mxCell><mxCell id="clases-servicios-73" value='&lt;span style="font-weight:normal;"&gt;«control»&lt;/span&gt;&lt;br&gt;ServicioImpresion' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1502" width="715" height="208" as="geometry"/></mxCell><mxCell id="clases-servicios-74" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-73"><mxGeometry x="0" y="40" width="715" height="24" as="geometry"/></mxCell><mxCell id="clases-servicios-75" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="clases-servicios-73"><mxGeometry x="0" y="64" width="715" height="8" as="geometry"/></mxCell><mxCell id="clases-servicios-76" value="+ «create» ServicioImpresion(impresora: IImpresora, clienteApi: ClienteApi, registroTecnico: IRegistroTecnico)&lt;br&gt;+ ImprimirBoletoAsync(pasaje: DatosDePasaje): Task&amp;lt;EstadoImpresora&amp;gt;&lt;br&gt;+ ImprimirBoletosAsync(pasajes: List&amp;lt;DatosDePasaje&amp;gt;): Task&amp;lt;EstadoImpresora&amp;gt;&lt;br&gt;+ ReimprimirAsync(pasaje: DatosDePasaje): Task&amp;lt;EstadoImpresora&amp;gt;&lt;br&gt;+ ListarImpresorasAsync(): Task&amp;lt;List&amp;lt;string&amp;gt;&amp;gt;&lt;br&gt;+ ObtenerConfiguracionAsync(): Task&amp;lt;ConfiguracionDeImpresora&amp;gt;&lt;br&gt;+ GuardarConfiguracionAsync(configuracion: ConfiguracionDeImpresora): Task&lt;br&gt;+ ImprimirPruebaAsync(): Task&amp;lt;EstadoImpresora&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-73"><mxGeometry x="0" y="72" width="715" height="136" as="geometry"/></mxCell><mxCell id="clases-servicios-77" value='&lt;span style="font-weight:normal;"&gt;«boundary»&lt;/span&gt;&lt;br&gt;ClienteApi' style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875" y="1502" width="796" height="832" as="geometry"/></mxCell><mxCell id="clases-servicios-78" value="+ CuentaActual: DatosDeCuenta?&lt;br&gt;+ /SesionActiva: bool&lt;br&gt;+ /EsAdministrador: bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-77"><mxGeometry x="0" y="40" width="796" height="56" as="geometry"/></mxCell><mxCell id="clases-servicios-79" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="clases-servicios-77"><mxGeometry x="0" y="96" width="796" height="8" as="geometry"/></mxCell><mxCell id="clases-servicios-80" value="+ «create» ClienteApi(http: HttpClient, registroTecnico: IRegistroTecnico, copiaLocal: ICopiaLocal, reintentosMaximos: int)&lt;br&gt;+ CerrarSesion(): void&lt;br&gt;+ IniciarSesionAsync(nombreUsuario: string, contrasena: string): Task&amp;lt;ResultadoDeInicioDeSesion&amp;gt;&lt;br&gt;+ ObtenerTarifaVigenteAsync(fecha: DateOnly, sentido: Sentido): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDeTarifa&amp;gt;&amp;gt;&lt;br&gt;+ FijarTarifaRegularAsync(sentido: Sentido, importe: decimal): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ ObtenerTiposDeVehiculoAsync(): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDeTipoDeVehiculo&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ GuardarTarifaAsync(solicitud: SolicitudDeTarifa): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDeTarifa&amp;gt;&amp;gt;&lt;br&gt;+ QuitarTarifaAsync(idTarifa: int): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ GuardarParametroAsync(nombre: string, valor: string): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ AgregarHorarioAsync(hora: TimeOnly): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ QuitarHorarioAsync(hora: TimeOnly): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ ContarPasajesDelHorarioAsync(hora: TimeOnly): Task&amp;lt;ResultadoDeLaApi&amp;lt;int&amp;gt;&amp;gt;&lt;br&gt;+ ObtenerTarifasAsync(): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDeTarifa&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ ObtenerParametrosAsync(): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDeParametro&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ ElegirTemaAsync(tema: Tema): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ ObtenerAsientosAsync(salida: Salida): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDeUnidad&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ AbrirUnidadAsync(salida: Salida, tipoDeVehiculo: string): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDeUnidad&amp;gt;&amp;gt;&lt;br&gt;+ RegistrarReservaAsync(solicitud: SolicitudDePasaje): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&lt;br&gt;+ RegistrarVentaAsync(solicitud: SolicitudDePasaje): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&lt;br&gt;+ RegistrarGrupoAsync(solicitud: SolicitudDeGrupo): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDeGrupo&amp;gt;&amp;gt;&lt;br&gt;+ RegistrarDiferidoAsync(solicitud: SolicitudDePasaje): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&lt;br&gt;+ RevisarModificacionAsync(idPasaje: long, cambios: CambiosDelPasaje): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;string&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ ModificarAsync(idPasaje: long, cambios: CambiosDelPasaje): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&lt;br&gt;+ RevisarAnulacionAsync(idPasaje: long): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;string&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ AnularAsync(idPasaje: long, motivo: string): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&lt;br&gt;+ MarcarNoSePresentoAsync(idPasaje: long): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&lt;br&gt;+ ConsultarPasajesAsync(filtro: FiltroDePasajes): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ ObtenerDetalleAsync(idPasaje: long): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&lt;br&gt;+ RegistrarCobroDelSaldoAsync(idPasaje: long, pago: DatosDePago): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDePasaje&amp;gt;&amp;gt;&lt;br&gt;+ RegistrarReimpresionAsync(boleto: DatosDeBoleto): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ RegistrarFallaDeImpresionAsync(boleto: DatosDeBoleto, estado: EstadoImpresora): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ GenerarCuadreAsync(periodo: Periodo): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDelCuadre&amp;gt;&amp;gt;&lt;br&gt;+ CrearCuentaAsync(solicitud: SolicitudDeCuenta): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDeCuenta&amp;gt;&amp;gt;&lt;br&gt;+ DesactivarAsync(idCuenta: int): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ ReactivarAsync(idCuenta: int): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ DesbloquearAsync(idCuenta: int): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ RestablecerContrasenaAsync(idCuenta: int, contrasenaNueva: string): Task&amp;lt;ResultadoDeLaApi&amp;gt;&lt;br&gt;+ ObtenerCuentasAsync(): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDeCuenta&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ ObtenerRolesAsync(): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDeRol&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ ObtenerSedesAsync(): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDeSede&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ ConsultarBitacoraAsync(filtro: FiltroDeBitacora): Task&amp;lt;ResultadoDeLaApi&amp;lt;List&amp;lt;DatosDeBitacora&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;+ HayReportePendienteAsync(): Task&amp;lt;ResultadoDeLaApi&amp;lt;bool&amp;gt;&amp;gt;&lt;br&gt;+ DescargarReporteAnualAsync(anio: int, contrasenaPdf: string): Task&amp;lt;ResultadoDeLaApi&amp;lt;ArchivoProtegido&amp;gt;&amp;gt;&lt;br&gt;+ PedirDepuracionAsync(anio: int, rutaPdf: string): Task&amp;lt;ResultadoDeLaApi&amp;lt;DatosDelReporteAnual&amp;gt;&amp;gt;&lt;br&gt;+ ObtenerEstadoDeLaCopiaAsync(): Task&amp;lt;ResultadoDeLaApi&amp;lt;EstadoDelRespaldo&amp;gt;&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clases-servicios-77"><mxGeometry x="0" y="104" width="796" height="728" as="geometry"/></mxCell><mxCell id="clases-servicios-82" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;Cada servicio de aplicación es el control de uno o más casos de uso; sus operaciones salen de los diagramas de secuencia. Las flechas punteadas son dependencias («usa»); las que van a los repositorios y adaptadores están en el diagrama de interfaces. Todos los servicios que registran o cambian datos usan además ServicioBitacora (RF-24), y esas flechas no se dibujan. Desde el 18/10/2026 la Web API (Kataleya.Api) llama a estos servicios: ServicioBoletos numera y registra el boleto, y ServicioImpresion, en la laptop, lo imprime; ClienteApi tiene una operación por ruta de la Web API y devuelve un ResultadoDeLaApi, sin lanzar excepciones (19/10/2026). Todas las operaciones son asíncronas: terminan en «Async» y devuelven Task o Task&amp;lt;T&amp;gt;; quien las llama espera el resultado con await. Los servicios que registran algo guardan sus cambios y su anotación en la bitácora en una sola transacción (IUnidadDeTrabajo); la secuencia de CDU-09 lo muestra y las demás no lo repiten. El emisor, el cobrador o el autor que piden los constructores es el usuario de ContextoDeOperacion (21/10/2026)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2374" width="1100" height="150" as="geometry"/></mxCell><mxCell id="clases-servicios-66" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="clases-servicios-2" target="clases-servicios-14"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="clases-servicios-67" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="clases-servicios-2" target="clases-servicios-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="clases-servicios-68" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="clases-servicios-2" target="clases-servicios-18"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="clases-servicios-69" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="clases-servicios-26" target="clases-servicios-18"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="clases-servicios-70" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="clases-servicios-22" t