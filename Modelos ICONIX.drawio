rimeter=0;" edge="1" parent="1" source="sec-cdu-12-6" target="sec-cdu-12-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-12-52" value="24: mostrar el aviso verde" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.899;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.899;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-12-4" target="sec-cdu-12-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-12-53" value="25: mostrar RES-02; no se elimina ningún pasaje" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.9466;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.9466;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-12-4" target="sec-cdu-12-2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sec-cdu-20" name="Secuencia CDU-20"><mxGraphModel dx="1690" dy="1310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1690" pageHeight="1310" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sec-cdu-20-1" value="Secuencia — CDU-20 Elegir el tema" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="356" height="34" as="geometry"/></mxCell><mxCell id="sec-cdu-20-2" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="20" height="1020" as="geometry"/></mxCell><mxCell id="sec-cdu-20-3" value="&lt;b&gt;Encargado o Administrador&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="74" width="190" height="32" as="geometry"/></mxCell><mxCell id="sec-cdu-20-4" value="«boundary»&lt;br&gt;&lt;b&gt;Barra superior&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="160" height="1020" as="geometry"/></mxCell><mxCell id="sec-cdu-20-5" value="«boundary»&lt;br&gt;&lt;b&gt;ClienteApi&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="1020" as="geometry"/></mxCell><mxCell id="sec-cdu-20-6" value="«boundary»&lt;br&gt;&lt;b&gt;Kataleya.Api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="160" height="1020" as="geometry"/></mxCell><mxCell id="sec-cdu-20-7" value="«control»&lt;br&gt;&lt;b&gt;ServicioCuentas&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="160" height="1020" as="geometry"/></mxCell><mxCell id="sec-cdu-20-8" value="«entity»&lt;br&gt;&lt;b&gt;RepositorioPreferencias&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="160" height="1020" as="geometry"/></mxCell><mxCell id="sec-cdu-20-9" value="«entity»&lt;br&gt;&lt;b&gt;Preferencias&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="160" height="1020" as="geometry"/></mxCell><mxCell id="sec-cdu-20-20" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="844" y="520" width="572" height="180" as="geometry"/></mxCell><mxCell id="sec-cdu-20-21" value="[la cuenta ya eligió un tema]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="544" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-20-22" value="[todavía no eligió ninguno]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="890" y="624" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-20-23" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="844" y="614" width="572" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-20-30" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="244" y="864" width="172" height="216" as="geometry"/></mxCell><mxCell id="sec-cdu-20-31" value="[tema guardado]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="290" y="888" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-20-32" value="[sin conexión]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="290" y="986" width="460" height="20" as="geometry"/></mxCell><mxCell id="sec-cdu-20-33" value="" style="line;strokeWidth=1;dashed=1;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="244" y="976" width="172" height="6" as="geometry"/></mxCell><mxCell id="sec-cdu-20-34" value="&lt;b&gt;Web API.&lt;/b&gt; La pantalla es la página XAML con su modelo de vista. ClienteApi agrega a cada pedido la llave de la sesión y, si registra algo, la cabecera Idempotency-Key con la clave de operación, que repite si el usuario reintenta; Kataleya.Api las comprueba, llena ContextoDeOperacion (la clave y el usuario de la sesión, que es el emisor, el cobrador o el autor que piden los constructores) y llama al servicio. Si rechaza el pedido, responde con ProblemDetails. ClienteApi devuelve un ResultadoDeLaApi; sin conexión, con el código CON-01 o CON-02 (en el inicio de sesión, SinInternet o ServidorNoResponde).&lt;br&gt;&lt;b&gt;Cursos alternos&lt;/b&gt; (el texto completo del caso de uso está en su página de robustez)&lt;br&gt;A1. La cuenta todavía no eligió un tema: el sistema sigue el de Windows, y el botón pasa al otro.&lt;br&gt;A2. Sin conexión con el servidor: el sistema aplica el tema en esta sesión y lo guarda en la cuenta la próxima vez que se cambie." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1560" height="150" as="geometry"/></mxCell><mxCell id="sec-cdu-20-10" value="1: pulsar el botón del tema" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0843;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0843;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-20-2" target="sec-cdu-20-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-20-11" value="desactivar el botón y mostrar «Cambiando el tema…»" style="html=1;align=left;spacingLeft=4;endArrow=block;endSize=8;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1196;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1451;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-20-4" target="sec-cdu-20-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="48" y="0" as="offset"/><Array as="points"><mxPoint x="370" y="232"/><mxPoint x="370" y="258"/></Array></mxGeometry></mxCell><mxCell id="sec-cdu-20-12" value="aplicar el otro tema en toda la ventana" style="html=1;align=left;spacingLeft=4;endArrow=block;endSize=8;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.1725;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.198;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-20-4" target="sec-cdu-20-4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="48" y="0" as="offset"/><Array as="points"><mxPoint x="370" y="286"/><mxPoint x="370" y="312"/></Array></mxGeometry></mxCell><mxCell id="sec-cdu-20-13" value="2: ElegirTemaAsync(tema)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2255;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2255;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-20-4" target="sec-cdu-20-5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="sec-cdu-20-14" value="3: PUT /cuentas/{id}/tema" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.2608;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.2608;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sec-cdu-20-5" target="sec-cdu-20-6"><mxG