<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Kataleya.Escritorio.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Texto">#1F2937</Color>
            <Color x:Key="TextoSuave">#4B5563</Color>
            <Color x:Key="Error">#B91C1C</Color>
            <Color x:Key="Exito">#15803D</Color>
            <Color x:Key="Borde">#D1D5DB</Color>
            <Color x:Key="Superficie">#F9FAFB</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="HeightRequest" Value="36" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
