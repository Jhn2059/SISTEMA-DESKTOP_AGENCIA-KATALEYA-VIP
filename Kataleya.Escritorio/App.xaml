<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Kataleya.Escritorio.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Kataleya.Escritorio.UIHelpers.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Iconos.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:TextoNoVacioABoolConverter x:Key="TextoNoVacio" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
