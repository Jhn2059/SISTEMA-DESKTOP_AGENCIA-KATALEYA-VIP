<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource Fondo}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource Texto}" />
    </Style>

    <Style x:Key="TituloDePagina" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{DynamicResource Texto}" />
    </Style>

    <Style x:Key="SubtituloDePagina" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource TextoSuave}" />
    </Style>

    <Style x:Key="TituloDeSeccion" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource Texto}" />
    </Style>

    <Style x:Key="EtiquetaDeCampo" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource TextoSuave}" />
    </Style>

    <Style x:Key="TextoDeError" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource PeligroTexto}" />
    </Style>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Superficie}" />
        <Setter Property="Stroke" Value="{DynamicResource Borde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="TarjetaCompacta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Superficie}" />
        <Setter Property="Stroke" Value="{DynamicResource Borde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="13" />
    </Style>

    <Style x:Key="CampoDeFormulario" TargetType="Border">
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Superficie}" />
        <Setter Property="Stroke" Value="{DynamicResource BordeControl}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
    </Style>

    <Style x:Key="CampoSoloLectura" TargetType="Border">
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CampoSoloLectura}" />
        <Setter Property="Stroke" Value="{DynamicResource Borde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Texto}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextoTenue}" />
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Texto}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextoTenue}" />
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource BotonOscuro}" />
        <Setter Property="TextColor" Value="{DynamicResource Texto}" />
        <Setter Property="BorderColor" Value="{DynamicResource BordeControl}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="EstiloBotonClaro" TargetType="Button">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource BotonClaro}" />
        <Setter Property="TextColor" Value="{DynamicResource BotonClaroTexto}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource EstiloBotonClaro}" />

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource BotonOscuro}" />
        <Setter Property="TextColor" Value="{DynamicResource Texto}" />
        <Setter Property="BorderColor" Value="{DynamicResource BordeControl}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource BotonOscuro}" />
        <Setter Property="TextColor" Value="{DynamicResource PeligroTexto}" />
        <Setter Property="BorderColor" Value="{DynamicResource Peligro}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="BotonDeshabilitado" TargetType="Button">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource TextoSuave}" />
    </Style>

    <Style TargetType="Path">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource TextoSuave}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Aspect" Value="Uniform" />
    </Style>
</ResourceDictionary>
