<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Kataleya.Escritorio.Components.Layout.BarraSuperior"
    x:Name="RaizBarra"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="58">
    <Grid
        BackgroundColor="{DynamicResource Superficie}"
        ColumnDefinitions="Auto,*,Auto"
        Padding="12,0,0,0">

        <Border
            x:Name="BotonMenu"
            WidthRequest="40"
            HeightRequest="40"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 6"
            VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="AlTocarMenu" />
                <PointerGestureRecognizer PointerEntered="AlEntrarMenu" PointerExited="AlSalirMenu" />
            </Border.GestureRecognizers>
            <Path
                Data="{StaticResource IconoMenu}"
                WidthRequest="20"
                HeightRequest="20"
                Aspect="Uniform"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <Grid
            x:Name="ZonaArrastre"
            Grid.Column="1"
            BackgroundColor="{DynamicResource Superficie}">
            <Label
                Text="Sistema de la Agencia Kataleya VIP"
                FontFamily="InterSemiBold"
                FontSize="14"
                TextColor="{DynamicResource Texto}"
                VerticalOptions="Center"
                LineBreakMode="TailTruncation"
                MaxLines="1" />
        </Grid>

        <HorizontalStackLayout
            Grid.Column="2"
            Spacing="10"
            VerticalOptions="Center">

        <HorizontalStackLayout
            x:Name="AvisoCambiandoTema"
            Spacing="6"
            IsVisible="False"
            VerticalOptions="Center">
            <ActivityIndicator
                IsRunning="True"
                WidthRequest="16"
                HeightRequest="16"
                Color="{DynamicResource TextoSuave}"
                VerticalOptions="Center" />
            <Label
                Text="Cambiando el tema…"
                FontSize="13"
                TextColor="{DynamicResource TextoSuave}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Border
            x:Name="BotonTema"
            WidthRequest="40"
            HeightRequest="40"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 6"
            AutomationProperties.Name="Cambiar tema"
            VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="AlTocarTema" />
                <PointerGestureRecognizer PointerEntered="AlEntrarTema" PointerExited="AlSalirTema" />
            </Border.GestureRecognizers>
            <Path
                x:Name="IconoTema"
                Data="{StaticResource IconoLuna}"
                WidthRequest="20"
                HeightRequest="20"
                Aspect="Uniform"
                Stroke="{DynamicResource Texto}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <Border
            x:Name="BloqueUsuario"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            Padding="8,0"
            VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="AlTocarUsuario" />
                <PointerGestureRecognizer PointerEntered="AlEntrarUsuario" PointerExited="AlSalirUsuario" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Border
                    WidthRequest="26"
                    HeightRequest="26"
                    StrokeThickness="0"
                    BackgroundColor="{DynamicResource SuperficieActiva}"
                    StrokeShape="RoundRectangle 13"
                    VerticalOptions="Center">
                    <Path
                        Data="{StaticResource IconoPersona}"
                        WidthRequest="16"
                        HeightRequest="16"
                        Aspect="Uniform"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label
                        x:Name="LblNombre"
                        FontFamily="InterSemiBold"
                        FontSize="13"
                        TextColor="{DynamicResource Texto}"
                        LineHeight="1" />
                    <Label
                        x:Name="LblRol"
                        FontSize="11"
                        TextColor="{DynamicResource TextoSuave}"
                        LineHeight="1" />
                    <Label
                        x:Name="LblSede"
                        FontSize="11"
                        TextColor="{DynamicResource TextoSuave}"
                        LineHeight="1" />
                </VerticalStackLayout>
                <Path
                    Data="{StaticResource IconoChevron}"
                    WidthRequest="14"
                    HeightRequest="14"
                    Aspect="Uniform"
                    Margin="4,0,0,0"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <Border
            x:Name="BotonMinimizar"
            WidthRequest="46"
            HeightRequest="58"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            AutomationProperties.Name="Minimizar"
            VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="AlTocarMinimizar" />
                <PointerGestureRecognizer PointerEntered="AlEntrarControl" PointerExited="AlSalirControl" />
            </Border.GestureRecognizers>
            <Path
                x:Name="IconoMinimizar"
                Data="{StaticResource IconoMinimizar}"
                WidthRequest="12"
                HeightRequest="12"
                Aspect="Uniform"
                Stroke="{DynamicResource Texto}"
                StrokeThickness="1.2"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <Border
            x:Name="BotonMaximizar"
            WidthRequest="46"
            HeightRequest="58"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            AutomationProperties.Name="Maximizar"
            VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="AlTocarMaximizar" />
                <PointerGestureRecognizer PointerEntered="AlEntrarControl" PointerExited="AlSalirControl" />
            </Border.GestureRecognizers>
            <Path
                x:Name="IconoMaximizar"
                Data="{StaticResource IconoMaximizar}"
                WidthRequest="12"
                HeightRequest="12"
                Aspect="Uniform"
                Stroke="{DynamicResource Texto}"
                StrokeThickness="1.2"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <Border
            x:Name="BotonCerrar"
            WidthRequest="46"
            HeightRequest="58"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            AutomationProperties.Name="Cerrar"
            VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="AlTocarCerrar" />
                <PointerGestureRecognizer PointerEntered="AlEntrarCerrar" PointerExited="AlSalirCerrar" />
            </Border.GestureRecognizers>
            <Path
                x:Name="IconoCerrar"
                Data="{StaticResource IconoCerrar}"
                WidthRequest="12"
                HeightRequest="12"
                Aspect="Uniform"
                Stroke="{DynamicResource Texto}"
                StrokeThickness="1.2"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>
        </HorizontalStackLayout>
    </Grid>
</ContentView>
