<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Kataleya.Escritorio.Components.Common.CampoDeTexto"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:common="clr-namespace:Kataleya.Escritorio.Components.Common"
    x:Name="Raiz"
    x:DataType="common:CampoDeTexto">
    <VerticalStackLayout Spacing="6">
        <Label
            Text="{Binding Etiqueta, Source={x:Reference Raiz}}"
            Style="{StaticResource EtiquetaDeCampo}" />

        <Border
            x:Name="Caja"
            HeightRequest="36"
            Padding="0"
            BackgroundColor="{StaticResource Superficie}"
            Stroke="{StaticResource BordeControl}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 6">
            <Border.GestureRecognizers>
                <PointerGestureRecognizer
                    PointerEntered="AlEntrarPuntero"
                    PointerExited="AlSalirPuntero" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="38,*,30" ColumnSpacing="0">
                <Path
                    Grid.Column="0"
                    WidthRequest="18"
                    HeightRequest="18"
                    Margin="12,0,0,0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Data="{Binding Icono, Source={x:Reference Raiz}}"
                    Stroke="{StaticResource TextoSuave}"
                    StrokeThickness="1.75"
                    Aspect="Uniform" />

                <Entry
                    x:Name="Entrada"
                    Grid.Column="1"
                    HeightRequest="34"
                    VerticalOptions="Center"
                    VerticalTextAlignment="Center"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Texto}"
                    PlaceholderColor="{StaticResource TextoTenue}"
                    FontFamily="InterRegular"
                    FontSize="14"
                    Margin="0"
                    ClearButtonVisibility="Never"
                    Text="{Binding Texto, Source={x:Reference Raiz}, Mode=TwoWay}"
                    Placeholder="{Binding Placeholder, Source={x:Reference Raiz}}"
                    MaxLength="{Binding LongitudMaxima, Source={x:Reference Raiz}}"
                    ReturnType="{Binding TipoDeRetorno, Source={x:Reference Raiz}}"
                    Focused="AlEnfocarEntrada"
                    Unfocused="AlDesenfocarEntrada"
                    Completed="AlCompletarEntrada" />

                <Grid
                    x:Name="BotonOjo"
                    Grid.Column="2"
                    WidthRequest="24"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding EsContrasena, Source={x:Reference Raiz}}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AlAlternarContrasena" />
                    </Grid.GestureRecognizers>
                    <Path
                        x:Name="OjoAbierto"
                        WidthRequest="18"
                        HeightRequest="18"
                        Data="{StaticResource IconoOjo}"
                        Stroke="{StaticResource TextoSuave}"
                        StrokeThickness="1.75"
                        Aspect="Uniform" />
                    <Path
                        x:Name="OjoCerrado"
                        WidthRequest="18"
                        HeightRequest="18"
                        Data="{StaticResource IconoOjoCerrado}"
                        Stroke="{StaticResource TextoSuave}"
                        StrokeThickness="1.75"
                        Aspect="Uniform"
                        IsVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <Grid
            x:Name="FilaDeError"
            ColumnDefinitions="14,*"
            ColumnSpacing="6"
            IsVisible="False">
            <Path
                Grid.Column="0"
                WidthRequest="14"
                HeightRequest="14"
                Margin="0,0.5,0,0"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Data="{StaticResource IconoAlerta}"
                Stroke="{StaticResource Peligro}"
                StrokeThickness="1.75"
                Aspect="Uniform" />
            <Label
                x:Name="EtiquetaDeError"
                Grid.Column="1"
                Style="{StaticResource TextoDeError}"
                LineHeight="1.25"
                LineBreakMode="WordWrap" />
        </Grid>

        <common:IndicadorBloqMayus
            x:Name="AvisoBloqMayus"
            IsVisible="{Binding MuestraAvisoBloqMayus, Source={x:Reference Raiz}}" />
    </VerticalStackLayout>
</ContentView>
