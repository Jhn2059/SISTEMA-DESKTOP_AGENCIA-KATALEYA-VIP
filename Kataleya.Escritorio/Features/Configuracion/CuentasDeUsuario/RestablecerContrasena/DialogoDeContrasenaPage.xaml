<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Kataleya.Escritorio.Features.Configuracion.CuentasDeUsuario.RestablecerContrasena.DialogoDeContrasenaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:common="clr-namespace:Kataleya.Escritorio.Components.Common"
    xmlns:ui="clr-namespace:Kataleya.Escritorio.UIHelpers.Behaviors"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.Configuracion.CuentasDeUsuario.RestablecerContrasena"
    x:DataType="vm:DialogoDeContrasenaViewModel"
    ui:CicloDeVidaDePagina.AlDesaparecer="{Binding AlDesaparecerCommand}"
    Title="Restablecer contraseña"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Fondo}">
    <Border
        Style="{StaticResource Tarjeta}"
        WidthRequest="460"
        Padding="24"
        HorizontalOptions="Center"
        VerticalOptions="Center">
        <VerticalStackLayout Spacing="14">
            <HorizontalStackLayout Spacing="12">
                <Border
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{DynamicResource InfoFondo}">
                    <Path
                        Data="{StaticResource IconoLlave}"
                        WidthRequest="22"
                        HeightRequest="22"
                        Aspect="Uniform"
                        Stroke="{DynamicResource Info}"
                        StrokeThickness="1.75"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Text="Restablecer contraseña"
                    FontFamily="InterSemiBold"
                    FontSize="16"
                    TextColor="{DynamicResource Texto}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding NombreUsuario, StringFormat='Cuenta: {0}'}" FontSize="14" TextColor="{DynamicResource TextoSuave}" />

            <common:CampoDeTexto
                Etiqueta="Contraseña nueva *"
                Placeholder="Mínimo 8 caracteres"
                Icono="{StaticResource IconoCandado}"
                EsContrasena="True"
                Texto="{Binding Contrasena}"
                MensajeDeError="{Binding ErrorContrasena}"
                ComandoAlCompletar="{Binding AceptarCommand}" />

            <Label Text="Mínimo 8 caracteres. Entregue la contraseña nueva al usuario." FontSize="12" TextColor="{DynamicResource TextoSuave}" />

            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CancelarCommand}" />
                <Button Text="Restablecer" Style="{StaticResource BotonPrimario}" Command="{Binding AceptarCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentPage>
