<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Kataleya.Escritorio.Features.Configuracion.CuentasDeUsuario.CrearCuenta.DialogoDeCuentaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contratos="clr-namespace:Kataleya.Contratos.Cuentas;assembly=Kataleya.Contratos"
    xmlns:common="clr-namespace:Kataleya.Escritorio.Components.Common"
    xmlns:ui="clr-namespace:Kataleya.Escritorio.UIHelpers.Behaviors"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.Configuracion.CuentasDeUsuario.CrearCuenta"
    x:DataType="vm:DialogoDeCuentaViewModel"
    ui:CicloDeVidaDePagina.AlDesaparecer="{Binding AlDesaparecerCommand}"
    Title="Crear cuenta"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Fondo}">
    <Border
        Style="{StaticResource Tarjeta}"
        WidthRequest="560"
        Padding="24"
        HorizontalOptions="Center"
        VerticalOptions="Center">
        <VerticalStackLayout Spacing="14">
            <HorizontalStackLayout Spacing="12">
                <Border
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{DynamicResource InfoFondo}">
                    <Path
                        Data="{StaticResource IconoPersonaMas}"
                        WidthRequest="22"
                        HeightRequest="22"
                        Aspect="Uniform"
                        Stroke="{DynamicResource Info}"
                        StrokeThickness="1.75"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Text="Crear cuenta"
                    FontFamily="InterSemiBold"
                    FontSize="16"
                    TextColor="{DynamicResource Texto}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <common:CampoDeTexto
                Etiqueta="Nombre de la persona *"
                Placeholder="Nombre y apellidos"
                LongitudMaxima="100"
                Texto="{Binding Nombre}"
                MensajeDeError="{Binding ErrorNombre}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <common:CampoDeTexto
                    Etiqueta="Nombre de usuario *"
                    Placeholder="ventas02"
                    LongitudMaxima="30"
                    Texto="{Binding NombreUsuario}"
                    MensajeDeError="{Binding ErrorNombreUsuario}" />
                <common:CampoDeTexto
                    Grid.Column="1"
                    Etiqueta="Contraseña inicial *"
                    Placeholder="Mínimo 8 caracteres"
                    Icono="{StaticResource IconoCandado}"
                    EsContrasena="True"
                    Texto="{Binding Contrasena}"
                    MensajeDeError="{Binding ErrorContrasena}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Rol *" Style="{StaticResource EtiquetaDeCampo}" />
                    <Border Style="{StaticResource CampoDeFormulario}">
                        <Picker
                            ItemsSource="{Binding Roles}"
                            SelectedItem="{Binding RolSeleccionado, Mode=TwoWay}"
                            ItemDisplayBinding="{Binding Nombre, x:DataType=contratos:DatosDeRol}" />
                    </Border>
                    <Label Text="{Binding ErrorRol}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorRol, Converter={StaticResource TextoNoVacio}}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Sede *" Style="{StaticResource EtiquetaDeCampo}" />
                    <Border Style="{StaticResource CampoDeFormulario}">
                        <Picker
                            ItemsSource="{Binding Sedes}"
                            SelectedItem="{Binding SedeSeleccionada, Mode=TwoWay}"
                            ItemDisplayBinding="{Binding Nombre, x:DataType=contratos:DatosDeSede}" />
                    </Border>
                    <Label Text="{Binding ErrorSede}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorSede, Converter={StaticResource TextoNoVacio}}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="{Binding ErrorGeneral}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorGeneral, Converter={StaticResource TextoNoVacio}}" />

            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CancelarCommand}" />
                <Button Text="Crear cuenta" Style="{StaticResource BotonPrimario}" Command="{Binding CrearCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentPage>
