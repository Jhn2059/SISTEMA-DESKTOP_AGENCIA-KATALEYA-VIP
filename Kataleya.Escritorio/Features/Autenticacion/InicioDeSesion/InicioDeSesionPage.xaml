<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Kataleya.Escritorio.Features.Autenticacion.InicioDeSesion.InicioDeSesionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:common="clr-namespace:Kataleya.Escritorio.Components.Common"
    xmlns:ui="clr-namespace:Kataleya.Escritorio.UIHelpers.Behaviors"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.Autenticacion.InicioDeSesion"
    x:DataType="vm:InicioDeSesionViewModel"
    ui:CicloDeVidaDePagina.AlAparecer="{Binding LimpiarCommand}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="32" RowDefinitions="*,Auto,*">
            <VerticalStackLayout
                Grid.Row="1"
                WidthRequest="420"
                HorizontalOptions="Center"
                Spacing="10">
                <Label
                    Text="Kataleya"
                    FontSize="34"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
                <Label
                    Text="Agencia de viajes"
                    TextColor="{StaticResource TextoSuave}"
                    HorizontalOptions="Center" />
                <Label
                    Text="Iniciar sesión"
                    FontSize="22"
                    FontAttributes="Bold"
                    Margin="0,18,0,6" />

                <Label Text="Usuario" />
                <Entry
                    Text="{Binding NombreUsuario}"
                    Placeholder="Escriba su usuario"
                    MaxLength="30"
                    ReturnType="Next" />
                <Label
                    Text="{Binding ErrorNombreUsuario}"
                    TextColor="{StaticResource Error}"
                    FontSize="12"
                    IsVisible="{Binding ErrorNombreUsuario, Converter={StaticResource TextoNoVacio}}" />

                <Label Text="Contraseña" />
                <Entry
                    Text="{Binding Contrasena}"
                    Placeholder="Escriba su contraseña"
                    IsPassword="True"
                    ReturnType="Done" />
                <Label
                    Text="{Binding ErrorContrasena}"
                    TextColor="{StaticResource Error}"
                    FontSize="12"
                    IsVisible="{Binding ErrorContrasena, Converter={StaticResource TextoNoVacio}}" />
                <common:IndicadorBloqMayus />

                <Button
                    Text="Ingresar"
                    Command="{Binding IngresarCommand}"
                    IsEnabled="{Binding PuedeIngresar}"
                    Margin="0,10,0,0" />

                <ActivityIndicator
                    IsRunning="{Binding EstaCargando}"
                    IsVisible="{Binding EstaCargando}"
                    HorizontalOptions="Center" />

                <Label
                    Text="{Binding MensajeDeError}"
                    TextColor="{StaticResource Error}"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding MensajeDeError, Converter={StaticResource TextoNoVacio}}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
