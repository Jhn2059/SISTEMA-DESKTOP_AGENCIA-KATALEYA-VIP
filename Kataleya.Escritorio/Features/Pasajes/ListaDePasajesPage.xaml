<?xml version="1.0" encoding="UTF-8" ?>
<paginas:PaginaDeModulo
    x:Class="Kataleya.Escritorio.Features.Pasajes.ListaDePasajesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:paginas="clr-namespace:Kataleya.Escritorio.UIHelpers.Paginas"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.Pasajes"
    x:DataType="vm:ListaDePasajesViewModel">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24,16,24,24" Spacing="0">

            <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                <Label Text="Lista de pasajes" Style="{StaticResource TituloDePagina}" VerticalOptions="Center" />
                <Label Text="Pasajes registrados" Style="{StaticResource SubtituloDePagina}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource Tarjeta}" Padding="14,10" Margin="0,12,0,0">
                <Grid ColumnDefinitions="140,140,120,120,120,*,140,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Desde" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <DatePicker Date="{Binding Desde}" Format="dd/MM/yyyy" />
                        </Border>
                        <Label Text="{Binding ErrorDeFechas}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorDeFechas, Converter={StaticResource TextoNoVacio}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hasta" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <DatePicker Date="{Binding Hasta}" Format="dd/MM/yyyy" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Horario" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <Picker ItemsSource="{Binding Horarios}" SelectedIndex="{Binding HorarioElegido}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="4">
                        <Label Text="Estado" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <Picker ItemsSource="{Binding Estados}" SelectedIndex="{Binding EstadoElegido}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="4" Spacing="4">
                        <Label Text="Tipo de pasaje" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <Picker ItemsSource="{Binding Tipos}" SelectedIndex="{Binding TipoElegido}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="5" Spacing="4">
                        <Label Text="Pasajero (nombre o documento)" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <Entry Text="{Binding Pasajero}" Placeholder="Nombre o documento" ReturnCommand="{Binding BuscarCommand}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="6" Spacing="4">
                        <Label Text="Emisor" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <Picker ItemsSource="{Binding Emisores}" SelectedIndex="{Binding EmisorElegido}" />
                        </Border>
                    </VerticalStackLayout>
                    <Border Grid.Column="7" HeightRequest="36" Padding="16,0" BackgroundColor="{DynamicResource BotonClaro}" StrokeThickness="0" StrokeShape="RoundRectangle 6" VerticalOptions="Start" Margin="0,22,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BuscarCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Path Data="{StaticResource IconoLupa}" WidthRequest="17" HeightRequest="17" Stroke="{DynamicResource BotonClaroTexto}" VerticalOptions="Center" />
                            <Label Text="Buscar" FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource BotonClaroTexto}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <Border IsVisible="{Binding AvisoDeCopiaLocal, Converter={StaticResource TextoNoVacio}}" Margin="0,12,0,0" Padding="12,10" BackgroundColor="{DynamicResource AdvertenciaFondo}" Stroke="{DynamicResource AdvertenciaBorde}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <HorizontalStackLayout Spacing="8">
                    <Path Data="{StaticResource IconoAlerta}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource AdvertenciaTexto}" VerticalOptions="Center" />
                    <Label Text="{Binding AvisoDeCopiaLocal}" FontSize="13" TextColor="{DynamicResource AdvertenciaTexto}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="0">
                    <Grid HeightRequest="40" Padding="12,0" BackgroundColor="{DynamicResource EncabezadoTabla}" ColumnDefinitions="100,140,110,100,110,80,70,90,90,80,170,*" ColumnSpacing="0">
                        <Label Text="Salida" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="Pasajero" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="Documento" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="Destino" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="Embarque" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="Asiento" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="6" Text="Grupo" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="7" Text="Importe" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                        <Label Grid.Column="8" Text="Pagado" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                        <Label Grid.Column="9" Text="Saldo" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                        <Label Grid.Column="10" Text="Estado" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="11" Text="Emisor" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource Borde}" />

                    <CollectionView ItemsSource="{Binding Filas}" SelectionMode="Single" SelectedItem="{Binding FilaElegida}">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HeightRequest="150" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,26,0,0">
                                <Path Data="{StaticResource IconoLupa}" WidthRequest="28" HeightRequest="28" Stroke="{DynamicResource TextoTenue}" HorizontalOptions="Center" />
                                <Label Text="No hay pasajes con esos filtros." FontSize="14" TextColor="{DynamicResource TextoSuave}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilaDePasaje">
                                <Grid HeightRequest="38" Padding="12,0" ColumnDefinitions="100,140,110,100,110,80,70,90,90,80,170,*" ColumnSpacing="0">
                                    <Label Text="{Binding Salida}" FontSize="13" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="{Binding Pasaje.PasajeroNombre}" FontSize="13" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="{Binding Pasaje.NumeroDocumento}" FontSize="13" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="{Binding Pasaje.Destino}" FontSize="13" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="{Binding Pasaje.LugarDeEmbarque}" FontSize="13" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="5" Text="{Binding Asiento}" FontSize="13" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="6" Text="{Binding Grupo}" FontSize="13" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="7" Text="{Binding Importe}" FontSize="13" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="8" Text="{Binding Pagado}" FontSize="13" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="9" Text="{Binding Saldo}" FontSize="13" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Border Grid.Column="10" Margin="10,0,0,0" Padding="10,2" HorizontalOptions="Start" VerticalOptions="Center" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="{Binding FondoDelEstado}">
                                        <Label Text="{Binding Estado}" FontSize="12" FontFamily="InterMedium" TextColor="{Binding TextoDelEstado}" />
                                    </Border>
                                    <Label Grid.Column="11" Text="{Binding Pasaje.Emisor}" FontSize="13" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                <Button Text="Abrir detalle" Style="{StaticResource BotonSecundario}" Command="{Binding AbrirDetalleCommand}" />
                <Button Text="Copiar datos para otro pasajero" Style="{StaticResource BotonSecundario}" Command="{Binding CopiarDatosCommand}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="7" Margin="0,12,0,0">
                <Path Data="{StaticResource IconoInfo}" WidthRequest="14" HeightRequest="14" Stroke="{DynamicResource TextoTenue}" VerticalOptions="Center" />
                <Label Text="Pulse una fila para abrir su detalle. En un grupo, el precio y los pagos figuran en la fila del responsable." FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</paginas:PaginaDeModulo>
