<?xml version="1.0" encoding="UTF-8" ?>
<paginas:PaginaDeModulo
    x:Class="Kataleya.Escritorio.Features.Pasajes.DetalleDePasajePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:paginas="clr-namespace:Kataleya.Escritorio.UIHelpers.Paginas"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.Pasajes"
    x:DataType="vm:DetalleDePasajeViewModel">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24,16,24,24" Spacing="0">

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <Label Text="Detalle del pasaje" Style="{StaticResource TituloDePagina}" VerticalOptions="Center" />
                <Border Grid.Column="1" HeightRequest="24" Padding="10,0" BackgroundColor="{Binding FondoDelEstado}" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                    <Label Text="{Binding Estado}" FontFamily="InterMedium" FontSize="12" TextColor="{Binding TextoDelEstado}" VerticalOptions="Center" />
                </Border>
                <Button Grid.Column="3" Text="←  Volver a la lista" Style="{StaticResource BotonSecundario}" Command="{Binding VolverCommand}" />
            </Grid>

            <Border Style="{StaticResource Tarjeta}" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Pasajero y viaje" FontFamily="InterSemiBold" FontSize="15" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Pasajero" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}">
                                <Label Text="{Binding Pasajero}" FontSize="14" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Documento" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}">
                                <Label Text="{Binding Documento}" FontSize="14" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="5">
                            <Label Text="Teléfono" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}">
                                <Label Text="{Binding Telefono}" FontSize="14" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="5">
                            <Label Text="N.º de boleto" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}">
                                <Label Text="{Binding Boleto}" FontSize="14" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="2*,1.2*,1.2*,0.9*,1.6*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Salida" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}"><Label Text="{Binding Salida}" FontSize="14" VerticalOptions="Center" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Unidad y asiento" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}"><Label Text="{Binding UnidadYAsiento}" FontSize="14" VerticalOptions="Center" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="5">
                            <Label Text="Lugar de embarque" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}"><Label Text="{Binding Embarque}" FontSize="14" VerticalOptions="Center" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="5">
                            <Label Text="Grupo" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}"><Label Text="{Binding Grupo}" FontSize="14" VerticalOptions="Center" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="4" Spacing="5">
                            <Label Text="Emisor" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}"><Label Text="{Binding Emisor}" FontSize="14" VerticalOptions="Center" /></Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,12,0,0">
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Path Data="{StaticResource IconoDinero}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="Pagos" FontFamily="InterSemiBold" FontSize="15" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border Style="{StaticResource TarjetaCompacta}" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Grid HeightRequest="36" Padding="10,0" BackgroundColor="{DynamicResource EncabezadoTabla}" ColumnDefinitions="1.4*,0.9*,0.9*,0.8*,1*">
                                    <Label Text="Fecha y hora" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="Tipo" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="Medio" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="Monto" FontFamily="InterSemiBold" FontSize="12" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="Cobró" FontFamily="InterSemiBold" FontSize="12" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="{DynamicResource Borde}" />
                                <CollectionView ItemsSource="{Binding Pagos}" HeightRequest="180">
                                    <CollectionView.EmptyView>
                                        <Label Text="Sin pagos registrados." FontSize="13" TextColor="{DynamicResource TextoSuave}" HorizontalTextAlignment="Center" Margin="0,18" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilaDePago">
                                            <Grid HeightRequest="34" Padding="10,0" ColumnDefinitions="1.4*,0.9*,0.9*,0.8*,1*">
                                                <Label Text="{Binding FechaHora}" FontSize="12" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding Tipo}" FontSize="12" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="2" Text="{Binding Medio}" FontSize="12" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="3" Text="{Binding Monto}" FontSize="12" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="4" Text="{Binding Cobro}" FontSize="12" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border Style="{StaticResource TarjetaCompacta}" Padding="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Importe" FontSize="12" TextColor="{DynamicResource TextoSuave}" />
                                    <Label Text="{Binding Importe}" FontFamily="InterBold" FontSize="18" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TarjetaCompacta}" Padding="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Pagado" FontSize="12" TextColor="{DynamicResource TextoSuave}" />
                                    <Label Text="{Binding Pagado}" FontFamily="InterBold" FontSize="18" TextColor="{DynamicResource Exito}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource TarjetaCompacta}" Padding="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Saldo" FontSize="12" TextColor="{DynamicResource TextoSuave}" />
                                    <Label Text="{Binding Saldo}" FontFamily="InterBold" FontSize="18" TextColor="{DynamicResource Advertencia}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Path Data="{StaticResource IconoConfiguracion}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="Acciones" FontFamily="InterSemiBold" FontSize="15" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Cobrar saldo" Style="{StaticResource BotonPrimario}" Command="{Binding CobrarCommand}" />
                            <Button Text="Modificar" Style="{StaticResource BotonSecundario}" Command="{Binding ModificarCommand}" IsVisible="{Binding EsAdministrador}" />
                            <Button Text="Cambiar asiento" Style="{StaticResource BotonSecundario}" Command="{Binding CambiarAsientoCommand}" IsVisible="{Binding EsAdministrador}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Imprimir boleto" Style="{StaticResource BotonSecundario}" Command="{Binding ImprimirCommand}" />
                            <Button Text="Reimprimir" Style="{StaticResource BotonSecundario}" Command="{Binding ReimprimirCommand}" />
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="{DynamicResource Borde}" IsVisible="{Binding EsAdministrador}" />
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding EsAdministrador}">
                            <Button Text="Anular" Style="{StaticResource BotonPeligro}" Command="{Binding AnularCommand}" />
                            <Button Text="Marcar «No se presentó»" Style="{StaticResource BotonSecundario}" Command="{Binding MarcarNoPresentadoCommand}" />
                        </HorizontalStackLayout>

                        <Label Text="{Binding Ayuda}" FontSize="12" TextColor="{DynamicResource TextoSuave}" LineHeight="1.2" />

                        <Border IsVisible="{Binding InfoDeLaSalida, Converter={StaticResource TextoNoVacio}}" Padding="10" BackgroundColor="{DynamicResource InfoFondo}" Stroke="{DynamicResource InfoBorde}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                <Path Data="{StaticResource IconoReloj}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource InfoTexto}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <Label Grid.Column="1" Text="{Binding InfoDeLaSalida}" FontFamily="InterMedium" FontSize="12" TextColor="{DynamicResource InfoTexto}" LineHeight="1.2" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</paginas:PaginaDeModulo>
