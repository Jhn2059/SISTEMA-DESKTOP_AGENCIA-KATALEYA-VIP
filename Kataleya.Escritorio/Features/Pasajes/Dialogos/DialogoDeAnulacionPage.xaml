<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Kataleya.Escritorio.Features.Pasajes.Dialogos.DialogoDeAnulacionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Kataleya.Escritorio.UIHelpers.Behaviors"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.Pasajes.Dialogos"
    x:DataType="vm:DialogoDeAnulacionViewModel"
    ui:CicloDeVidaDePagina.AlDesaparecer="{Binding AlDesaparecerCommand}"
    Title="Anular pasaje"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Fondo}">
    <Border
        Style="{StaticResource Tarjeta}"
        WidthRequest="460"
        Padding="24"
        HorizontalOptions="Center"
        VerticalOptions="Center">
        <VerticalStackLayout Spacing="14">
            <HorizontalStackLayout Spacing="12">
                <Border
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{DynamicResource AdvertenciaFondo}">
                    <Path
                        Data="{StaticResource IconoAlerta}"
                        WidthRequest="22"
                        HeightRequest="22"
                        Aspect="Uniform"
                        Stroke="{DynamicResource Advertencia}"
                        StrokeThickness="1.75"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Text="{Binding Titulo}"
                    FontFamily="InterSemiBold"
                    FontSize="16"
                    TextColor="{DynamicResource Texto}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="No se puede deshacer." FontSize="13" TextColor="{DynamicResource TextoSuave}" />

            <Border
                IsVisible="{Binding AvisoDeRetencion, Converter={StaticResource TextoNoVacio}}"
                Padding="12,10"
                BackgroundColor="{DynamicResource AdvertenciaFondo}"
                Stroke="{DynamicResource AdvertenciaBorde}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                    <Path Data="{StaticResource IconoAlerta}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource AdvertenciaTexto}" VerticalOptions="Start" />
                    <Label Grid.Column="1" Text="{Binding AvisoDeRetencion}" FontSize="13" TextColor="{DynamicResource AdvertenciaTexto}" LineBreakMode="WordWrap" />
                </Grid>
            </Border>

            <Label
                IsVisible="{Binding AvisoDeDevolucion, Converter={StaticResource TextoNoVacio}}"
                Text="{Binding AvisoDeDevolucion}"
                FontSize="13"
                TextColor="{DynamicResource Texto}" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Motivo de la anulación *" Style="{StaticResource EtiquetaDeCampo}" />
                <Border Style="{StaticResource CampoDeFormulario}">
                    <Entry Text="{Binding Motivo}" ReturnCommand="{Binding AceptarCommand}" />
                </Border>
                <Label
                    Text="{Binding ErrorMotivo}"
                    Style="{StaticResource TextoDeError}"
                    IsVisible="{Binding ErrorMotivo, Converter={StaticResource TextoNoVacio}}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding PuedeDevolverComoExcepcion}">
                <CheckBox IsChecked="{Binding DevolverComoExcepcion}" VerticalOptions="Center" />
                <Label Text="{Binding TextoDeLaExcepcion}" FontSize="13" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Button Text="No, volver" Style="{StaticResource BotonSecundario}" Command="{Binding CancelarCommand}" />
                <Button Text="Sí, anular" Style="{StaticResource BotonPeligro}" Command="{Binding AceptarCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentPage>
