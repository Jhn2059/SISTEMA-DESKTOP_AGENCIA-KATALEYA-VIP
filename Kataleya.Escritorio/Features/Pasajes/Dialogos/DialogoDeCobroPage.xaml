<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Kataleya.Escritorio.Features.Pasajes.Dialogos.DialogoDeCobroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Kataleya.Escritorio.UIHelpers.Behaviors"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.Pasajes.Dialogos"
    x:DataType="vm:DialogoDeCobroViewModel"
    ui:CicloDeVidaDePagina.AlDesaparecer="{Binding AlDesaparecerCommand}"
    Title="Cobrar saldo"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Fondo}">
    <Border
        Style="{StaticResource Tarjeta}"
        WidthRequest="460"
        Padding="24"
        HorizontalOptions="Center"
        VerticalOptions="Center">
        <VerticalStackLayout Spacing="16">
            <HorizontalStackLayout Spacing="12">
                <Border
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{DynamicResource InfoFondo}">
                    <Path
                        Data="{StaticResource IconoDinero}"
                        WidthRequest="22"
                        HeightRequest="22"
                        Aspect="Uniform"
                        Stroke="{DynamicResource Info}"
                        StrokeThickness="1.75"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Text="Cobrar saldo"
                    FontFamily="InterSemiBold"
                    FontSize="16"
                    TextColor="{DynamicResource Texto}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding Descripcion}" FontSize="13" TextColor="{DynamicResource TextoSuave}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Monto *" Style="{StaticResource EtiquetaDeCampo}" />
                    <Border Style="{StaticResource CampoDeFormulario}">
                        <Entry Text="{Binding Monto}" Keyboard="Numeric" ReturnCommand="{Binding AceptarCommand}" />
                    </Border>
                    <Label
                        Text="{Binding ErrorMonto}"
                        Style="{StaticResource TextoDeError}"
                        IsVisible="{Binding ErrorMonto, Converter={StaticResource TextoNoVacio}}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Medio de pago *" Style="{StaticResource EtiquetaDeCampo}" />
                    <Border Style="{StaticResource CampoDeFormulario}">
                        <Picker ItemsSource="{Binding Medios}" SelectedIndex="{Binding MedioElegido}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CancelarCommand}" />
                <Button Text="Registrar cobro" Style="{StaticResource BotonPrimario}" Command="{Binding AceptarCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentPage>
