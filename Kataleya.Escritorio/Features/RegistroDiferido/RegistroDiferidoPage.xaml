<?xml version="1.0" encoding="UTF-8" ?>
<paginas:PaginaDeModulo
    x:Class="Kataleya.Escritorio.Features.RegistroDiferido.RegistroDiferidoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:paginas="clr-namespace:Kataleya.Escritorio.UIHelpers.Paginas"
    xmlns:common="clr-namespace:Kataleya.Escritorio.Components.Common"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.RegistroDiferido"
    x:DataType="vm:RegistroDiferidoViewModel">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24,16,24,24" Spacing="0">

            <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                <Label Text="Registro diferido" Style="{StaticResource TituloDePagina}" VerticalOptions="Center" />
                <Label Text="Pasajes emitidos con talonario durante una contingencia" Style="{StaticResource SubtituloDePagina}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border
                IsVisible="{Binding MensajeDeExito, Converter={StaticResource TextoNoVacio}}"
                Margin="0,12,0,0"
                Padding="12,10"
                BackgroundColor="{DynamicResource ExitoFondo}"
                Stroke="{DynamicResource ExitoBorde}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8">
                <HorizontalStackLayout Spacing="8">
                    <Path Data="{StaticResource IconoCheckCirculo}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource Exito}" VerticalOptions="Center" />
                    <Label Text="{Binding MensajeDeExito}" FontSize="13" TextColor="{DynamicResource Exito}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Boleto del talonario" FontFamily="InterSemiBold" FontSize="15" />
                    <Grid ColumnDefinitions="220,420,*" ColumnSpacing="12">
                        <common:CampoDeTexto
                            Etiqueta="N.º de boleto del talonario *"
                            Placeholder="000123"
                            Texto="{Binding NumeroTalonario}"
                            MensajeDeError="{Binding ErrorTalonario}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Fecha y hora reales de emisión *" Style="{StaticResource EtiquetaDeCampo}" />
                            <Grid ColumnDefinitions="*,220" ColumnSpacing="8">
                                <Border Style="{StaticResource CampoDeFormulario}">
                                    <DatePicker Date="{Binding FechaDeEmision}" Format="dd/MM/yyyy" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CampoDeFormulario}">
                                    <TimePicker Time="{Binding HoraDeEmision}" Format="HH:mm" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding ErrorEmision}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorEmision, Converter={StaticResource TextoNoVacio}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Pasajero" FontFamily="InterSemiBold" FontSize="15" />
                    <Grid ColumnDefinitions="*,140,170,170" ColumnSpacing="12">
                        <common:CampoDeTexto
                            Etiqueta="Nombre *"
                            Placeholder="Nombre Apellido"
                            Texto="{Binding Nombre}"
                            MensajeDeError="{Binding ErrorNombre}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Documento *" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoDeFormulario}">
                                <Picker ItemsSource="{Binding TiposDeDocumento}" SelectedIndex="{Binding TipoDeDocumento}" />
                            </Border>
                        </VerticalStackLayout>
                        <common:CampoDeTexto
                            Grid.Column="2"
                            Etiqueta="N.º de documento *"
                            Placeholder="12345678"
                            Texto="{Binding NumeroDocumento}"
                            MensajeDeError="{Binding ErrorDocumento}" />
                        <common:CampoDeTexto
                            Grid.Column="3"
                            Etiqueta="Teléfono *"
                            Placeholder="9XX XXX XXX"
                            Teclado="Telephone"
                            Texto="{Binding Telefono}"
                            MensajeDeError="{Binding ErrorTelefono}" />
                    </Grid>

                    <Label Text="Viaje" FontFamily="InterSemiBold" FontSize="15" />
                    <Grid ColumnDefinitions="*,300,*,*" ColumnSpacing="12">
                        <common:CampoDeTexto
                            Etiqueta="Destino *"
                            Placeholder="Ica"
                            Texto="{Binding Destino}"
                            MensajeDeError="{Binding ErrorDestino}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Salida *" Style="{StaticResource EtiquetaDeCampo}" />
                            <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                                <Border Style="{StaticResource CampoDeFormulario}">
                                    <DatePicker Date="{Binding FechaSalida}" Format="dd/MM/yyyy" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CampoDeFormulario}">
                                    <Picker ItemsSource="{Binding Horarios}" SelectedIndex="{Binding HorarioElegido}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                        <common:CampoDeTexto
                            Grid.Column="2"
                            Etiqueta="Lugar de embarque *"
                            Placeholder="Agencia"
                            Texto="{Binding LugarDeEmbarque}"
                            MensajeDeError="{Binding ErrorEmbarque}" />
                        <VerticalStackLayout Grid.Column="3" Spacing="6">
                            <Label Text="Unidad y asiento *" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoDeFormulario}">
                                <Picker ItemsSource="{Binding Lugares}" SelectedIndex="{Binding LugarElegido}" />
                            </Border>
                            <Label Text="{Binding ErrorAsiento}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorAsiento, Converter={StaticResource TextoNoVacio}}" />
                            <Button Text="+  Abrir otra unidad" Style="{StaticResource BotonSecundario}" FontSize="12" HorizontalOptions="Start" Command="{Binding AbrirUnidadCommand}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Cobro" FontFamily="InterSemiBold" FontSize="15" />
                    <Grid ColumnDefinitions="200,200,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Importe" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoSoloLectura}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Importe}" FontSize="14" VerticalOptions="Center" />
                                    <Path Grid.Column="1" Data="{StaticResource IconoCandado}" WidthRequest="15" HeightRequest="15" Stroke="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Medio de pago" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoDeFormulario}">
                                <Picker ItemsSource="{Binding Medios}" SelectedIndex="{Binding MedioElegido}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Border Padding="12" BackgroundColor="{DynamicResource InfoFondo}" Stroke="{DynamicResource InfoBorde}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="18,*" ColumnSpacing="10">
                            <Path Data="{StaticResource IconoInfo}" WidthRequest="18" HeightRequest="18" Stroke="{DynamicResource InfoTexto}" VerticalOptions="Start" Margin="0,1,0,0" />
                            <Label Grid.Column="1" Text="El pasaje queda marcado como «registro diferido» y no se imprime boleto: el pasajero ya tiene el del talonario. El número de boleto no puede repetirse y la fecha de emisión no puede ser posterior al momento del registro." FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource InfoTexto}" LineHeight="1.23" />
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Registrar pasaje diferido" Style="{StaticResource BotonPrimario}" Command="{Binding RegistrarCommand}" />
                        <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CancelarCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</paginas:PaginaDeModulo>
