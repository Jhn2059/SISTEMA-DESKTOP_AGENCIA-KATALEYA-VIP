<?xml version="1.0" encoding="UTF-8" ?>
<paginas:PaginaDeModulo
    x:Class="Kataleya.Escritorio.Features.RegistroDePasajes.RegistroDePasajesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:paginas="clr-namespace:Kataleya.Escritorio.UIHelpers.Paginas"
    xmlns:common="clr-namespace:Kataleya.Escritorio.Components.Common"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.RegistroDePasajes"
    x:Name="PaginaActiva"
    x:DataType="vm:RegistroDePasajesViewModel">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24,16,24,24" Spacing="0">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <Label Text="Registro de pasaje" Style="{StaticResource TituloDePagina}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Label Text="Tipo de pasaje" FontSize="13" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                    <Border HeightRequest="32" Padding="14,0" BackgroundColor="{DynamicResource Superficie}" Stroke="{DynamicResource Borde}" StrokeThickness="1" StrokeShape="RoundRectangle 6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ElegirIndividualCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding EsIndividual}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Info}" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                            <Path Data="{StaticResource IconoPersona}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource TextoSuave}" VerticalOptions="Center">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding EsIndividual}" Value="True">
                                        <Setter Property="Stroke" Value="White" />
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                            <Label Text="Individual" FontFamily="InterSemiBold" FontSize="13" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding EsIndividual}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                    <Border HeightRequest="32" Padding="14,0" BackgroundColor="{DynamicResource Superficie}" Stroke="{DynamicResource Borde}" StrokeThickness="1" StrokeShape="RoundRectangle 6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ElegirGrupoCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding EsGrupo}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Info}" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                            <Path Data="{StaticResource IconoUsuarios}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource TextoSuave}" VerticalOptions="Center">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding EsGrupo}" Value="True">
                                        <Setter Property="Stroke" Value="White" />
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                            <Label Text="Grupo" FontFamily="InterSemiBold" FontSize="13" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding EsGrupo}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <Border
                IsVisible="{Binding MensajeDeExito, Converter={StaticResource TextoNoVacio}}"
                Margin="0,12,0,0"
                Padding="12,10"
                BackgroundColor="{DynamicResource ExitoFondo}"
                Stroke="{DynamicResource ExitoBorde}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8">
                <HorizontalStackLayout Spacing="8">
                    <Path Data="{StaticResource IconoCheckCirculo}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource Exito}" VerticalOptions="Center" />
                    <Label Text="{Binding MensajeDeExito}" FontSize="13" TextColor="{DynamicResource Exito}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,360" ColumnSpacing="16" Margin="0,12,0,0">

                <Border Style="{StaticResource Tarjeta}" Padding="20,16">
                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Pasajero" FontFamily="InterSemiBold" FontSize="15" IsVisible="{Binding EsIndividual}" />
                            <Label Text="Responsable" FontFamily="InterSemiBold" FontSize="15" IsVisible="{Binding EsGrupo}" />
                            <Label Text="Paga y da el teléfono de contacto." FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" IsVisible="{Binding EsGrupo}" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,130,150,150" ColumnSpacing="12">
                            <common:CampoDeTexto Etiqueta="Nombre *" Placeholder="Nombre Apellido" Texto="{Binding Nombre}" MensajeDeError="{Binding ErrorNombre}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Documento *" Style="{StaticResource EtiquetaDeCampo}" />
                                <Border Style="{StaticResource CampoDeFormulario}">
                                    <Picker ItemsSource="{Binding TiposDeDocumento}" SelectedIndex="{Binding TipoDeDocumento}" />
                                </Border>
                            </VerticalStackLayout>
                            <common:CampoDeTexto Grid.Column="2" Etiqueta="N.º de documento *" Placeholder="12345678" Texto="{Binding NumeroDocumento}" MensajeDeError="{Binding ErrorDocumento}" />
                            <common:CampoDeTexto Grid.Column="3" Etiqueta="Teléfono *" Placeholder="9XX XXX XXX" Teclado="Telephone" Texto="{Binding Telefono}" MensajeDeError="{Binding ErrorTelefono}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,*,*" ColumnSpacing="12" IsVisible="{Binding EsIndividual}">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="End" Margin="0,0,0,6">
                                <CheckBox IsChecked="{Binding MenorSinPadres}" VerticalOptions="Center" />
                                <Label Text="Menor sin sus padres" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <common:CampoDeTexto Grid.Column="1" IsVisible="{Binding MenorSinPadres}" Etiqueta="Nombre del padre *" Placeholder="Nombre Apellido" Texto="{Binding NombrePadre}" MensajeDeError="{Binding ErrorPadre}" />
                            <common:CampoDeTexto Grid.Column="2" IsVisible="{Binding MenorSinPadres}" Etiqueta="Nombre de la madre *" Placeholder="Nombre Apellido" Texto="{Binding NombreMadre}" MensajeDeError="{Binding ErrorMadre}" />
                            <common:CampoDeTexto Grid.Column="3" IsVisible="{Binding MenorSinPadres}" Etiqueta="Motivo del viaje *" Placeholder="Descripción" Texto="{Binding MotivoViaje}" MensajeDeError="{Binding ErrorMotivo}" />
                        </Grid>

                        <!-- Pasaje individual -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding EsIndividual}">
                            <Label Text="Viaje" FontFamily="InterSemiBold" FontSize="15" />
                            <Grid ColumnDefinitions="150,*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Origen *" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoDeFormulario}">
                                        <Picker ItemsSource="{Binding Origenes}" SelectedIndex="{Binding OrigenElegido}" />
                                    </Border>
                                </VerticalStackLayout>
                                <common:CampoDeTexto Grid.Column="1" Etiqueta="Destino *" Placeholder="Ica" Texto="{Binding Destino}" MensajeDeError="{Binding ErrorDestino}" />
                                <common:CampoDeTexto Grid.Column="2" Etiqueta="Lugar de embarque *" Placeholder="Agencia" Texto="{Binding LugarDeEmbarque}" MensajeDeError="{Binding ErrorEmbarque}" />
                            </Grid>
                            <Grid ColumnDefinitions="150,150,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Fecha de salida *" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoDeFormulario}">
                                        <DatePicker Date="{Binding FechaSalida}" Format="dd/MM/yyyy" />
                                    </Border>
                                    <Label Text="{Binding ErrorFecha}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorFecha, Converter={StaticResource TextoNoVacio}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Horario *" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoDeFormulario}">
                                        <Picker ItemsSource="{Binding Horarios}" SelectedIndex="{Binding HorarioElegido}" />
                                    </Border>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="End" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconoInfo}" WidthRequest="14" HeightRequest="14" Stroke="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                                    <Label Text="Hasta 7 días de anticipación." FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Label Text="Importe y cobro" FontFamily="InterSemiBold" FontSize="15" />
                            <Grid ColumnDefinitions="220,170,170" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Tarifa vigente" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoSoloLectura}">
                                        <Label Text="{Binding TarifaVigente}" FontSize="14" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Medio de pago" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoDeFormulario}">
                                        <Picker ItemsSource="{Binding Medios}" SelectedIndex="{Binding MedioElegido}" />
                                    </Border>
                                </VerticalStackLayout>
                                <common:CampoDeTexto Grid.Column="2" Etiqueta="Monto" Placeholder="S/ 0.00" Teclado="Numeric" Texto="{Binding Monto}" MensajeDeError="{Binding ErrorMonto}" />
                            </Grid>
                            <Grid ColumnDefinitions="150,150,150" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Pagado" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoSoloLectura}">
                                        <Label Text="{Binding Pagado}" FontSize="14" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Saldo" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoSoloLectura}">
                                        <Label Text="{Binding Saldo}" FontSize="14" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="6">
                                    <Label Text="Emisor" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoSoloLectura}">
                                        <Label Text="{Binding Emisor}" FontSize="14" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="12">
                                <Button Text="Guardar reserva" Style="{StaticResource BotonSecundario}" Command="{Binding GuardarReservaCommand}" />
                                <Button Text="Registrar venta e imprimir boleto" Style="{StaticResource BotonPrimario}" Command="{Binding RegistrarVentaCommand}" />
                                <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CancelarCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Grupo -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding EsGrupo}">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Integrantes" FontFamily="InterSemiBold" FontSize="15" />
                                <Label Text="Un pasaje por persona, con su documento." FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Style="{StaticResource TarjetaCompacta}" Padding="0">
                                <VerticalStackLayout Spacing="0">
                                    <Grid HeightRequest="36" Padding="12,0" BackgroundColor="{DynamicResource EncabezadoTabla}" ColumnDefinitions="50,*,130,170,40">
                                        <Label Text="N.º" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="Nombre" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="Documento" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="N.º de documento" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                    </Grid>
                                    <Grid HeightRequest="38" Padding="12,0" ColumnDefinitions="50,*,130,170,40">
                                        <Label Text="1" FontSize="13" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="{Binding Nombre, StringFormat='{0} (responsable)'}" FontSize="13" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="3" Text="{Binding NumeroDocumento}" FontSize="13" VerticalTextAlignment="Center" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Integrantes}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:IntegranteEditable">
                                                <VerticalStackLayout Padding="12,4" Spacing="2">
                                                    <Grid ColumnDefinitions="50,*,130,170,40" ColumnSpacing="8">
                                                        <Label Text="{Binding Numero}" FontSize="13" VerticalTextAlignment="Center" />
                                                        <Border Grid.Column="1" Style="{StaticResource CampoDeFormulario}">
                                                            <Entry Text="{Binding Nombre}" Placeholder="Nombre Apellido" />
                                                        </Border>
                                                        <Border Grid.Column="2" Style="{StaticResource CampoDeFormulario}">
                                                            <Picker SelectedIndex="{Binding TipoDeDocumento}">
                                                                <Picker.ItemsSource>
                                                                    <x:Array Type="{x:Type x:String}">
                                                                        <x:String>DNI</x:String>
                                                                        <x:String>Pasaporte</x:String>
                                                                    </x:Array>
                                                                </Picker.ItemsSource>
                                                            </Picker>
                                                        </Border>
                                                        <Border Grid.Column="3" Style="{StaticResource CampoDeFormulario}">
                                                            <Entry Text="{Binding NumeroDocumento}" Placeholder="12345678" />
                                                        </Border>
                                                        <Button
                                                            Grid.Column="4"
                                                            Text="×"
                                                            Style="{StaticResource BotonSecundario}"
                                                            Padding="0"
                                                            Command="{Binding Source={x:Reference PaginaActiva}, Path=BindingContext.QuitarIntegranteCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Grid>
                                                    <Label Text="{Binding Error}" Style="{StaticResource TextoDeError}" IsVisible="{Binding Error, Converter={StaticResource TextoNoVacio}}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                            <Button Text="+  Agregar integrante" Style="{StaticResource BotonSecundario}" HorizontalOptions="Start" Command="{Binding AgregarIntegranteCommand}" />

                            <Label Text="Viaje del grupo y precio acordado" FontFamily="InterSemiBold" FontSize="15" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <common:CampoDeTexto Etiqueta="Origen *" Placeholder="Huancayo" Texto="{Binding OrigenDelGrupo}" />
                                <common:CampoDeTexto Grid.Column="1" Etiqueta="Destino *" Placeholder="Huacachina (turismo)" Texto="{Binding DestinoDelGrupo}" />
                                <common:CampoDeTexto Grid.Column="2" Etiqueta="Lugar de recojo *" Placeholder="Casa del responsable" Texto="{Binding LugarDeRecojo}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Fecha de salida *" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoDeFormulario}">
                                        <DatePicker Date="{Binding FechaDelGrupo}" Format="dd/MM/yyyy" />
                                    </Border>
                                    <Label Text="{Binding ErrorFecha}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorFecha, Converter={StaticResource TextoNoVacio}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Hora acordada con el grupo *" Style="{StaticResource EtiquetaDeCampo}" />
                                    <Border Style="{StaticResource CampoDeFormulario}">
                                        <TimePicker Time="{Binding HoraDelGrupo}" Format="HH:mm" />
                                    </Border>
                                </VerticalStackLayout>
                                <common:CampoDeTexto Grid.Column="2" Etiqueta="Precio acordado del grupo *" Placeholder="S/ 0.00" Teclado="Numeric" Texto="{Binding PrecioAcordado}" MensajeDeError="{Binding ErrorPrecio}" />
                            </Grid>
                            <Label Text="{Binding ErrorDelGrupo}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorDelGrupo, Converter={StaticResource TextoNoVacio}}" />
                            <HorizontalStackLayout Spacing="6">
                                <Path Data="{StaticResource IconoInfo}" WidthRequest="14" HeightRequest="14" Stroke="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                                <Label Text="El precio se cotiza con el grupo según el destino; no sale de las tarifas. Una familia también es un grupo." FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Unidad y asiento (individual) -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="18,16" VerticalOptions="Start" IsVisible="{Binding EsIndividual}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Unidad y asiento" FontFamily="InterSemiBold" FontSize="15" />
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Unidad de la salida *" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoDeFormulario}">
                                <Picker ItemsSource="{Binding Unidades}" SelectedIndex="{Binding UnidadElegida}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="+  Abrir otra unidad" Style="{StaticResource BotonSecundario}" Command="{Binding AbrirUnidadCommand}" />

                        <Border
                            IsVisible="{Binding AvisoDeUnidades, Converter={StaticResource TextoNoVacio}}"
                            Padding="10,8"
                            BackgroundColor="{DynamicResource InfoFondo}"
                            Stroke="{DynamicResource InfoBorde}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding AvisoDeUnidades}" FontSize="12" TextColor="{DynamicResource InfoTexto}" LineBreakMode="WordWrap" />
                        </Border>

                        <Border Style="{StaticResource TarjetaCompacta}" Padding="16" HorizontalOptions="Center" WidthRequest="260" StrokeShape="RoundRectangle 24">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding NombreDeLaUnidad}" FontSize="12" TextColor="{DynamicResource TextoSuave}" HorizontalTextAlignment="Center" />
                                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Asientos}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AsientoVisible">
                                            <ContentView Padding="3">
                                                <Border
                                                    WidthRequest="52"
                                                    HeightRequest="40"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{Binding Fondo}"
                                                    Stroke="{Binding Borde}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference PaginaActiva}, Path=BindingContext.ElegirAsientoCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding Texto}" TextColor="{Binding ColorDelTexto}" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                            </ContentView>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="{Binding ErrorAsiento}" Style="{StaticResource TextoDeError}" IsVisible="{Binding ErrorAsiento, Converter={StaticResource TextoNoVacio}}" />

                        <HorizontalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="5">
                                <Border WidthRequest="14" HeightRequest="14" StrokeThickness="1" Stroke="{DynamicResource BordeControl}" BackgroundColor="{DynamicResource Superficie}" StrokeShape="RoundRectangle 3" />
                                <Label Text="Libre" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <Border WidthRequest="14" HeightRequest="14" StrokeThickness="1" Stroke="{DynamicResource BordeDeshabilitado}" BackgroundColor="{DynamicResource DeshabilitadoFondo}" StrokeShape="RoundRectangle 3" />
                                <Label Text="Ocupado" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <Border WidthRequest="14" HeightRequest="14" StrokeThickness="0" BackgroundColor="{DynamicResource Info}" StrokeShape="RoundRectangle 3" />
                                <Label Text="Elegido" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <Label Text="{Binding TextoDelAsiento}" FontFamily="InterSemiBold" FontSize="13" />
                        <Label Text="Elija el asiento con un clic." FontSize="12" TextColor="{DynamicResource TextoSuave}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Unidades y cobro del grupo -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="18,16" VerticalOptions="Start" IsVisible="{Binding EsGrupo}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Unidades del grupo" FontFamily="InterSemiBold" FontSize="15" />
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Tipo de vehículo *" Style="{StaticResource EtiquetaDeCampo}" />
                            <Border Style="{StaticResource CampoDeFormulario}">
                                <Picker ItemsSource="{Binding TiposDeVehiculo}" SelectedIndex="{Binding TipoDelGrupo}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="+  Agregar otra unidad al grupo" Style="{StaticResource BotonSecundario}" Command="{Binding AgregarUnidadAlGrupoCommand}" />

                        <Border Style="{StaticResource TarjetaCompacta}" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Grid HeightRequest="34" Padding="12,0" BackgroundColor="{DynamicResource EncabezadoTabla}" ColumnDefinitions="60,*,70">
                                    <Label Text="Unidad" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="Vehículo" FontFamily="InterSemiBold" FontSize="12" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="Asientos" FontFamily="InterSemiBold" FontSize="12" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                </Grid>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding UnidadesDelGrupo}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:UnidadDelGrupoVisible">
                                            <Grid HeightRequest="34" Padding="12,0" ColumnDefinitions="60,*,70">
                                                <Label Text="{Binding Numero}" FontSize="13" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding Vehiculo}" FontSize="13" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="2" Text="{Binding Asientos}" FontSize="13" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="{Binding Capacidad}" FontFamily="InterSemiBold" FontSize="13" />
                        <Label Text="Los integrantes no tienen asiento. Si son más que la capacidad, no se guarda: agregue otra unidad." FontSize="12" TextColor="{DynamicResource TextoSuave}" LineBreakMode="WordWrap" />

                        <Label Text="Cobro del grupo" FontFamily="InterSemiBold" FontSize="15" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Medio de pago" Style="{StaticResource EtiquetaDeCampo}" />
                                <Border Style="{StaticResource CampoDeFormulario}">
                                    <Picker ItemsSource="{Binding Medios}" SelectedIndex="{Binding MedioDelGrupo}" />
                                </Border>
                            </VerticalStackLayout>
                            <common:CampoDeTexto Grid.Column="1" Etiqueta="Monto" Placeholder="S/ 0.00" Teclado="Numeric" Texto="{Binding MontoDelGrupo}" />
                        </Grid>
                        <Label Text="Un solo cobro, por el monto total del grupo." FontSize="12" TextColor="{DynamicResource TextoSuave}" />

                        <Button Text="Registrar grupo e imprimir boletos" Style="{StaticResource BotonPrimario}" Command="{Binding RegistrarGrupoCommand}" />
                        <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CancelarCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</paginas:PaginaDeModulo>
