<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Kataleya.Escritorio.Features.PanelPrincipal.PanelPrincipalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Kataleya.Escritorio.Components.Layout"
    xmlns:panel="clr-namespace:Kataleya.Contratos.Panel;assembly=Kataleya.Contratos"
    xmlns:ui="clr-namespace:Kataleya.Escritorio.UIHelpers.Behaviors"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.PanelPrincipal"
    x:DataType="vm:PanelPrincipalViewModel"
    ui:CicloDeVidaDePagina.AlAparecer="{Binding ActualizarCommand}"
    Shell.NavBarIsVisible="False">
    <Grid
        x:Name="Raiz"
        ColumnDefinitions="232,*"
        RowDefinitions="58,*,32"
        BackgroundColor="{DynamicResource Fondo}">

        <components:BarraLateral
            x:Name="Lateral"
            Grid.RowSpan="3"
            OpcionActiva="panel"
            EsAdministrador="{Binding EsAdministrador}"
            OpcionSeleccionada="AlTocarOpcion"
            CierreDeSesionSolicitado="AlSolicitarCierreDeSesion" />

        <components:BarraSuperior
            x:Name="Superior"
            Grid.Column="1"
            MenuSolicitado="AlSolicitarMenu"
            CierreDeSesionSolicitado="AlSolicitarCierreDeSesion" />

        <Image
            Grid.Column="1"
            Grid.Row="1"
            Grid.RowSpan="2"
            Source="fondo_oscuro.png"
            Aspect="AspectFill"
            IsVisible="{AppThemeBinding Light=False, Dark=True}"
            InputTransparent="True"
            SemanticProperties.Description="" />

        <Grid
            Grid.Column="1"
            Grid.Row="1"
            Grid.RowSpan="2"
            WidthRequest="430"
            HeightRequest="291"
            Margin="0,0,12,32"
            HorizontalOptions="End"
            VerticalOptions="End"
            IsClippedToBounds="True"
            Opacity="0.35"
            InputTransparent="True">
            <Image
                Source="camioneta.png"
                WidthRequest="430"
                HeightRequest="322.5"
                Aspect="Fill"
                TranslationY="-24.4"
                VerticalOptions="Start"
                InputTransparent="True" />
        </Grid>

        <ScrollView
            Grid.Column="1"
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,32,24,24" Spacing="0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label
                            x:Name="LblSaludo"
                            FontFamily="InterBold"
                            FontSize="28"
                            LineHeight="1.2"
                            TextColor="{DynamicResource Texto}" />
                        <Label
                            Text="Este es el resumen de la operación de hoy."
                            FontSize="14"
                            TextColor="{DynamicResource TextoSuave}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="257"
                        HeightRequest="64"
                        BackgroundColor="{DynamicResource Superficie}"
                        Stroke="{DynamicResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="14" Padding="16,0">
                            <Path
                                Data="{StaticResource IconoCalendario}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{DynamicResource TextoSuave}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0"
                                VerticalOptions="Center">
                                <Label
                                    x:Name="LblDia"
                                    FontFamily="InterMedium"
                                    FontSize="13"
                                    TextColor="{DynamicResource TextoSuave}" />
                                <Label
                                    x:Name="LblFecha"
                                    FontFamily="InterSemiBold"
                                    FontSize="14"
                                    TextColor="{DynamicResource Texto}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    IsVisible="{Binding CopiaConFallos}"
                    Margin="0,16,0,0"
                    Padding="12,10"
                    BackgroundColor="{DynamicResource AdvertenciaFondo}"
                    Stroke="{DynamicResource AdvertenciaBorde}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="18,*" ColumnSpacing="10">
                        <Path
                            Data="{StaticResource IconoAlerta}"
                            WidthRequest="18"
                            HeightRequest="18"
                            Aspect="Uniform"
                            Stroke="{DynamicResource AdvertenciaTexto}"
                            StrokeThickness="1.75"
                            VerticalOptions="Start" />
                        <Label
                            Grid.Column="1"
                            Text="[RES-01] La copia semanal de los datos no se pudo guardar. Avise al equipo de soporte."
                            FontSize="13"
                            TextColor="{DynamicResource AdvertenciaTexto}"
                            LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <Border
                    IsVisible="{Binding ImpresoraNoEncontrada}"
                    Margin="0,16,0,0"
                    Padding="12,10"
                    BackgroundColor="{DynamicResource AdvertenciaFondo}"
                    Stroke="{DynamicResource AdvertenciaBorde}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="18,*" ColumnSpacing="10">
                        <Path
                            Data="{StaticResource IconoAlerta}"
                            WidthRequest="18"
                            HeightRequest="18"
                            Aspect="Uniform"
                            Stroke="{DynamicResource AdvertenciaTexto}"
                            StrokeThickness="1.75"
                            VerticalOptions="Start" />
                        <Label
                            Grid.Column="1"
                            Text="[IMP-03] No se encontró la impresora de etiquetas. Revise que esté encendida y conectada; mientras tanto, los pasajes se registran igual y el boleto se imprime después desde su detalle."
                            FontSize="13"
                            TextColor="{DynamicResource AdvertenciaTexto}"
                            LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <Border
                    IsVisible="{Binding HayReportePendiente}"
                    Margin="0,12,0,0"
                    Padding="12,8"
                    BackgroundColor="{DynamicResource InfoFondo}"
                    Stroke="{DynamicResource InfoBorde}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                        <Path
                            Data="{StaticResource IconoInfo}"
                            WidthRequest="18"
                            HeightRequest="18"
                            Aspect="Uniform"
                            Stroke="{DynamicResource InfoTexto}"
                            StrokeThickness="1.75"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding TextoDelReportePendiente}"
                            FontSize="13"
                            TextColor="{DynamicResource InfoTexto}"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="2"
                            Text="Generar reporte"
                            Style="{StaticResource BotonSecundario}"
                            Command="{Binding GenerarReporteAnualCommand}" />
                    </Grid>
                </Border>

                <Border
                    IsVisible="{Binding MensajeDelReporte, Converter={StaticResource TextoNoVacio}}"
                    Margin="0,12,0,0"
                    Padding="12,10"
                    BackgroundColor="{DynamicResource ExitoFondo}"
                    Stroke="{DynamicResource ExitoBorde}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8">
                    <Label
                        Text="{Binding MensajeDelReporte}"
                        FontSize="13"
                        TextColor="{DynamicResource Exito}" />
                </Border>

                <FlexLayout
                    Direction="Row"
                    Wrap="Wrap"
                    AlignItems="Stretch"
                    Margin="0,16,0,0">

                    <ContentView FlexLayout.Basis="206" FlexLayout.Grow="1" Padding="0,0,14,14">
                    <Border
                        HeightRequest="92"
                        BackgroundColor="{DynamicResource Superficie}"
                        Stroke="{DynamicResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoUsuarios}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{DynamicResource Info}"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Reservas registradas"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{DynamicResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding ReservasRegistradas}"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{DynamicResource Texto}" />
                        </Grid>
                    </Border>
                    </ContentView>

                    <ContentView FlexLayout.Basis="206" FlexLayout.Grow="1" Padding="0,0,14,14">
                    <Border
                        HeightRequest="92"
                        BackgroundColor="{DynamicResource Superficie}"
                        Stroke="{DynamicResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoPasaje}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{DynamicResource IconoVenta}"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Ventas"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{DynamicResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Ventas}"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{DynamicResource Texto}" />
                        </Grid>
                    </Border>
                    </ContentView>

                    <ContentView FlexLayout.Basis="206" FlexLayout.Grow="1" Padding="0,0,14,14">
                    <Border
                        HeightRequest="92"
                        BackgroundColor="{DynamicResource Superficie}"
                        Stroke="{DynamicResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoDinero}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{DynamicResource IconoVenta}"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Cobrado en efectivo"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{DynamicResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Efectivo}"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{DynamicResource Texto}" />
                        </Grid>
                    </Border>
                    </ContentView>

                    <ContentView FlexLayout.Basis="206" FlexLayout.Grow="1" Padding="0,0,14,14">
                    <Border
                        HeightRequest="92"
                        BackgroundColor="{DynamicResource Superficie}"
                        Stroke="{DynamicResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoCelular}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{DynamicResource IconoYape}"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Cobrado por Yape"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{DynamicResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Yape}"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{DynamicResource Texto}" />
                        </Grid>
                    </Border>
                    </ContentView>

                    <ContentView FlexLayout.Basis="206" FlexLayout.Grow="1" Padding="0,0,0,14">
                    <Border
                        HeightRequest="92"
                        BackgroundColor="{DynamicResource Superficie}"
                        Stroke="{DynamicResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoReloj}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{DynamicResource Advertencia}"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Adelantos por cobrar"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{DynamicResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Adelantos}"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{DynamicResource Texto}" />
                        </Grid>
                    </Border>
                    </ContentView>
                </FlexLayout>

                <Border
                    Margin="0,24,0,0"
                    Padding="20,20,24,24"
                    BackgroundColor="{DynamicResource Superficie}"
                    Stroke="{DynamicResource Borde}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="10">
                            <Path
                                Data="{StaticResource IconoBus}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{DynamicResource TextoSuave}"
                                VerticalOptions="Center" />
                            <Label
                                Text="Pasajes por horario de salida (hoy)"
                                FontFamily="InterSemiBold"
                                FontSize="16"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border
                            Margin="0,20,0,0"
                            BackgroundColor="{DynamicResource Superficie}"
                            Stroke="{DynamicResource Borde}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="0">
                                <Border
                                    HeightRequest="40"
                                    BackgroundColor="{DynamicResource SuperficieActiva}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9,9,0,0">
                                    <Grid ColumnDefinitions="*,*,*,*,*">
                                        <Label Text="Horario" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="Pasajes" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="Pagados" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="Reservados" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="4" Text="Con adelanto" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>

                                <BoxView HeightRequest="1" Color="{DynamicResource Borde}" />

                                <CollectionView ItemsSource="{Binding Horarios}">
                                    <CollectionView.EmptyView>
                                        <Label Text="No hay horarios registrados." FontSize="13" TextColor="{DynamicResource TextoSuave}" HorizontalTextAlignment="Center" Margin="0,16" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="panel:DatosDeHorario">
                                            <Grid HeightRequest="40" ColumnDefinitions="*,*,*,*,*">
                                                <Label Text="{Binding Hora}" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding Pasajes}" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="2" Text="{Binding Pagados}" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="3" Text="{Binding Reservados}" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="4" Text="{Binding ConAdelanto}" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="16" Margin="0,20,0,0">
                            <Border
                                x:Name="BotonRegistrarPasaje"
                                HeightRequest="44"
                                MinimumWidthRequest="198"
                                Padding="22,0"
                                BackgroundColor="{DynamicResource BotonClaro}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                AutomationProperties.Name="Registrar pasaje">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AlTocarRegistrarPasaje" />
                                    <PointerGestureRecognizer PointerEntered="AlEntrarBotonClaro" PointerExited="AlSalirBotonClaro" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Path
                                        Data="{StaticResource IconoPasaje}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Aspect="Uniform"
                                        Stroke="{DynamicResource BotonClaroTexto}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="Registrar pasaje"
                                        FontFamily="InterSemiBold"
                                        FontSize="15"
                                        TextColor="{DynamicResource BotonClaroTexto}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border
                                x:Name="BotonVerPasajes"
                                HeightRequest="44"
                                MinimumWidthRequest="163"
                                Padding="22,0"
                                BackgroundColor="{DynamicResource BotonOscuro}"
                                Stroke="{DynamicResource BordeControl}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                AutomationProperties.Name="Ver pasajes">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AlTocarVerPasajes" />
                                    <PointerGestureRecognizer PointerEntered="AlEntrarBotonOscuro" PointerExited="AlSalirBotonOscuro" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Path
                                        Data="{StaticResource IconoLista}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Aspect="Uniform"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="Ver pasajes"
                                        FontFamily="InterSemiBold"
                                        FontSize="15"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Column="1" Grid.Row="2">
            <HorizontalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="14">
                <Label Text="Empresa Turismo VIP Kataleya SV E.I.R.L." FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                <Label Text="|" FontSize="12" TextColor="{DynamicResource TextoTenue}" VerticalOptions="Center" />
                <Label Text="Uniendo a las familias peruanas" FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
                <Label Text="|" FontSize="12" TextColor="{DynamicResource TextoTenue}" VerticalOptions="Center" />
                <Label Text="Ica - Hyo. - viceversa" FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
