<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Kataleya.Escritorio.Features.PanelPrincipal.PanelPrincipalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Kataleya.Escritorio.Components.Layout"
    xmlns:ui="clr-namespace:Kataleya.Escritorio.UIHelpers.Behaviors"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.PanelPrincipal"
    x:DataType="vm:PanelPrincipalViewModel"
    ui:CicloDeVidaDePagina.AlAparecer="{Binding ActualizarCommand}"
    Shell.NavBarIsVisible="False">
    <Grid
        x:Name="Raiz"
        ColumnDefinitions="232,*"
        RowDefinitions="58,*,32"
        BackgroundColor="{StaticResource Fondo}">

        <components:BarraLateral
            x:Name="Lateral"
            Grid.RowSpan="3"
            OpcionActiva="panel"
            EsAdministrador="{Binding EsAdministrador}"
            OpcionSeleccionada="AlTocarOpcion"
            CierreDeSesionSolicitado="AlSolicitarCierreDeSesion" />

        <components:BarraSuperior
            x:Name="Superior"
            Grid.Column="1"
            MenuSolicitado="AlSolicitarMenu"
            CierreDeSesionSolicitado="AlSolicitarCierreDeSesion" />

        <Image
            Grid.Column="1"
            Grid.Row="1"
            Grid.RowSpan="2"
            Source="fondo_oscuro.png"
            Aspect="AspectFill"
            InputTransparent="True"
            SemanticProperties.Description="" />

        <Grid
            Grid.Column="1"
            Grid.Row="1"
            Grid.RowSpan="2"
            WidthRequest="430"
            HeightRequest="291"
            Margin="0,0,12,32"
            HorizontalOptions="End"
            VerticalOptions="End"
            IsClippedToBounds="True"
            Opacity="0.35"
            InputTransparent="True">
            <Image
                Source="camioneta.png"
                WidthRequest="430"
                HeightRequest="322.5"
                Aspect="Fill"
                TranslationY="-24.4"
                VerticalOptions="Start"
                InputTransparent="True" />
        </Grid>

        <ScrollView
            Grid.Column="1"
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,32,24,24" Spacing="0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label
                            x:Name="LblSaludo"
                            FontFamily="InterBold"
                            FontSize="28"
                            LineHeight="1.2"
                            TextColor="{StaticResource Texto}" />
                        <Label
                            Text="Este es el resumen de la operación de hoy."
                            FontSize="14"
                            TextColor="{StaticResource TextoSuave}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="257"
                        HeightRequest="64"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="14" Padding="16,0">
                            <Path
                                Data="{StaticResource IconoCalendario}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{StaticResource TextoSuave}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0"
                                VerticalOptions="Center">
                                <Label
                                    x:Name="LblDia"
                                    FontFamily="InterMedium"
                                    FontSize="13"
                                    TextColor="{StaticResource TextoSuave}" />
                                <Label
                                    x:Name="LblFecha"
                                    FontFamily="InterSemiBold"
                                    FontSize="14"
                                    TextColor="{StaticResource Texto}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <FlexLayout
                    Direction="Row"
                    Wrap="Wrap"
                    AlignItems="Stretch"
                    Margin="0,16,0,0">

                    <Border
                        FlexLayout.Basis="206"
                        FlexLayout.Grow="1"
                        HeightRequest="92"
                        Margin="0,0,14,14"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoUsuarios}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="#3B82F6"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Reservas registradas"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{StaticResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="0"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{StaticResource Texto}" />
                        </Grid>
                    </Border>

                    <Border
                        FlexLayout.Basis="206"
                        FlexLayout.Grow="1"
                        HeightRequest="92"
                        Margin="0,0,14,14"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoPasaje}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="#22C55E"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Ventas"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{StaticResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="0"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{StaticResource Texto}" />
                        </Grid>
                    </Border>

                    <Border
                        FlexLayout.Basis="206"
                        FlexLayout.Grow="1"
                        HeightRequest="92"
                        Margin="0,0,14,14"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoDinero}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="#22C55E"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Cobrado en efectivo"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{StaticResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="S/ 0.00"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{StaticResource Texto}" />
                        </Grid>
                    </Border>

                    <Border
                        FlexLayout.Basis="206"
                        FlexLayout.Grow="1"
                        HeightRequest="92"
                        Margin="0,0,14,14"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoCelular}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="#A855F7"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Cobrado por Yape"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{StaticResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="S/ 0.00"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{StaticResource Texto}" />
                        </Grid>
                    </Border>

                    <Border
                        FlexLayout.Basis="206"
                        FlexLayout.Grow="1"
                        HeightRequest="92"
                        Margin="0,0,0,14"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="16,18">
                            <Path
                                Data="{StaticResource IconoReloj}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{StaticResource Advertencia}"
                                VerticalOptions="Start"
                                Margin="0,2,0,0" />
                            <Label
                                Grid.Column="1"
                                Text="Adelantos por cobrar"
                                FontFamily="InterMedium"
                                FontSize="13"
                                TextColor="{StaticResource TextoSuave}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="S/ 0.00"
                                FontFamily="InterBold"
                                FontSize="26"
                                TextColor="{StaticResource Texto}" />
                        </Grid>
                    </Border>
                </FlexLayout>

                <Border
                    Margin="0,24,0,0"
                    Padding="20,20,24,24"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="10">
                            <Path
                                Data="{StaticResource IconoBus}"
                                WidthRequest="24"
                                HeightRequest="24"
                                Aspect="Uniform"
                                Stroke="{StaticResource TextoSuave}"
                                VerticalOptions="Center" />
                            <Label
                                Text="Pasajes por horario de salida (hoy)"
                                FontFamily="InterSemiBold"
                                FontSize="16"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border
                            Margin="0,20,0,0"
                            BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="0">
                                <Border
                                    HeightRequest="40"
                                    BackgroundColor="{StaticResource SuperficieActiva}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9,9,0,0">
                                    <Grid ColumnDefinitions="*,*,*,*,*">
                                        <Label Text="Horario" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="Pasajes" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="Pagados" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="Reservados" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="4" Text="Con adelanto" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>

                                <BoxView HeightRequest="1" Color="{StaticResource Borde}" />

                                <Grid HeightRequest="40" ColumnDefinitions="*,*,*,*,*">
                                    <Label Text="06:00" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#23262C" />

                                <Grid HeightRequest="40" ColumnDefinitions="*,*,*,*,*" BackgroundColor="{StaticResource SuperficieAlterna}">
                                    <Label Text="10:00" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#23262C" />

                                <Grid HeightRequest="40" ColumnDefinitions="*,*,*,*,*">
                                    <Label Text="13:00" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#23262C" />

                                <Grid HeightRequest="40" ColumnDefinitions="*,*,*,*,*" BackgroundColor="{StaticResource SuperficieAlterna}">
                                    <Label Text="15:00" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#23262C" />

                                <Grid HeightRequest="40" ColumnDefinitions="*,*,*,*,*">
                                    <Label Text="20:00" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="0" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="16" Margin="0,20,0,0">
                            <Border
                                x:Name="BotonRegistrarPasaje"
                                HeightRequest="44"
                                MinimumWidthRequest="198"
                                Padding="22,0"
                                BackgroundColor="{StaticResource BotonClaro}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                AutomationProperties.Name="Registrar pasaje">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AlTocarRegistrarPasaje" />
                                    <PointerGestureRecognizer PointerEntered="AlEntrarBotonClaro" PointerExited="AlSalirBotonClaro" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Path
                                        Data="{StaticResource IconoPasaje}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Aspect="Uniform"
                                        Stroke="{StaticResource BotonClaroTexto}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="Registrar pasaje"
                                        FontFamily="InterSemiBold"
                                        FontSize="15"
                                        TextColor="{StaticResource BotonClaroTexto}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border
                                x:Name="BotonVerPasajes"
                                HeightRequest="44"
                                MinimumWidthRequest="163"
                                Padding="22,0"
                                BackgroundColor="{StaticResource BotonOscuro}"
                                Stroke="{StaticResource BordeControl}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                AutomationProperties.Name="Ver pasajes">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AlTocarVerPasajes" />
                                    <PointerGestureRecognizer PointerEntered="AlEntrarBotonOscuro" PointerExited="AlSalirBotonOscuro" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Path
                                        Data="{StaticResource IconoLista}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Aspect="Uniform"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="Ver pasajes"
                                        FontFamily="InterSemiBold"
                                        FontSize="15"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Column="1" Grid.Row="2">
            <HorizontalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="14">
                <Label Text="Empresa Turismo VIP Kataleya SV E.I.R.L." FontSize="12" TextColor="{StaticResource TextoSuave}" VerticalOptions="Center" />
                <Label Text="|" FontSize="12" TextColor="{StaticResource TextoTenue}" VerticalOptions="Center" />
                <Label Text="Uniendo a las familias peruanas" FontSize="12" TextColor="{StaticResource TextoSuave}" VerticalOptions="Center" />
                <Label Text="|" FontSize="12" TextColor="{StaticResource TextoTenue}" VerticalOptions="Center" />
                <Label Text="Ica - Hyo. - viceversa" FontSize="12" TextColor="{StaticResource TextoSuave}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
