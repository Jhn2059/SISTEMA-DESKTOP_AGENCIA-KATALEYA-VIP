<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Kataleya.Escritorio.Features.GestionDeUsuarios.RestablecerContrasena.DialogoDeContrasenaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Kataleya.Escritorio.UIHelpers.Behaviors"
    xmlns:vm="clr-namespace:Kataleya.Escritorio.Features.GestionDeUsuarios.RestablecerContrasena"
    x:DataType="vm:DialogoDeContrasenaViewModel"
    ui:CicloDeVidaDePagina.AlDesaparecer="{Binding AlDesaparecerCommand}"
    Title="Restablecer contraseña"
    Shell.NavBarIsVisible="False">
    <VerticalStackLayout Padding="24" Spacing="10">
        <Label Text="Restablecer contraseña" FontSize="22" FontAttributes="Bold" />
        <Label
            Text="{Binding NombreUsuario, StringFormat='Cuenta: {0}'}"
            TextColor="{DynamicResource TextoSuave}" />

        <Label Text="Contraseña nueva" Margin="0,10,0,0" />
        <Entry
            Text="{Binding Contrasena}"
            Placeholder="Mínimo 8 caracteres"
            IsPassword="True" />
        <Label
            Text="{Binding ErrorContrasena}"
            TextColor="{DynamicResource Error}"
            FontSize="12"
            IsVisible="{Binding ErrorContrasena, Converter={StaticResource TextoNoVacio}}" />

        <Label
            Text="Entregue la contraseña nueva al usuario."
            TextColor="{DynamicResource TextoSuave}"
            FontSize="12" />

        <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Margin="0,8,0,0">
            <Button Text="Cancelar" Command="{Binding CancelarCommand}" />
            <Button Text="Restablecer" Command="{Binding AceptarCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
