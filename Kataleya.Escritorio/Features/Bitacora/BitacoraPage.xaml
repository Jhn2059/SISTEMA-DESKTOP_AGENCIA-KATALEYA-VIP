<?xml version="1.0" encoding="UTF-8" ?>
<paginas:PaginaDeModulo
    x:Class="Kataleya.Escritorio.Features.Bitacora.BitacoraPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bitacora="clr-namespace:Kataleya.Contratos.Bitacora;assembly=Kataleya.Contratos"
    xmlns:paginas="clr-namespace:Kataleya.Escritorio.UIHelpers.Paginas">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24,16,24,24" Spacing="0">

            <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                <Label Text="Bitácora" Style="{StaticResource TituloDePagina}" VerticalOptions="Center" />
                <Label Text="Historial de operaciones · solo lectura" Style="{StaticResource SubtituloDePagina}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource Tarjeta}" Padding="14,10" Margin="0,12,0,0">
                <Grid ColumnDefinitions="190,160,160,*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Usuario" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <Picker Title="Todos" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Desde" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <DatePicker x:Name="FechaDesde" Format="dd/MM/yyyy" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Hasta" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <DatePicker x:Name="FechaHasta" Format="dd/MM/yyyy" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="4">
                        <Label Text="Pasaje" Style="{StaticResource EtiquetaDeCampo}" />
                        <Border Style="{StaticResource CampoDeFormulario}">
                            <Entry x:Name="CampoPasaje" Placeholder="N.º de pasaje" Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>
                    <Border Grid.Column="4" HeightRequest="36" Padding="16,0" BackgroundColor="{DynamicResource BotonClaro}" StrokeThickness="0" StrokeShape="RoundRectangle 6" VerticalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AlFiltrar" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Path Data="{StaticResource IconoFiltro}" WidthRequest="17" HeightRequest="17" Stroke="{DynamicResource BotonClaroTexto}" VerticalOptions="Center" />
                            <Label Text="Filtrar" FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource BotonClaroTexto}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="0">
                    <Grid HeightRequest="40" Padding="12,0" BackgroundColor="{DynamicResource EncabezadoTabla}" ColumnDefinitions="1.2*,1.1*,1.3*,0.8*,1.4*,1.5*" ColumnSpacing="0">
                        <Label Text="Fecha y hora" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="Usuario" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="Operación" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="Pasaje" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="Valor anterior" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="Valor nuevo" FontFamily="InterSemiBold" FontSize="13" VerticalTextAlignment="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource Borde}" />

                    <CollectionView x:Name="TablaBitacora">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HeightRequest="120" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,22,0,0">
                                <Path Data="{StaticResource IconoLupa}" WidthRequest="28" HeightRequest="28" Stroke="{DynamicResource TextoTenue}" HorizontalOptions="Center" />
                                <Label Text="No hay operaciones registradas con esos filtros." FontSize="14" TextColor="{DynamicResource TextoSuave}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="bitacora:DatosDeBitacora">
                                <Grid HeightRequest="38" Padding="12,0" ColumnDefinitions="1.2*,1.1*,1.3*,0.8*,1.4*,1.5*">
                                    <Label Text="{Binding FechaHora, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="12" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="{Binding Usuario}" FontSize="12" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="{Binding Operacion}" FontSize="12" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="{Binding PasajeId}" FontSize="12" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="{Binding ValorAnterior}" FontSize="12" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="5" Text="{Binding ValorNuevo}" FontSize="12" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="7" Margin="0,12,0,0">
                <Path Data="{StaticResource IconoCandado}" WidthRequest="14" HeightRequest="14" Stroke="{DynamicResource TextoTenue}" VerticalOptions="Center" />
                <Label Text="Nadie puede modificar ni borrar la bitácora, ni siquiera el Administrador." FontSize="12" TextColor="{DynamicResource TextoSuave}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</paginas:PaginaDeModulo>
